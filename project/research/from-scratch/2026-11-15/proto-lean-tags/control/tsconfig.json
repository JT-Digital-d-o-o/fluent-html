{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": "."
  },
  "include": ["src/app/projects/views/*.ts", "src/app/projects/*.types.ts", "src/app/projects/projects.routes.ts", "src/app/projects/projects.service.ts", "src/core/**/*.ts", "src/theme.d.ts", "render.ts"]
}
