{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "rtsx",
    "types": [],
    "baseUrl": ".",
    "paths": { "rtsx": ["./rtsx/index.ts"], "rtsx/jsx-runtime": ["./rtsx/jsx-runtime.ts"] }
  },
  "include": ["rtsx", "screens"]
}
