import { HtmxConfig, hx, assetUrl, Div } from "fluent-html/dist/src/index.js";
const u = assetUrl("/x");
HtmxConfig({ defaultFocusScroll: true });                       // L3 htmx-4 global focus scroll
Div().setHtmx(hx(u, { swap: "outerHTML focusScroll:true" }));   // L4 htmx-4 docs grammar
Div().setHtmx(hx(u, { swap: "outerHTML focus-scroll:true" }));  // L5 fluent grammar (inert at runtime)
Div().setHtmx(hx(u, { swap: "outerHTML show:window:top" }));    // L6 inert at runtime
Div().setHtmx(hx(u, { config: { credentials: true } }));        // L7 fetch TypeError at runtime
Div().setHtmx(hx(u, { config: { credentials: "include" } }));   // L8 the valid fetch value
Div().setHtmx(hx(u, { status: { 422: { target: "closest form" } } })); // L9 mis-parsed at runtime
Div().setHtmx(hx(u, { preserve: false }));                      // L10 preserves at runtime
Div().setHtmx(hx(u, { trigger: "sse:message" }));               // L11 never dispatched
Div().setHtmx(hx(u, { method: "query" }));                      // L12 htmx 4.0.0 GA verb
