@@ -0,0 +1,49 @@
+import type { MemberRole } from "./team.schema.js";
+
+export type MemberId = string & { readonly __brand: "MemberId" };
+export type MemberStatus = "active" | "invited";
+
+export type TeamMember = {
+  readonly id: MemberId;
+  readonly name: string;
+  readonly email: string;
+  readonly role: MemberRole;
+  readonly status: MemberStatus;
+};
+
+export type NewMember = Omit<TeamMember, "id">;
+
+/** Emails are compared as given: callers pass them normalized (see team.service.ts). */
+export type TeamStore = {
+  list(): readonly TeamMember[];
+  hasEmail(email: string): boolean;
+  add(member: NewMember): TeamMember;
+};
+
+export const SEED_MEMBERS: readonly NewMember[] = [
+  { name: "Maja Novak", email: "maja.novak@example.com", role: "owner", status: "active" },
+  { name: "Luka Kovač", email: "luka.kovac@example.com", role: "admin", status: "active" },
+  { name: "Ana Horvat", email: "ana.horvat@example.com", role: "member", status: "invited" },
+];
+
+export function createTeamStore(seed: readonly NewMember[] = []): TeamStore {
+  const members: TeamMember[] = [];
+  let nextId = 1;
+
+  function add(member: NewMember): TeamMember {
+    const created: TeamMember = { ...member, id: `member-${nextId++}` as MemberId };
+    members.push(created);
+    return created;
+  }
+
+  for (const member of seed) add(member);
+
+  return {
+    list: () => [...members],
+    hasEmail: (email) => members.some((m) => m.email === email),
+    add,
+  };
+}
+
+/** The app's team. Process memory: every restart is back to the seed. */
+export const teamStore = createTeamStore(SEED_MEMBERS);
