diff --git a/tests/unit/team.service.test.ts b/tests/unit/team.service.test.ts
new file mode 100644
index 0000000..ee4ce82
--- /dev/null
+++ b/tests/unit/team.service.test.ts
@@ -0,0 +1,78 @@
+import { describe, it, expect } from "vitest";
+import { createTeamStore, SEED_MEMBERS } from "../../src/app/team/team.store.js";
+import { inviteMember, listMembers, type TeamListing } from "../../src/app/team/team.service.js";
+
+const seeded = () => createTeamStore(SEED_MEMBERS);
+
+function listedNames(listing: TeamListing): string[] {
+  if (listing.roster.kind !== "list") return [];
+  return listing.roster.members.map((member) => member.name);
+}
+
+describe("listMembers", () => {
+  it("should list every member when there is no query", () => {
+    const listing = listMembers(seeded());
+    expect(listing.total).toBe(3);
+    expect(listedNames(listing)).toEqual(["Maja Novak", "Luka Kovač", "Ana Horvat"]);
+  });
+
+  it("should match a name case-insensitively, ignoring surrounding spaces", () => {
+    expect(listedNames(listMembers(seeded(), "  LUKA "))).toEqual(["Luka Kovač"]);
+  });
+
+  it("should match part of an email", () => {
+    expect(listedNames(listMembers(seeded(), "horvat@"))).toEqual(["Ana Horvat"]);
+  });
+
+  it("should report no matches with the trimmed query, echoing the query as typed", () => {
+    const listing = listMembers(seeded(), " zoe ");
+    expect(listing.roster).toEqual({ kind: "noMatches", query: "zoe" });
+    expect(listing.query).toBe(" zoe ");
+    expect(listing.total).toBe(3);
+  });
+
+  it("should report an empty team whatever the query", () => {
+    expect(listMembers(createTeamStore()).roster).toEqual({ kind: "empty" });
+    expect(listMembers(createTeamStore(), "ana").roster).toEqual({ kind: "empty" });
+  });
+});
+
+describe("inviteMember", () => {
+  it("should add a valid invite as an invited member with a normalized email", () => {
+    const store = seeded();
+    const result = inviteMember(store, { name: "  Zoe Ward ", email: " Zoe.Ward@Example.com ", role: "admin" });
+
+    expect(result.ok).toBe(true);
+    expect(result.ok && result.value).toMatchObject({
+      name: "Zoe Ward",
+      email: "zoe.ward@example.com",
+      role: "admin",
+      status: "invited",
+    });
+    expect(listedNames(listMembers(store))).toContain("Zoe Ward");
+  });
+
+  it("should require a name", () => {
+    const result = inviteMember(seeded(), { name: "   ", email: "zoe@example.com", role: "member" });
+    expect(result).toEqual({ ok: false, error: { name: "Enter a name." } });
+  });
+
+  it("should reject an invalid email", () => {
+    const result = inviteMember(seeded(), { name: "Zoe", email: "zoe@example", role: "member" });
+    expect(result.ok).toBe(false);
+    expect(!result.ok && result.error.email).toBe("Enter a valid email address, like name@example.com.");
+  });
+
+  it("should reject an email already on the team, whatever its case", () => {
+    const result = inviteMember(seeded(), { name: "Maja", email: "MAJA.NOVAK@example.com", role: "member" });
+    expect(!result.ok && result.error.email).toBe("Someone with this email is already on the team.");
+  });
+
+  it("should report every failing field at once and add nobody", () => {
+    const store = seeded();
+    const result = inviteMember(store, { name: "", email: "not-an-email", role: "member" });
+
+    expect(!result.ok && Object.keys(result.error).sort()).toEqual(["email", "name"]);
+    expect(listMembers(store).total).toBe(3);
+  });
+});
