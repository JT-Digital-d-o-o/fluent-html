@@ -0,0 +1,26 @@
+import { Type, type Static } from "@sinclair/typebox";
+
+export const MEMBER_NAME_MAX = 100;
+export const MEMBER_EMAIL_MAX = 254;
+export const MEMBER_QUERY_MAX = 100;
+
+export const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+const MemberRole = Type.Union([Type.Literal("owner"), Type.Literal("admin"), Type.Literal("member")]);
+export type MemberRole = Static<typeof MemberRole>;
+
+// Name and email carry no content rules here: an Ajv failure answers a generic 400, and the
+// spec wants per-field messages, so the service checks them and answers a 422 instead.
+const InviteMemberBody = Type.Object({
+  name: Type.String({ maxLength: MEMBER_NAME_MAX }),
+  email: Type.String({ maxLength: MEMBER_EMAIL_MAX }),
+  role: MemberRole,
+}, { additionalProperties: false });
+export type InviteMemberReq = Static<typeof InviteMemberBody>;
+export const inviteMemberSchema = { body: InviteMemberBody };
+
+const MemberSearchQuery = Type.Object({
+  q: Type.Optional(Type.String({ maxLength: MEMBER_QUERY_MAX })),
+});
+export type MemberSearchReq = Static<typeof MemberSearchQuery>;
+export const memberSearchSchema = { querystring: MemberSearchQuery };
