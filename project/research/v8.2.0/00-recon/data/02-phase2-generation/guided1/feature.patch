@@ -0,0 +1,109 @@
+import {
+  Div,
+  H2,
+  P,
+  Button,
+  Form,
+  Table,
+  Thead,
+  Tbody,
+  Tr,
+  Match,
+  ForEachKeyed,
+} from "fluent-html";
+import { EmptyState, ThCell, cardChrome, cardTitle, inputStyle, primaryCta } from "../../../shared/ui/index.js";
+import { count } from "../../../shared/formatters.js";
+import { teamIds, teamRoutes } from "../team.routes.js";
+import { MEMBER_QUERY_MAX, type MemberSearchReq } from "../team.schema.js";
+import type { Roster, TeamListing } from "../team.service.js";
+import type { TeamMember } from "../team.store.js";
+import { MemberRow } from "./team.components.js";
+
+type MembersPanelProps = { listing: TeamListing };
+
+/** The members card (search box, count, roster), and on its own the answer to a search. */
+export function MembersPanel({ listing }: MembersPanelProps) {
+  return Div(
+    MembersHeading({ total: listing.total }),
+    MemberSearch({ query: listing.query }),
+    MemberRoster({ roster: listing.roster }),
+  )
+    .apply(cardChrome)
+    .p("6")
+    .flex()
+    .flex("col")
+    .gap("4")
+    .setId(teamIds.membersPanel);
+}
+
+function MembersHeading({ total }: { total: number }) {
+  return Div(
+    H2("Members").apply(cardTitle),
+    P(count(total, { one: "member", other: "members" })).text("sm").text("text-dim"),
+  )
+    .flex()
+    .items("baseline")
+    .justify("between")
+    .gap("4");
+}
+
+// The query is always rendered as a `value` attribute, an empty one included: htmx's morph
+// copies an input's live value only when that attribute changes, which is how the page a
+// successful invite answers with clears a box the user had typed into.
+function MemberSearch({ query }: { query: string }) {
+  return Form<MemberSearchReq>({ values: { q: query }, idPrefix: "member-search" }, (f) => [
+    f.label("q", "Search members").srOnly(),
+    f.input("q", "search")
+      .setPlaceholder("Search by name or email")
+      .setMaxlength(MEMBER_QUERY_MAX)
+      .setAutocomplete("off")
+      .apply(inputStyle)
+      .search(teamIds.membersPanel, teamRoutes.members()),
+  ])
+    .setRole("search")
+    // Enter submits the form; answer it with the same swap rather than a full page load.
+    .fragment(teamIds.membersPanel, teamRoutes.members());
+}
+
+function MemberRoster({ roster }: { roster: Roster }) {
+  return Match(roster, "kind", {
+    empty: () => EmptyTeam(),
+    noMatches: (r) => NoMatches({ query: r.query }),
+    list: (r) => MemberTable({ members: r.members }),
+  });
+}
+
+function EmptyTeam() {
+  return EmptyState({
+    message: "Your team has no members yet. Invite someone to join it.",
+    actionView: Button("Invite a member")
+      .setType("button")
+      .behavior("focus", { target: teamIds.inviteName })
+      .apply(primaryCta)
+      .p("x", "5")
+      .p("y", "2")
+      .cursor("pointer"),
+  });
+}
+
+function NoMatches({ query }: { query: string }) {
+  return EmptyState({ message: `No members match “${query}”. Try another name or email.` });
+}
+
+function MemberTable({ members }: { members: readonly TeamMember[] }) {
+  return Div(
+    Table(
+      Thead(
+        Tr(
+          ThCell({ text: "Name" }),
+          ThCell({ text: "Email" }),
+          ThCell({ text: "Role" }),
+          ThCell({ text: "Status" }),
+        ).border("b").border("line"),
+      ),
+      Tbody(ForEachKeyed(members, (m) => m.id, (m) => MemberRow({ member: m })))
+        .divideY()
+        .divide("line"),
+    ).w("full"),
+  ).overflow("x", "auto");
+}
