@@ -0,0 +1,104 @@
+import { describe, it, expect, beforeAll, afterAll } from "vitest";
+import { buildServer } from "../../src/core/server/server.js";
+import { prisma, sessionCookie } from "../setup.js";
+import { hashPassword } from "../../src/app/auth/shared/password.js";
+
+const PASSWORD = "testpassword123";
+const EMAIL = "team-test@example.com";
+const HTMX = { "hx-request": "true" };
+
+// Field rules are unit-tested in tests/unit/team.service.test.ts; this file covers the HTTP
+// half: the guard, what each route answers with, and where a rejected invite lands.
+describe("Team", () => {
+  let server: Awaited<ReturnType<typeof buildServer>>;
+  let cookie: string;
+
+  beforeAll(async () => {
+    server = await buildServer();
+    await server.ready();
+    await prisma.user.deleteMany({ where: { email: EMAIL } });
+    await prisma.user.create({
+      data: { email: EMAIL, name: "Team Test", password: await hashPassword(PASSWORD) },
+    });
+    const res = await server.inject({
+      method: "POST",
+      url: "/auth/signin",
+      payload: { email: EMAIL, password: PASSWORD },
+    });
+    cookie = sessionCookie(res);
+  });
+
+  afterAll(async () => {
+    await prisma.user.deleteMany({ where: { email: EMAIL } });
+    await server.close();
+  });
+
+  it("should send a signed-out visitor to sign in", async () => {
+    const page = await server.inject({ method: "GET", url: "/team" });
+    const search = await server.inject({ method: "GET", url: "/team/members?q=ana" });
+    const invite = await server.inject({
+      method: "POST",
+      url: "/team",
+      payload: { name: "Zoe", email: "zoe@example.com", role: "member" },
+    });
+    expect([page.statusCode, search.statusCode, invite.statusCode]).toEqual([302, 302, 302]);
+  });
+
+  it("should render the team page with the seeded members", async () => {
+    const res = await server.inject({ method: "GET", url: "/team", headers: { cookie } });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toContain("maja.novak@example.com");
+    expect(res.body).toContain("ana.horvat@example.com");
+  });
+
+  it("should answer a search with the members panel alone", async () => {
+    const res = await server.inject({
+      method: "GET",
+      url: "/team/members?q=luka",
+      headers: { cookie, ...HTMX },
+    });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toMatch(/^<div id="members-panel"/);
+    expect(res.body).toContain("luka.kovac@example.com");
+    expect(res.body).not.toContain("maja.novak@example.com");
+  });
+
+  it("should answer a rejected htmx invite with a 422 and the invite card alone", async () => {
+    const res = await server.inject({
+      method: "POST",
+      url: "/team",
+      headers: { cookie, ...HTMX },
+      payload: { name: "Maja again", email: "maja.novak@example.com", role: "member" },
+    });
+    expect(res.statusCode).toBe(422);
+    expect(res.body).toMatch(/^<div id="invite-form"/);
+    expect(res.body).toContain("Someone with this email is already on the team.");
+    expect(res.body).toContain('value="Maja again"');
+    expect(res.body).not.toContain('id="main-content"');
+  });
+
+  it("should answer a rejected no-JS invite with the whole page", async () => {
+    const res = await server.inject({
+      method: "POST",
+      url: "/team",
+      headers: { cookie },
+      payload: { name: "", email: "zoe@example.com", role: "member" },
+    });
+    expect(res.statusCode).toBe(422);
+    expect(res.body).toContain("<!DOCTYPE html>");
+    expect(res.body).toContain("Enter a name.");
+  });
+
+  it("should add a valid invite and answer the page listing the new member", async () => {
+    const res = await server.inject({
+      method: "POST",
+      url: "/team",
+      headers: { cookie, ...HTMX },
+      payload: { name: "Zoe Ward", email: "zoe.ward@example.com", role: "admin" },
+    });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toContain('id="main-content"');
+    expect(res.body).toContain("zoe.ward@example.com");
+    expect(res.body).toContain("Zoe Ward was added as an invited admin.");
+  });
+});
