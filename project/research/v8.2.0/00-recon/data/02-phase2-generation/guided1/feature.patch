@@ -0,0 +1,56 @@
+import type { ErrorBag } from "fluent-html";
+import { normalizeEmail } from "../../shared/formatters.js";
+import { fail, ok, type Result } from "../../shared/result.js";
+import { EMAIL_PATTERN, type InviteMemberReq } from "./team.schema.js";
+import type { TeamMember, TeamStore } from "./team.store.js";
+
+export type Roster =
+  | { readonly kind: "empty" }
+  | { readonly kind: "noMatches"; readonly query: string }
+  | { readonly kind: "list"; readonly members: readonly TeamMember[] };
+
+export type TeamListing = {
+  /** The query as typed, echoed back into the search box. */
+  readonly query: string;
+  readonly total: number;
+  readonly roster: Roster;
+};
+
+export type InviteErrors = ErrorBag<InviteMemberReq>;
+
+function matches(member: TeamMember, needle: string): boolean {
+  return member.name.toLowerCase().includes(needle) || member.email.toLowerCase().includes(needle);
+}
+
+function rosterOf(total: number, hits: readonly TeamMember[], query: string): Roster {
+  if (total === 0) return { kind: "empty" };
+  if (hits.length === 0) return { kind: "noMatches", query };
+  return { kind: "list", members: hits };
+}
+
+/** The team, narrowed to members whose name or email contains `query` (case-insensitive). */
+export function listMembers(store: TeamStore, query = ""): TeamListing {
+  const members = store.list();
+  const trimmed = query.trim();
+  const needle = trimmed.toLowerCase();
+  const hits = members.filter((member) => matches(member, needle));
+  return { query, total: members.length, roster: rosterOf(members.length, hits, trimmed) };
+}
+
+function emailError(store: TeamStore, email: string): string | undefined {
+  if (!EMAIL_PATTERN.test(email)) return "Enter a valid email address, like name@example.com.";
+  if (store.hasEmail(email)) return "Someone with this email is already on the team.";
+  return undefined;
+}
+
+/** Validate an invite and, when it holds, add the person as an invited member. */
+export function inviteMember(store: TeamStore, body: InviteMemberReq): Result<TeamMember, InviteErrors> {
+  const name = body.name.trim();
+  const email = normalizeEmail(body.email);
+  const errors: InviteErrors = {};
+  if (name === "") errors.name = "Enter a name.";
+  const emailProblem = emailError(store, email);
+  if (emailProblem !== undefined) errors.email = emailProblem;
+  if (Object.keys(errors).length > 0) return fail(errors);
+  return ok(store.add({ name, email, role: body.role, status: "invited" }));
+}
