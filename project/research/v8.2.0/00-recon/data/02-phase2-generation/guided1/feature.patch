+import type { FastifyReply, FastifyRequest } from "fastify";
+import { defineController, fragment, guarded, page } from "../../core/render/define-controller.js";
+import { isHtmxRequest } from "../../core/htmx/htmx-request.js";
+import type { AuthUser } from "../../core/server/types.js";
+import { requireAuth } from "../auth/shared/guards.js";
+import { teamRoutes } from "./team.routes.js";
+import { inviteMemberSchema, memberSearchSchema } from "./team.schema.js";
+import { inviteMember, listMembers } from "./team.service.js";
+import { teamStore } from "./team.store.js";
+import { TeamPage } from "./views/team.page.view.js";
+import { MembersPanel } from "./views/team.members.view.js";
+import { InviteForm, type InviteState } from "./views/team.invite.view.js";
+
+// A rejected invite answers with the invite card alone: the submit carries
+// `{ invalid: teamIds.inviteForm }`, so htmx routes the 422 there and the list stays put.
+// A no-JS post has no swap target and gets the whole page. `renderView` because neither
+// claim is true of both branches (the template's sign-in is the same case).
+function renderInviteRejected(
+  request: FastifyRequest,
+  reply: FastifyReply,
+  user: AuthUser,
+  invite: InviteState,
+): FastifyReply {
+  reply.code(422).renderView(
+    isHtmxRequest(request)
+      ? InviteForm({ state: invite })
+      : TeamPage({ user, listing: listMembers(teamStore), invite }),
+  );
+  return reply;
+}
+
+export default defineController(teamRoutes, {
+  page: page(
+    ({ user, query }) => TeamPage({ user, listing: listMembers(teamStore, query.q), invite: { kind: "blank" } }),
+    { guards: [requireAuth], schema: memberSearchSchema },
+  ),
+
+  members: fragment(
+    ({ query }) => MembersPanel({ listing: listMembers(teamStore, query.q) }),
+    { guards: [requireAuth], schema: memberSearchSchema },
+  ),
+
+  invite: guarded(
+    { guards: [requireAuth], schema: inviteMemberSchema },
+    (request, reply) => {
+      const result = inviteMember(teamStore, request.body);
+      if (!result.ok) {
+        return renderInviteRejected(request, reply, request.user, {
+          kind: "rejected",
+          values: request.body,
+          errors: result.error,
+        });
+      }
+      return reply.renderPage(TeamPage({
+        user: request.user,
+        listing: listMembers(teamStore),
+        invite: { kind: "added", member: result.value },
+      }));
+    },
+  ),
+});
