+import { Span, Tr } from "fluent-html";
+import { TdCell } from "../../../shared/ui/index.js";
+import type { MemberRole } from "../team.schema.js";
+import type { MemberStatus, TeamMember } from "../team.store.js";
+
+export const ROLE_LABELS = {
+  owner: "Owner",
+  admin: "Admin",
+  member: "Member",
+} as const satisfies Record<MemberRole, string>;
+
+const STATUS_LABELS = {
+  active: "Active",
+  invited: "Invited",
+} as const satisfies Record<MemberStatus, string>;
+
+export function StatusBadge({ status }: { status: MemberStatus }) {
+  return Span(STATUS_LABELS[status])
+    .whenMatch(status, {
+      active: (t) => t.bg("success/10").text("success"),
+      invited: (t) => t.bg("warning/10").text("warning"),
+    })
+    .inlineFlex()
+    .items("center")
+    .p("x", "2")
+    .p("y", "0.5")
+    .rounded("control")
+    .text("xs")
+    .font("medium");
+}
+
+export function MemberRow({ member }: { member: TeamMember }) {
+  return Tr(
+    TdCell({ content: Span(member.name).font("medium").text("text") }),
+    TdCell({ content: member.email }),
+    TdCell({ content: ROLE_LABELS[member.role] }),
+    TdCell({ content: StatusBadge({ status: member.status }) }),
+  );
+}
