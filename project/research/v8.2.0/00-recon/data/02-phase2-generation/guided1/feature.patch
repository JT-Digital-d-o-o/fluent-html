@@ -0,0 +1,143 @@
+import { describe, it, expect } from "vitest";
+import { render } from "fluent-html";
+import type { AuthUser } from "../../src/core/server/types.js";
+import { TeamPage } from "../../src/app/team/views/team.page.view.js";
+import { MembersPanel } from "../../src/app/team/views/team.members.view.js";
+import { InviteForm } from "../../src/app/team/views/team.invite.view.js";
+import { StatusBadge } from "../../src/app/team/views/team.components.js";
+import { createTeamStore, SEED_MEMBERS } from "../../src/app/team/team.store.js";
+import { listMembers } from "../../src/app/team/team.service.js";
+import { expectPageShell } from "./page-shell.js";
+
+const user: AuthUser = {
+  id: "user-1",
+  email: "owner@example.com",
+  name: "Team Owner",
+  role: "USER",
+  username: null,
+  bio: null,
+  createdAt: new Date(),
+  updatedAt: new Date(),
+};
+
+const seeded = () => createTeamStore(SEED_MEMBERS);
+
+describe("TeamPage", () => {
+  it("renders through Layout with a single h1", () => {
+    const html = render(TeamPage({ user, listing: listMembers(seeded()), invite: { kind: "blank" } }));
+    expectPageShell(html, "Team");
+  });
+
+  it("lists each member's name, email, role and status", () => {
+    const html = render(TeamPage({ user, listing: listMembers(seeded()), invite: { kind: "blank" } }));
+    expect(html).toContain("Maja Novak");
+    expect(html).toContain("luka.kovac@example.com");
+    expect(html).toContain("Owner");
+    expect(html).toContain("Admin");
+    expect(html).toContain("Active");
+    expect(html).toContain("Invited");
+  });
+});
+
+describe("StatusBadge", () => {
+  it("colours an active member with the success tone", () => {
+    const html = render(StatusBadge({ status: "active" }));
+    expect(html).toContain("Active");
+    expect(html).toContain("bg-success/10");
+  });
+
+  it("colours an invited member with the warning tone", () => {
+    const html = render(StatusBadge({ status: "invited" }));
+    expect(html).toContain("Invited");
+    expect(html).toContain("bg-warning/10");
+  });
+});
+
+describe("MembersPanel", () => {
+  it("is rooted at the panel id the search swaps", () => {
+    expect(render(MembersPanel({ listing: listMembers(seeded()) }))).toMatch(/^<div id="members-panel"/);
+  });
+
+  it("wires the search box to swap the panel as the user types", () => {
+    const html = render(MembersPanel({ listing: listMembers(seeded(), "ana") }));
+    expect(html).toContain('hx-get="/team/members"');
+    expect(html).toContain('hx-target="#members-panel"');
+    expect(html).toContain("input changed delay:300ms");
+    expect(html).toContain('name="q"');
+    expect(html).toContain('value="ana"');
+  });
+
+  // The page a successful invite answers with must clear a box the user typed into, and a
+  // morph only copies a changed `value` attribute into the live value.
+  it("renders an empty query as an explicit empty value", () => {
+    expect(render(MembersPanel({ listing: listMembers(seeded()) }))).toContain('value=""');
+  });
+
+  it("keys each row by member id", () => {
+    expect(render(MembersPanel({ listing: listMembers(seeded()) }))).toContain('id="member-1"');
+  });
+
+  it("names the query when a search matches nothing", () => {
+    const html = render(MembersPanel({ listing: listMembers(seeded(), "zoe") }));
+    expect(html).toContain("No members match “zoe”");
+    expect(html).not.toContain("<table");
+  });
+
+  it("escapes the query it names", () => {
+    const html = render(MembersPanel({ listing: listMembers(seeded(), "<b>x</b>") }));
+    expect(html).not.toContain("<b>x</b>");
+    expect(html).toContain("&lt;b&gt;x&lt;/b&gt;");
+  });
+
+  it("prompts an invite when the team has no members", () => {
+    const html = render(MembersPanel({ listing: listMembers(createTeamStore()) }));
+    expect(html).toContain("Your team has no members yet");
+    expect(html).toContain('data-behavior-focus-target="invite-name"');
+    expect(html).not.toContain("<table");
+  });
+});
+
+describe("InviteForm", () => {
+  it("posts to /team and routes a rejected invite back into the card", () => {
+    const html = render(InviteForm({ state: { kind: "blank" } }));
+    expect(html).toMatch(/^<div id="invite-form"/);
+    expect(html).toContain('hx-post="/team"');
+    expect(html).toContain("target:#invite-form");
+    expect(html).toContain('data-behavior="resetOnSuccess"');
+    expect(html).toContain("novalidate");
+  });
+
+  it("gives the name control the id the empty state focuses", () => {
+    expect(render(InviteForm({ state: { kind: "blank" } }))).toContain('id="invite-name"');
+  });
+
+  it("shows each error next to its field and keeps what the user typed", () => {
+    const html = render(InviteForm({
+      state: {
+        kind: "rejected",
+        values: { name: "Zoe Ward", email: "zoe@", role: "admin" },
+        errors: { email: "Enter a valid email address, like name@example.com." },
+      },
+    }));
+    expect(html).toContain('value="Zoe Ward"');
+    expect(html).toContain('value="zoe@"');
+    expect(html).toMatch(/<option(?=[^>]*value="admin")(?=[^>]*selected)[^>]*>/);
+    expect(html).toContain('id="invite-email-error"');
+    expect(html).toContain('aria-invalid="true"');
+    expect(html).toContain("Enter a valid email address, like name@example.com.");
+    expect(html).not.toContain('id="invite-name-error"');
+  });
+
+  it("confirms who was just added and renders the fields empty", () => {
+    const member = createTeamStore().add({
+      name: "Zoe Ward",
+      email: "zoe@example.com",
+      role: "admin",
+      status: "invited",
+    });
+    const html = render(InviteForm({ state: { kind: "added", member } }));
+    expect(html).toContain("Zoe Ward was added as an invited admin.");
+    expect(html).toContain('role="status"');
+    expect(html).not.toContain('value="Zoe Ward"');
+  });
+});
