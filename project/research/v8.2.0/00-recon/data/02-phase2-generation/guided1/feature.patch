+import { Div, H2, P, Form, Match, Empty, type FormBinding, type FormState, type Tag } from "fluent-html";
+import { Alert, PrimaryButton, cardChrome, cardTitle, inputStyle, selectStyle } from "../../../shared/ui/index.js";
+import { teamIds, teamRoutes } from "../team.routes.js";
+import { MEMBER_EMAIL_MAX, MEMBER_NAME_MAX, type InviteMemberReq, type MemberRole } from "../team.schema.js";
+import type { InviteErrors } from "../team.service.js";
+import type { TeamMember } from "../team.store.js";
+import { ROLE_LABELS } from "./team.components.js";
+
+export type InviteState =
+  | { readonly kind: "blank" }
+  | { readonly kind: "rejected"; readonly values: InviteMemberReq; readonly errors: InviteErrors }
+  | { readonly kind: "added"; readonly member: TeamMember };
+
+// The binding ids each control `${prefix}-${name}`, so the name control is `teamIds.inviteName`.
+const INVITE_ID_PREFIX = "invite";
+
+const ROLE_OPTIONS = [
+  { value: "member", label: ROLE_LABELS.member },
+  { value: "admin", label: ROLE_LABELS.admin },
+  { value: "owner", label: ROLE_LABELS.owner },
+] as const satisfies readonly { value: MemberRole; label: string }[];
+
+type InviteFormProps = { state: InviteState };
+
+/** The invite card, and on its own the 422 answer `{ invalid: teamIds.inviteForm }` swaps in. */
+export function InviteForm({ state }: InviteFormProps) {
+  return Div(
+    InviteHeading(),
+    AddedNotice({ state }),
+    Match(state, "kind", {
+      rejected: (s) => InviteFields({ values: s.values, errors: s.errors }),
+    }, () => InviteFields({})),
+  )
+    .apply(cardChrome)
+    .p("6")
+    .flex()
+    .flex("col")
+    .gap("4")
+    .setId(teamIds.inviteForm);
+}
+
+function InviteHeading() {
+  return Div(
+    H2("Invite member").apply(cardTitle),
+    P("New members are listed as invited.").text("sm").text("text-dim").m("t", "1"),
+  );
+}
+
+function AddedNotice({ state }: InviteFormProps) {
+  return Match(state, "kind", {
+    added: (s) => Alert({
+      message: `${s.member.name} was added as an invited ${ROLE_LABELS[s.member.role].toLowerCase()}.`,
+      type: "success",
+    }).setRole("status"),
+  }, () => Empty());
+}
+
+type InviteFieldsProps = Pick<FormState<InviteMemberReq>, "values" | "errors">;
+
+function InviteFields({ values, errors }: InviteFieldsProps) {
+  return Form<InviteMemberReq>({ values, errors, idPrefix: INVITE_ID_PREFIX }, (f) => [
+    Div(
+      Field({
+        f,
+        name: "name",
+        label: "Name",
+        control: f.input("name", "text")
+          .setMaxlength(MEMBER_NAME_MAX)
+          .setAutocomplete("off")
+          .toggle("required")
+          .apply(inputStyle),
+      }),
+      Field({
+        f,
+        name: "email",
+        label: "Email",
+        control: f.input("email", "email")
+          .setMaxlength(MEMBER_EMAIL_MAX)
+          .setAutocomplete("off")
+          .toggle("required")
+          .apply(inputStyle),
+      }),
+      Field({ f, name: "role", label: "Role", control: f.select("role", ROLE_OPTIONS).apply(selectStyle) }),
+    )
+      .grid()
+      .gap("4")
+      .md({ gridCols: "3" }),
+    Div(PrimaryButton({ label: "Invite member" }).setType("submit")).flex().justify("end"),
+  ])
+    // The server is the one validation voice: native checks would pre-empt its inline messages.
+    .toggle("novalidate")
+    .behavior("resetOnSuccess")
+    .submit(teamRoutes.invite(), { invalid: teamIds.inviteForm })
+    .flex()
+    .flex("col")
+    .gap("4");
+}
+
+type FieldProps = {
+  f: FormBinding<InviteMemberReq>;
+  name: keyof InviteMemberReq;
+  label: string;
+  control: Tag;
+};
+
+function Field({ f, name, label, control }: FieldProps) {
+  return Div(
+    f.label(name, label).text("sm").font("medium").text("text"),
+    control,
+    Div(f.error(name)).text("sm").text("danger"),
+  )
+    .flex()
+    .flex("col")
+    .gap("1");
+}
