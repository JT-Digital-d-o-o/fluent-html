rorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/seo/seo.meta.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/seo/seo.routes.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/seo/seo.sitemap.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/seo/seo.utils.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/team/team.controller.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/team/team.routes.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/team/team.schema.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/team/team.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/team/team.store.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/team/views/team.components.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/team/views/team.invite.view.ts","messages":[{"ruleId":"fluent-html/match-subset-default","severity":2,"message":"Match over '\"rejected\" | \"added\" | \"blank\"' carries a default that silently absorbs: added, blank. Add an explicit case per member and delete the default (a new enum member then becomes a compile error), or eslint-disable with a reason if the fall-through is intentional.","line":32,"column":8,"messageId":"subsetDefault","endLine":32,"endColumn":30},{"ruleId":"fluent-html/match-subset-default","severity":2,"message":"Match over '\"rejected\" | \"added\" | \"blank\"' carries a default that silently absorbs: rejected, blank. Add an explicit case per member and delete the default (a new enum member then becomes a compile error), or eslint-disable with a reason if the fall-through is intentional.","line":55,"column":6,"messageId":"subsetDefault","endLine":55,"endColumn":19}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Div, H2, P, Form, Match, Empty, type FormBinding, type FormState, type Tag } from \"fluent-html\";\nimport { Alert, PrimaryButton, cardChrome, cardTitle, inputStyle, selectStyle } from \"../../../shared/ui/index.js\";\nimport { teamIds, teamRoutes } from \"../team.routes.js\";\nimport { MEMBER_EMAIL_MAX, MEMBER_NAME_MAX, type InviteMemberReq, type MemberRole } from \"../team.schema.js\";\nimport type { InviteErrors } from \"../team.service.js\";\nimport type { TeamMember } from \"../team.store.js\";\nimport { ROLE_LABELS } from \"./team.components.js\";\n\nexport type InviteState =\n  | { readonly kind: \"blank\" }\n  | { readonly kind: \"rejected\"; readonly values: InviteMemberReq; readonly errors: InviteErrors }\n  | { readonly kind: \"added\"; readonly member: TeamMember };\n\n// The binding ids each control `${prefix}-${name}`, so the name control is `teamIds.inviteName`.\nconst INVITE_ID_PREFIX = \"invite\";\n\nconst ROLE_OPTIONS = [\n  { value: \"member\", label: ROLE_LABELS.member },\n  { value: \"admin\", label: ROLE_LABELS.admin },\n  { value: \"owner\", label: ROLE_LABELS.owner },\n] as const satisfies readonly { value: MemberRole; label: string }[];\n\ntype InviteFormProps = { state: InviteState };\n\n/** The invite card, and on its own the 422 answer `{ invalid: teamIds.inviteForm }` swaps in. */\nexport function InviteForm({ state }: InviteFormProps) {\n  return Div(\n    InviteHeading(),\n    AddedNotice({ state }),\n    Match(state, \"kind\", {\n      rejected: (s) => InviteFields({ values: s.values, errors: s.errors }),\n    }, () => InviteFields({})),\n  )\n    .apply(cardChrome)\n    .p(\"6\")\n    .flex()\n    .flex(\"col\")\n    .gap(\"4\")\n    .setId(teamIds.inviteForm);\n}\n\nfunction InviteHeading() {\n  return Div(\n    H2(\"Invite member\").apply(cardTitle),\n    P(\"New members are listed as invited.\").text(\"sm\").text(\"text-dim\").m(\"t\", \"1\"),\n  );\n}\n\nfunction AddedNotice({ state }: InviteFormProps) {\n  return Match(state, \"kind\", {\n    added: (s) => Alert({\n      message: `${s.member.name} was added as an invited ${ROLE_LABELS[s.member.role].toLowerCase()}.`,\n      type: \"success\",\n    }).setRole(\"status\"),\n  }, () => Empty());\n}\n\ntype InviteFieldsProps = Pick<FormState<InviteMemberReq>, \"values\" | \"errors\">;\n\nfunction InviteFields({ values, errors }: InviteFieldsProps) {\n  return Form<InviteMemberReq>({ values, errors, idPrefix: INVITE_ID_PREFIX }, (f) => [\n    Div(\n      Field({\n        f,\n        name: \"name\",\n        label: \"Name\",\n        control: f.input(\"name\", \"text\")\n          .setMaxlength(MEMBER_NAME_MAX)\n          .setAutocomplete(\"off\")\n          .toggle(\"required\")\n          .apply(inputStyle),\n      }),\n      Field({\n        f,\n        name: \"email\",\n        label: \"Email\",\n        control: f.input(\"email\", \"email\")\n          .setMaxlength(MEMBER_EMAIL_MAX)\n          .setAutocomplete(\"off\")\n          .toggle(\"required\")\n          .apply(inputStyle),\n      }),\n      Field({ f, name: \"role\", label: \"Role\", control: f.select(\"role\", ROLE_OPTIONS).apply(selectStyle) }),\n    )\n      .grid()\n      .gap(\"4\")\n      .md({ gridCols: \"3\" }),\n    Div(PrimaryButton({ label: \"Invite member\" }).setType(\"submit\")).flex().justify(\"end\"),\n  ])\n    // The server is the one validation voice: native checks would pre-empt its inline messages.\n    .toggle(\"novalidate\")\n    .behavior(\"resetOnSuccess\")\n    .submit(teamRoutes.invite(), { invalid: teamIds.inviteForm })\n    .flex()\n    .flex(\"col\")\n    .gap(\"4\");\n}\n\ntype FieldProps = {\n  f: FormBinding<InviteMemberReq>;\n  name: keyof InviteMemberReq;\n  label: string;\n  control: Tag;\n};\n\nfunction Field({ f, name, label, control }: FieldProps) {\n  return Div(\n    f.label(name, label).text(\"sm\").font(\"medium\").text(\"text\"),\n    control,\n    Div(f.error(name)).text(\"sm\").text(\"danger\"),\n  )\n    .flex()\n    .flex(\"col\")\n    .gap(\"1\");\n}\n","usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/team/views/team.members.view.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"<scratch>/wave0-2/runs/guided1/src/app/team/views/team.page.view.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"f