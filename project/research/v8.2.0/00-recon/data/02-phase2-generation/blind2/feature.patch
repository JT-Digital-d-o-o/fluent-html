diff --git a/tests/view/team.view.test.ts b/tests/view/team.view.test.ts
new file mode 100644
index 0000000..906ca96
--- /dev/null
+++ b/tests/view/team.view.test.ts
@@ -0,0 +1,148 @@
+import { describe, it, expect } from "vitest";
+import { render } from "fluent-html";
+import { TeamPage, MemberDirectory, InviteForm } from "../../src/app/team/team.view.js";
+import { createTeamStore } from "../../src/app/team/team.store.js";
+import { memberDirectory } from "../../src/app/team/team.service.js";
+import { expectPageShell } from "./page-shell.js";
+
+// The team view ships unstyled but wired, like the account views: field names, routes, swap
+// targets and error slots are the contract — plus the status badge, the one styled element.
+
+const viewer = {
+  id: "1",
+  email: "viewer@example.com",
+  name: "Viewer",
+  role: "USER" as const,
+  createdAt: new Date(),
+  updatedAt: new Date(),
+  username: null,
+  bio: null,
+};
+
+const directory = (query?: string) => memberDirectory(createTeamStore(), query);
+
+/** The class list of the badge `<span>` carrying `label`. */
+function badgeClasses(html: string, label: string): string {
+  return new RegExp(`<span class="([^"]*)">${label}</span>`).exec(html)?.[1] ?? "";
+}
+
+// --- TeamPage ---
+
+describe("TeamPage", () => {
+  it("renders through the layout with one Team heading", () => {
+    expectPageShell(render(TeamPage({ user: viewer, directory: directory() })), "Team");
+  });
+
+  it("lists every seeded member with name, email, role and status", () => {
+    const html = render(TeamPage({ user: viewer, directory: directory() }));
+    for (const text of ["Ada Lovelace", "ada@example.com", "Grace Hopper", "Alan Turing", "Owner", "Admin", "Member"]) {
+      expect(html).toContain(text);
+    }
+    expect(badgeClasses(html, "Active")).not.toBe("");
+    expect(badgeClasses(html, "Invited")).not.toBe("");
+  });
+
+  it("places the search box above the list and the invite form after it", () => {
+    const html = render(TeamPage({ user: viewer, directory: directory() }));
+    expect(html.indexOf('name="q"')).toBeLessThan(html.indexOf("<table"));
+    expect(html.indexOf("<table")).toBeLessThan(html.indexOf('id="invite-form"'));
+  });
+});
+
+// --- MemberDirectory ---
+
+describe("MemberDirectory", () => {
+  it("is rooted at the live-search swap target", () => {
+    expect(render(MemberDirectory(directory()))).toMatch(/^<div id="member-directory"/);
+  });
+
+  it("filters as the user types, swapping only the directory", () => {
+    const html = render(MemberDirectory(directory()));
+    expect(html).toContain('type="search"');
+    expect(html).toContain('hx-get="/team/members"');
+    expect(html).toContain('hx-target="#member-directory"');
+    expect(html).toContain('hx-trigger="input changed delay:300ms"');
+    expect(html).toContain('hx-sync="replace"');
+  });
+
+  it("carries the query as the search box value, rendering a blank one explicitly", () => {
+    expect(render(MemberDirectory(directory("ada")))).toContain('value="ada"');
+    // `value=""` (not a missing attribute) is what lets a later page morph clear the box.
+    expect(render(MemberDirectory(directory()))).toContain('value=""');
+  });
+
+  it("colours the status badge by status", () => {
+    const html = render(MemberDirectory(directory()));
+    expect(badgeClasses(html, "Active")).toContain("bg-success/10");
+    expect(badgeClasses(html, "Active")).toContain("text-success");
+    expect(badgeClasses(html, "Invited")).toContain("bg-warning/10");
+    expect(badgeClasses(html, "Invited")).toContain("text-warning");
+  });
+
+  it("names the query when the search matches nothing", () => {
+    const html = render(MemberDirectory(directory("zed")));
+    expect(html).toContain("No members match “zed”.");
+    expect(html).not.toContain("<table");
+    expect(html).toContain('name="q"');
+  });
+
+  it("escapes the query it echoes back", () => {
+    const html = render(MemberDirectory(directory("<b>zed</b>")));
+    expect(html).not.toContain("<b>");
+    expect(html).toContain("&lt;b&gt;zed&lt;/b&gt;");
+  });
+
+  it("prompts an invite instead of a list or search box when the team is empty", () => {
+    const html = render(MemberDirectory(memberDirectory(createTeamStore([]))));
+    expect(html).toContain("Your team has no members yet.");
+    expect(html).toContain('href="#invite-form"');
+    expect(html).not.toContain("<table");
+    expect(html).not.toContain('name="q"');
+  });
+});
+
+// --- InviteForm ---
+
+describe("InviteForm", () => {
+  it("renders the name, email and role fields, with member preselected", () => {
+    const html = render(InviteForm());
+    expect(html).toContain('name="name"');
+    expect(html).toContain('name="email"');
+    expect(html).toContain('type="email"');
+    expect(html).toContain('name="role"');
+    expect(html).toMatch(/<option value="member" selected/);
+    expect(html).toContain("Invite member");
+  });
+
+  it("posts to the invite route, routing a 422 into its own region", () => {
+    const html = render(InviteForm());
+    expect(html).toMatch(/^<div id="invite-form"/);
+    expect(html).toContain('hx-post="/team/invite"');
+    expect(html).toContain('hx-target="#main-content"');
+    expect(html).toContain('hx-status:422="swap:outerMorph target:#invite-form push:false"');
+  });
+
+  it("resets itself after a successful invite", () => {
+    expect(render(InviteForm())).toContain('data-behavior="resetOnSuccess"');
+  });
+
+  it("shows each error next to its field and keeps what the user typed", () => {
+    const html = render(InviteForm({
+      values: { name: "  ", email: "not-an-email", role: "admin" },
+      errors: { name: "Enter a name.", email: "Enter a valid email address, like name@example.com." },
+    }));
+    expect(html).toContain('<span id="invite-name-error">Enter a name.</span>');
+    expect(html).toContain('<span id="invite-email-error">Enter a valid email address, like name@example.com.</span>');
+    expect(html).toContain('aria-describedby="invite-email-error"');
+    expect(html).toContain('value="not-an-email"');
+    expect(html).toMatch(/<option value="admin" selected/);
+  });
+
+  it("renders the error slots only when there are errors", () => {
+    expect(render(InviteForm())).not.toContain("-error");
+  });
+
+  it("renders the success message", () => {
+    expect(render(InviteForm({ success: "Invited Zed." }))).toContain("Invited Zed.");
+  });
+});
