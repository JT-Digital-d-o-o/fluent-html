+import { defineRoutes, defineIds } from "fluent-html";
+
+// `memberDirectory` is the live-search swap target (search box + list); `inviteForm` is the
+// 422 swap target, so a rejected invite re-renders the form region alone.
+export const teamIds = defineIds(["member-directory", "invite-form"] as const);
+
+export const teamRoutes = defineRoutes("/team", {
+  page:    { path: "/", query: { q: "string" } as const },
+  members: { path: "/members", query: { q: "string" } as const, render: teamIds.memberDirectory },
+  // The 200 answer is the page (new member listed, fresh form); the 422 is the form region
+  // alone, routed there by `.submit(…, { invalid: teamIds.inviteForm })`.
+  invite:  { method: "post", path: "/invite" },
+} as const);
diff --git a/src/app/team/team.schema.ts b/src/app/team/team.schema.ts
new file mode 100644
index 0000000..5297108
--- /dev/null
+++ b/src/app/team/team.schema.ts
@@ -0,0 +1,22 @@
+import { Type, type Static } from "@sinclair/typebox";
+
+export const TEAM_ROLES = ["owner", "admin", "member"] as const;
+export type TeamRole = (typeof TEAM_ROLES)[number];
+
+// Name and email stay plain strings so a blank name or a malformed email reaches the
+// service and comes back as a field message on the form — a schema failure would answer
+// the generic 400 page and drop what the user typed. Role comes from a <select>, so
+// anything outside the three roles is a tampered request and the 400 is right.
+const InviteMemberBody = Type.Object({
+  name: Type.String(),
+  email: Type.String(),
+  role: Type.Union(TEAM_ROLES.map((role) => Type.Literal(role))),
+}, { additionalProperties: false });
+export type InviteMemberReq = Static<typeof InviteMemberBody>;
+export const inviteMemberSchema = { body: InviteMemberBody };
+
+/** The live-search box's field; the query itself is declared on the route defs. */
+export type MemberSearchReq = { q: string };
+
+/** Deliberately loose: one `@`, a dot in the domain, no whitespace. */
+export const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
diff --git a/src/app/team/team.service.ts b/src/app/team/team.service.ts
new file mode 100644
index 0000000..80125b9
--- /dev/null
+++ b/src/app/team/team.service.ts
@@ -0,0 +1,60 @@
+import type { ErrorBag } from "fluent-html";
+import { normalizeEmail } from "../../shared/formatters.js";
+import { ok, fail, type Result } from "../../shared/result.js";
+import { EMAIL_PATTERN, type InviteMemberReq } from "./team.schema.js";
+import type { TeamMember, TeamStore, NewMember } from "./team.store.js";
+
+/** What the member list shows. `empty` wins over `no-match`: an empty team has nothing to search. */
+export type MemberListing =
+  | { kind: "empty" }
+  | { kind: "no-match"; query: string }
+  | { kind: "members"; members: readonly TeamMember[] };
+
+/** The search box's value (as typed) and the listing it produced. */
+export type MemberDirectoryData = {
+  query: string;
+  listing: MemberListing;
+};
+
+export type InviteErrors = ErrorBag<InviteMemberReq>;
+
+function matches(member: TeamMember, needle: string): boolean {
+  return member.name.toLowerCase().includes(needle) || member.email.toLowerCase().includes(needle);
+}
+
+/** Filter the team by a case-insensitive substring of name or email; a blank query lists everyone. */
+export function memberDirectory(store: TeamStore, query = ""): MemberDirectoryData {
+  const all = store.list();
+  if (all.length === 0) return { query, listing: { kind: "empty" } };
+
+  const needle = query.trim().toLowerCase();
+  const members = needle === "" ? all : all.filter((m) => matches(m, needle));
+  if (members.length === 0) return { query, listing: { kind: "no-match", query: query.trim() } };
+  return { query, listing: { kind: "members", members } };
+}
+
+/** Field-level checks, all reported at once so the form shows every message in one round-trip. */
+export function validateInvite(store: TeamStore, body: InviteMemberReq): Result<NewMember, InviteErrors> {
+  const name = body.name.trim();
+  const email = normalizeEmail(body.email);
+  const errors: InviteErrors = {};
+
+  if (name === "") errors.name = "Enter a name.";
+  if (email === "") errors.email = "Enter an email address.";
+  else if (!EMAIL_PATTERN.test(email)) errors.email = "Enter a valid email address, like name@example.com.";
+  else if (store.findByEmail(email)) errors.email = `${email} is already on the team.`;
+
+  if (Object.keys(errors).length > 0) return fail(errors);
+  const member: NewMember = { name, email, role: body.role, status: "invited" };
+  return ok(member);
+}
+
+/**
+ * Add an invited member. Synchronous end to end, so no other request can slip a duplicate
+ * in between the email check and the insert.
+ */
+export function inviteMember(store: TeamStore, body: InviteMemberReq): Result<TeamMember, InviteErrors> {
+  const validated = validateInvite(store, body);
+  if (!validated.ok) return validated;
+  return ok(store.add(validated.value));
+}
diff --git a/src/app/team/team.store.ts b/src/app/team/team.store.ts
new file mode 100644
index 0000000..e8045cd
--- /dev/null
+++ b/src/app/team/team.store.ts
@@ -0,0 +1,52 @@
+import { randomUUID } from "node:crypto";
+import type { TeamRole } from "./team.schema.js";
+
+export type MemberStatus = "active" | "invited";
+
+export type TeamMember = {
+  id: string;
+  name: string;
+  email: string;
+  role: TeamRole;
+  status: MemberStatus;
+};
+
+export type NewMember = Omit<TeamMember, "id">;
+
+export type TeamStore = {
+  /** Every member, in the order they joined the team. */
+  list(): readonly TeamMember[];
+  /** Exact match — callers pass a normalized email. */
+  findByEmail(email: string): TeamMember | undefined;
+  add(member: NewMember): TeamMember;
+};
+
+export const SEED_MEMBERS: readonly NewMember[] = [
+  { name: "Ada Lovelace", email: "ada@example.com", role: "owner", status: "active" },
+  { name: "Grace Hopper", email: "grace@example.com", role: "admin", status: "active" },
+  { name: "Alan Turing", email: "alan@example.com", role: "member", status: "invited" },
+];
+
+/**
+ * An in-memory member store. Nothing is persisted: the process-wide instance below starts
+ * from the seed on every boot and each server process keeps its own copy.
+ */
+export function createTeamStore(seed: readonly NewMember[] = SEED_MEMBERS): TeamStore {
+  const members: TeamMember[] = [];
+
+  const add = (member: NewMember): TeamMember => {
+    const created = { id: randomUUID(), ...member };
+    members.push(created);
+    return created;
+  };
+
+  seed.forEach(add);
+
+  return {
+    list: () => [...members],
+    findByEmail: (email) => members.find((m) => m.email === email),
+    add,
+  };
+}
+
+export const teamStore = createTeamStore();
diff --git a/src/app/team/team.view.ts b/src/app/team/team.view.ts
new file mode 100644
index 0000000..9ad904a
--- /dev/null
+++ b/src/app/team/team.view.ts
@@ -0,0 +1,162 @@
+import {
+  Div,
+  H1,
+  H2,
+  P,
+  A,
+  Span,
+  Label,
+  Button,
+  Form,
+  Table,
+  Thead,
+  Tbody,
+  Tr,
+  Th,
+  Td,
+  IfThen,
+  Match,
+  ForEach,
+  type SelectOption,
+} from "fluent-html";
+import { Layout } from "../../core/layout/layout.view.js";
+import type { AuthUser } from "../../core/server/types.js";
+import { stylers } from "../../shared/stylers.js";
+import { teamIds, teamRoutes } from "./team.routes.js";
+import { TEAM_ROLES, type TeamRole, type InviteMemberReq, type MemberSearchReq } from "./team.schema.js";
+import type { MemberStatus, TeamMember } from "./team.store.js";
+import type { InviteErrors, MemberDirectoryData } from "./team.service.js";
+
+// Wired but unstyled, like the other app views, so the design pass has no scaffold look to
+// undo. The status badge is the exception: its colour is part of what it says.
+
+const ROLE_LABELS: Record<TeamRole, string> = {
+  owner: "Owner",
+  admin: "Admin",
+  member: "Member",
+};
+
+const STATUS_LABELS: Record<MemberStatus, string> = {
+  active: "Active",
+  invited: "Invited",
+};
+
+const ROLE_OPTIONS: readonly SelectOption[] = TEAM_ROLES.map((role) => ({ value: role, label: ROLE_LABELS[role] }));
+
+const STATUS_TONES = stylers<MemberStatus>({
+  active:  (t) => t.bg("success/10").text("success"),
+  invited: (t) => t.bg("warning/10").text("warning"),
+});
+
+function StatusBadge(status: MemberStatus) {
+  return Span(STATUS_LABELS[status])
+    .inlineBlock()
+    .p("x", "2")
+    .p("y", "0.5")
+    .rounded("control")
+    .text("xs")
+    .font("medium")
+    .apply(STATUS_TONES[status]);
+}
+
+function MemberRow(member: TeamMember) {
+  return Tr(
+    Td(member.name),
+    Td(member.email),
+    Td(ROLE_LABELS[member.role]),
+    Td(StatusBadge(member.status)),
+  );
+}
+
+function MemberTable(members: readonly TeamMember[]) {
+  return Table(
+    Thead(Tr(Th("Name"), Th("Email"), Th("Role"), Th("Status"))),
+    Tbody(ForEach(members, MemberRow)),
+  );
+}
+
+// The box re-renders with every search answer, so its `value` attribute always holds the
+// query the list was filtered by. That is what lets the page re-render after an invite clear
+// it: a morph only resets an input's text when the attribute changes, and `""` must be
+// rendered as an attribute (never omitted) for "zed" → "" to count as a change.
+// The form carries the same swap so Enter searches in place instead of a full-page GET.
+function MemberSearch(query: string) {
+  return Form<MemberSearchReq>({ values: { q: query }, idPrefix: "member-search" }, (f) =>
+    Label(
+      "Search members",
+      f.input("q", "search")
+        .setPlaceholder("Search by name or email")
+        .setAutocomplete("off")
+        .search(teamIds.memberDirectory, teamRoutes.members()),
+    ),
+  ).fragment(teamIds.memberDirectory, teamRoutes.members());
+}
+
+function EmptyTeam() {
+  return Div(
+    P("Your team has no members yet."),
+    A("Invite your first member").setHref(teamIds.inviteForm.selector).cursor("pointer"),
+  );
+}
+
+function NoMatch(query: string) {
+  return P(`No members match “${query}”.`);
+}
+
+/** Search box + member list — the whole page's list region, and the live-search fragment. */
+export function MemberDirectory({ query, listing }: MemberDirectoryData) {
+  return Div(
+    Match(listing, "kind", {
+      empty: () => EmptyTeam(),
+      "no-match": (s) => [MemberSearch(query), NoMatch(s.query)],
+      members: (s) => [MemberSearch(query), MemberTable(s.members)],
+    }),
+  ).setId(teamIds.memberDirectory);
+}
+
+export type InviteFormProps = {
+  values?: Partial<InviteMemberReq>;
+  errors?: InviteErrors;
+  success?: string;
+};
+
+const FRESH_INVITE: Partial<InviteMemberReq> = { role: "member" };
+
+/**
+ * The invite form — also the 422 response on its own, swapped in by `{ invalid }`. After a
+ * successful invite the page morph keeps the same form node, and a morph leaves typed text
+ * alone, so `resetOnSuccess` is what empties the fields.
+ */
+export function InviteForm({ values = FRESH_INVITE, errors = {}, success }: InviteFormProps = {}) {
+  return Div(
+    H2("Invite member"),
+    IfThen(success, (msg) => P(msg).setRole("status")),
+    Form<InviteMemberReq>({ values, errors, idPrefix: "invite" }, (f) => [
+      Div(Label("Name", f.input("name", "text").toggle("required")), f.error("name")),
+      Div(Label("Email", f.input("email", "email").toggle("required")), f.error("email")),
+      Div(Label("Role", f.select("role", ROLE_OPTIONS))),
+      Button("Invite member").setType("submit"),
+    ])
+      .submit(teamRoutes.invite(), { invalid: teamIds.inviteForm })
+      .behavior("resetOnSuccess"),
+  ).setId(teamIds.inviteForm);
+}
+
+type TeamPageProps = {
+  user: AuthUser;
+  directory: MemberDirectoryData;
+  invite?: InviteFormProps;
+};
+
+export function TeamPage({ user, directory, invite }: TeamPageProps) {
+  return Layout({
+    title: "Team",
+    user,
+    children: Div(
+      H1("Team"),
+      P("Everyone on your team, including the people you have invited."),
+      MemberDirectory(directory),
+      InviteForm(invite),
+    ),
+  });
+}
