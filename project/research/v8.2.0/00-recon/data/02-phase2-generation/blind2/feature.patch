index 0000000..57e8c55
--- /dev/null
+++ b/src/app/team/team.controller.ts
@@ -0,0 +1,54 @@
+import type { FastifyReply, FastifyRequest } from "fastify";
+import { defineController, page, fragment, guarded } from "../../core/render/define-controller.js";
+import { isHtmxRequest } from "../../core/htmx/htmx-request.js";
+import type { AuthUser } from "../../core/server/types.js";
+import { requireAuth } from "../auth/shared/guards.js";
+import { teamRoutes } from "./team.routes.js";
+import { inviteMemberSchema } from "./team.schema.js";
+import { teamStore } from "./team.store.js";
+import { memberDirectory, inviteMember } from "./team.service.js";
+import { TeamPage, MemberDirectory, InviteForm, type InviteFormProps } from "./team.view.js";
+
+// A rejected invite answers with the form region alone: the submit carries
+// `{ invalid: teamIds.inviteForm }`, so htmx routes the 422 there and the list and search box
+// stay put. A no-JS post has no swap target and gets the whole page. One answer, two shapes —
+// the same `renderView` escape hatch as the sign-in rejection.
+function renderInviteRejected(
+  request: FastifyRequest,
+  reply: FastifyReply,
+  user: AuthUser,
+  invite: InviteFormProps,
+): FastifyReply {
+  reply.code(422).renderView(
+    isHtmxRequest(request) ? InviteForm(invite) : TeamPage({ user, directory: memberDirectory(teamStore), invite }),
+  );
+  return reply;
+}
+
+export default defineController(teamRoutes, {
+  page: page(
+    ({ user, query }) => TeamPage({ user, directory: memberDirectory(teamStore, query.q) }),
+    { guards: [requireAuth] },
+  ),
+
+  members: fragment(
+    ({ query }) => MemberDirectory(memberDirectory(teamStore, query.q)),
+    { guards: [requireAuth] },
+  ),
+
+  invite: guarded(
+    { guards: [requireAuth], schema: inviteMemberSchema },
+    async (request, reply) => {
+      const result = inviteMember(teamStore, request.body);
+      if (!result.ok) {
+        return renderInviteRejected(request, reply, request.user, { values: request.body, errors: result.error });
+      }
+      // Rendered without a search query: clearing the filter is what keeps the new member in view.
+      return reply.renderPage(TeamPage({
+        user: request.user,
+        directory: memberDirectory(teamStore),
+        invite: { success: `Invited ${result.value.name} (${result.value.email}).` },
+      }));
+    },
+  ),
+});
