diff --git a/tests/unit/team-service.test.ts b/tests/unit/team-service.test.ts
new file mode 100644
index 0000000..854bdd3
--- /dev/null
+++ b/tests/unit/team-service.test.ts
@@ -0,0 +1,109 @@
+import { describe, it, expect } from "vitest";
+import { createTeamStore, type TeamMember } from "../../src/app/team/team.store.js";
+import { memberDirectory, inviteMember } from "../../src/app/team/team.service.js";
+
+// --- store ---
+
+describe("team store", () => {
+  it("seeds three members, both statuses represented", () => {
+    const members = createTeamStore().list();
+    expect(members).toHaveLength(3);
+    expect(new Set(members.map((m) => m.status))).toEqual(new Set(["active", "invited"]));
+  });
+
+  it("hands out copies, so a caller cannot edit the team behind its back", () => {
+    const store = createTeamStore();
+    (store.list() as TeamMember[]).pop();
+    expect(store.list()).toHaveLength(3);
+  });
+
+  it("keeps separate stores separate", () => {
+    const a = createTeamStore();
+    createTeamStore().add({ name: "Zed", email: "zed@example.com", role: "member", status: "invited" });
+    expect(a.list()).toHaveLength(3);
+  });
+});
+
+// --- memberDirectory ---
+
+describe("memberDirectory", () => {
+  const names = (query?: string) => {
+    const { listing } = memberDirectory(createTeamStore(), query);
+    return listing.kind === "members" ? listing.members.map((m) => m.name) : [];
+  };
+
+  it("lists everyone for a blank query", () => {
+    expect(names()).toEqual(["Ada Lovelace", "Grace Hopper", "Alan Turing"]);
+    expect(names("   ")).toHaveLength(3);
+  });
+
+  it("matches a case-insensitive substring of the name or the email", () => {
+    expect(names("LOVE")).toEqual(["Ada Lovelace"]);
+    expect(names("grace@")).toEqual(["Grace Hopper"]);
+    expect(names("  alan ")).toEqual(["Alan Turing"]);
+    expect(names("a")).toHaveLength(3);
+  });
+
+  it("reports no match with the trimmed query, keeping the box's value as typed", () => {
+    expect(memberDirectory(createTeamStore(), " zed ")).toEqual({
+      query: " zed ",
+      listing: { kind: "no-match", query: "zed" },
+    });
+  });
+
+  it("reports an empty team as empty, whatever the query", () => {
+    expect(memberDirectory(createTeamStore([]), "ada").listing).toEqual({ kind: "empty" });
+  });
+});
+
+// --- inviteMember ---
+
+describe("inviteMember", () => {
+  it("adds an invited member with a trimmed name and a normalized email", () => {
+    const store = createTeamStore();
+    const result = inviteMember(store, { name: "  Katherine Johnson ", email: " Katherine@Example.COM ", role: "admin" });
+
+    expect(result.ok).toBe(true);
+    expect(store.list()).toHaveLength(4);
+    expect(store.list()[3]).toMatchObject({
+      name: "Katherine Johnson",
+      email: "katherine@example.com",
+      role: "admin",
+      status: "invited",
+    });
+  });
+
+  it("requires a name", () => {
+    const result = inviteMember(createTeamStore(), { name: "   ", email: "new@example.com", role: "member" });
+    expect(result).toEqual({ ok: false, error: { name: "Enter a name." } });
+  });
+
+  it("requires an email, and a valid one", () => {
+    const store = createTeamStore();
+    expect(inviteMember(store, { name: "N", email: "", role: "member" }))
+      .toEqual({ ok: false, error: { email: "Enter an email address." } });
+    for (const email of ["not-an-email", "a@b", "a b@example.com", "@example.com"]) {
+      const result = inviteMember(store, { name: "N", email, role: "member" });
+      expect(result.ok ? null : result.error.email, email).toContain("valid email");
+    }
+  });
+
+  it("rejects an email already on the team, ignoring case and whitespace", () => {
+    const result = inviteMember(createTeamStore(), { name: "Ada Again", email: " ADA@example.com", role: "member" });
+    expect(result).toEqual({ ok: false, error: { email: "ada@example.com is already on the team." } });
+  });
+
+  it("reports every failing field at once and adds nobody", () => {
+    const store = createTeamStore();
+    const result = inviteMember(store, { name: "", email: "nope", role: "owner" });
+    expect(result.ok ? {} : Object.keys(result.error).sort()).toEqual(["email", "name"]);
+    expect(store.list()).toHaveLength(3);
+  });
+
+  it("refuses the same email twice in a row", () => {
+    const store = createTeamStore();
+    expect(inviteMember(store, { name: "Zed", email: "zed@example.com", role: "member" }).ok).toBe(true);
+    expect(inviteMember(store, { name: "Zed", email: "zed@example.com", role: "member" }).ok).toBe(false);
+    expect(store.list()).toHaveLength(4);
+  });
+});
