diff --git a/tests/integration/team.test.ts b/tests/integration/team.test.ts
new file mode 100644
index 0000000..48f1104
--- /dev/null
+++ b/tests/integration/team.test.ts
@@ -0,0 +1,135 @@
+import { describe, it, expect, beforeAll, afterAll } from "vitest";
+import { buildServer } from "../../src/core/server/server.js";
+import { prisma, sessionCookie } from "../setup.js";
+import { hashPassword } from "../../src/app/auth/shared/password.js";
+
+const PASSWORD = "testpassword123";
+const EMAIL = "team-test@example.com";
+const HTMX = { "hx-request": "true" };
+
+describe("Team", () => {
+  let server: Awaited<ReturnType<typeof buildServer>>;
+  let cookie: string;
+
+  beforeAll(async () => {
+    server = await buildServer();
+    await server.ready();
+    await prisma.user.deleteMany({ where: { email: EMAIL } });
+    await prisma.user.create({ data: { email: EMAIL, name: "Team Test", password: await hashPassword(PASSWORD) } });
+    const res = await server.inject({ method: "POST", url: "/auth/signin", payload: { email: EMAIL, password: PASSWORD } });
+    cookie = sessionCookie(res);
+  });
+
+  afterAll(async () => {
+    await prisma.user.deleteMany({ where: { email: EMAIL } });
+    await server.close();
+  });
+
+  it("requires authentication", async () => {
+    for (const url of ["/team", "/team/members?q=ada"]) {
+      const res = await server.inject({ method: "GET", url });
+      expect(res.statusCode, url).toBe(302);
+      expect(res.headers.location).toBe("/auth/login");
+    }
+    const invite = await server.inject({
+      method: "POST", url: "/team/invite",
+      payload: { name: "Sneaky", email: "sneaky@example.com", role: "owner" },
+    });
+    expect(invite.statusCode).toBe(302);
+  });
+
+  it("lists the seeded members", async () => {
+    const res = await server.inject({ method: "GET", url: "/team", headers: { cookie } });
+    expect(res.statusCode).toBe(200);
+    for (const text of ["Ada Lovelace", "grace@example.com", "Alan Turing", "Owner", "Active", "Invited"]) {
+      expect(res.body).toContain(text);
+    }
+  });
+
+  it("answers a live search with the directory fragment alone", async () => {
+    const res = await server.inject({ method: "GET", url: "/team/members?q=GRACE", headers: { cookie, ...HTMX } });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toMatch(/^<div id="member-directory"/);
+    expect(res.body).not.toContain('id="main-content"');
+    expect(res.body).toContain("Grace Hopper");
+    expect(res.body).not.toContain("Ada Lovelace");
+    expect(res.body).toContain('value="GRACE"');
+  });
+
+  it("names the query when the search matches nothing", async () => {
+    const res = await server.inject({ method: "GET", url: "/team/members?q=nobody", headers: { cookie, ...HTMX } });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toContain("No members match “nobody”.");
+  });
+
+  it("filters the full page from its query string too", async () => {
+    const res = await server.inject({ method: "GET", url: "/team?q=alan", headers: { cookie } });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toContain("Alan Turing");
+    expect(res.body).not.toContain("Grace Hopper");
+  });
+
+  it("rejects an invalid invite with the form region alone, messages by the fields, input kept", async () => {
+    const res = await server.inject({
+      method: "POST", url: "/team/invite", headers: { cookie, ...HTMX },
+      payload: { name: " ", email: "not-an-email", role: "admin" },
+    });
+    expect(res.statusCode).toBe(422);
+    expect(res.body).toMatch(/^<div id="invite-form"/);
+    expect(res.body).toContain('<span id="invite-name-error">Enter a name.</span>');
+    expect(res.body).toContain('<span id="invite-email-error">Enter a valid email address');
+    expect(res.body).toContain('value="not-an-email"');
+    expect(res.body).toMatch(/<option value="admin" selected/);
+  });
+
+  it("rejects an email already on the team", async () => {
+    const res = await server.inject({
+      method: "POST", url: "/team/invite", headers: { cookie, ...HTMX },
+      payload: { name: "Another Ada", email: "ADA@example.com", role: "member" },
+    });
+    expect(res.statusCode).toBe(422);
+    expect(res.body).toContain("ada@example.com is already on the team.");
+    expect(res.body).toContain('value="Another Ada"');
+  });
+
+  it("answers a no-JS rejection with the whole page", async () => {
+    const res = await server.inject({
+      method: "POST", url: "/team/invite", headers: { cookie },
+      payload: { name: "", email: "", role: "member" },
+    });
+    expect(res.statusCode).toBe(422);
+    expect(res.body).toContain("<!DOCTYPE html>");
+    expect(res.body).toContain("Enter a name.");
+    expect(res.body).toContain("Ada Lovelace");
+  });
+
+  it("refuses a role outside owner/admin/member", async () => {
+    const res = await server.inject({
+      method: "POST", url: "/team/invite", headers: { cookie },
+      payload: { name: "Root", email: "root@example.com", role: "superuser" },
+    });
+    expect(res.statusCode).toBe(400);
+  });
+
+  it("invites a member: listed as invited, with a fresh form and no filter", async () => {
+    const res = await server.inject({
+      method: "POST", url: "/team/invite", headers: { cookie, ...HTMX },
+      payload: { name: "Katherine Johnson", email: "katherine@example.com", role: "admin" },
+    });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toContain('id="main-content"');
+    expect(res.body).toContain("Invited Katherine Johnson (katherine@example.com).");
+    expect(res.body).toMatch(
+      /<td>Katherine Johnson<\/td>\s*<td>katherine@example\.com<\/td>\s*<td>Admin<\/td>\s*<td><span class="[^"]*">Invited<\/span>/,
+    );
+    // The whole seeded team is back in view: the search box is cleared, not kept.
+    expect(res.body).toContain("Ada Lovelace");
+    expect(res.body).toMatch(/name="q"[^>]*value=""/);
+    // A fresh form: nothing the user typed survives, role back on its default.
+    expect(res.body).not.toContain('value="katherine@example.com"');
+    expect(res.body).toMatch(/<option value="member" selected/);
+
+    const again = await server.inject({ method: "GET", url: "/team/members?q=katherine", headers: { cookie, ...HTMX } });
+    expect(again.body).toContain("Katherine Johnson");
+  });
+});
