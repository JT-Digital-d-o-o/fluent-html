@@ -0,0 +1,130 @@
+import { describe, it, expect, beforeAll, afterAll } from "vitest";
+import { buildServer } from "../../src/core/server/server.js";
+import { prisma, sessionCookie } from "../setup.js";
+import { hashPassword } from "../../src/app/auth/shared/password.js";
+
+const PASSWORD = "testpassword123";
+const EMAIL = "team-test@example.com";
+const HTMX = { "hx-request": "true" };
+
+async function cleanup() {
+  await prisma.user.deleteMany({ where: { email: EMAIL } });
+}
+
+describe("Team", () => {
+  let server: Awaited<ReturnType<typeof buildServer>>;
+  let cookie: string;
+
+  beforeAll(async () => {
+    server = await buildServer();
+    await server.ready();
+    await cleanup();
+    await prisma.user.create({
+      data: { email: EMAIL, name: "Team Test", password: await hashPassword(PASSWORD) },
+    });
+    const res = await server.inject({ method: "POST", url: "/auth/signin", payload: { email: EMAIL, password: PASSWORD } });
+    cookie = sessionCookie(res);
+  });
+
+  afterAll(async () => {
+    await cleanup();
+    await server.close();
+  });
+
+  it("requires authentication", async () => {
+    for (const [method, url] of [["GET", "/team"], ["GET", "/team/members?q=ada"], ["POST", "/team/invite"]] as const) {
+      const res = await server.inject({ method, url, payload: method === "POST" ? { name: "X", email: "x@example.com", role: "member" } : undefined });
+      expect(res.statusCode, `${method} ${url}`).toBe(302);
+      expect(res.headers.location).toBe("/auth/login");
+    }
+  });
+
+  it("renders the page with the seeded members", async () => {
+    const res = await server.inject({ method: "GET", url: "/team", headers: { cookie } });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toContain("Ada Lovelace");
+    expect(res.body).toContain("Grace Hopper");
+    expect(res.body).toContain("Alan Turing");
+  });
+
+  it("links the page from the main navigation", async () => {
+    const res = await server.inject({ method: "GET", url: "/account", headers: { cookie } });
+    expect(res.body).toContain('hx-get="/team"');
+  });
+
+  it("answers a search with the member panel alone", async () => {
+    const res = await server.inject({ method: "GET", url: "/team/members?q=GRACE", headers: { cookie, ...HTMX } });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toContain('id="member-panel"');
+    expect(res.body).not.toContain('id="main-content"');
+    expect(res.body).toContain("Grace Hopper");
+    expect(res.body).not.toContain("Ada Lovelace");
+  });
+
+  it("names the query when a search matches nothing", async () => {
+    const res = await server.inject({ method: "GET", url: "/team/members?q=nobody", headers: { cookie, ...HTMX } });
+    expect(res.body).toContain("No members match “nobody”.");
+  });
+
+  it("filters the full page by ?q, for a no-JS search", async () => {
+    const res = await server.inject({ method: "GET", url: "/team?q=turing", headers: { cookie } });
+    expect(res.body).toContain("Alan Turing");
+    expect(res.body).not.toContain("Ada Lovelace");
+  });
+
+  it("rejects an invalid invite with messages next to the fields, keeping the typed values", async () => {
+    const res = await server.inject({
+      method: "POST", url: "/team/invite", headers: { cookie, ...HTMX },
+      payload: { name: "  ", email: "not-an-email", role: "admin" },
+    });
+    expect(res.statusCode).toBe(422);
+    expect(res.body).toContain('id="invite-form"');
+    expect(res.body).not.toContain('id="main-content"');
+    expect(res.body).toContain("Name is required.");
+    expect(res.body).toContain("Enter a valid email address");
+    expect(res.body).toContain('value="not-an-email"');
+  });
+
+  it("rejects an email that is already on the team", async () => {
+    const res = await server.inject({
+      method: "POST", url: "/team/invite", headers: { cookie, ...HTMX },
+      payload: { name: "Ada Again", email: "ADA@example.com", role: "member" },
+    });
+    expect(res.statusCode).toBe(422);
+    expect(res.body).toContain("ada@example.com is already on the team.");
+  });
+
+  it("answers a rejected no-JS invite with the whole page", async () => {
+    const res = await server.inject({
+      method: "POST", url: "/team/invite", headers: { cookie },
+      payload: { name: "", email: "", role: "member" },
+    });
+    expect(res.statusCode).toBe(422);
+    expect(res.body).toContain("<!DOCTYPE html>");
+    expect(res.body).toContain("Email is required.");
+  });
+
+  it("refuses a role outside owner/admin/member", async () => {
+    const res = await server.inject({
+      method: "POST", url: "/team/invite", headers: { cookie, ...HTMX },
+      payload: { name: "Mallory", email: "mallory@example.com", role: "superuser" },
+    });
+    expect(res.statusCode).toBe(400);
+  });
+
+  it("invites a member: re-renders the page with them listed as invited", async () => {
+    const res = await server.inject({
+      method: "POST", url: "/team/invite", headers: { cookie, ...HTMX },
+      payload: { name: "Katherine Johnson", email: "Katherine@Example.com", role: "admin" },
+    });
+    expect(res.statusCode).toBe(200);
+    expect(res.body).toContain('id="main-content"');
+    expect(res.body).toContain("Invitation sent to Katherine Johnson (katherine@example.com).");
+    expect(res.body).toContain("Katherine Johnson");
+    expect(res.body).toContain("4 members");
+
+    const page = await server.inject({ method: "GET", url: "/team?q=katherine", headers: { cookie } });
+    expect(page.body).toContain("katherine@example.com");
+    expect(page.body).toContain("Invited");
+  });
+});
