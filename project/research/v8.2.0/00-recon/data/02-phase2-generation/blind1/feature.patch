--- /dev/null
+++ b/src/app/team/team.schema.ts
@@ -0,0 +1,23 @@
+import { Type, type Static } from "@sinclair/typebox";
+
+/** Roles a member can hold, in the order the invite form offers them. */
+export const MEMBER_ROLES = ["owner", "admin", "member"] as const;
+export type MemberRole = (typeof MEMBER_ROLES)[number];
+
+/** Pragmatic address shape: something@something.tld, no whitespace. */
+export const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+// Name and email are validated in the service, not here: an empty or malformed value is a
+// user mistake that re-renders the form with a message next to the field (422), where a
+// schema failure answers the generic 400 error page. Role comes from a <select>, so a value
+// outside the enum is a forged request and the 400 is the right answer.
+const InviteMemberBody = Type.Object({
+  name: Type.String({ maxLength: 80 }),
+  email: Type.String({ maxLength: 254 }),
+  role: Type.Union(MEMBER_ROLES.map((role) => Type.Literal(role))),
+}, { additionalProperties: false });
+export type InviteMemberReq = Static<typeof InviteMemberBody>;
+export const inviteMemberSchema = { body: InviteMemberBody };
+
+/** The member search box — the `q` query the page and members routes declare. */
+export type MemberSearchReq = { q: string };
