--- /dev/null
+++ b/src/app/team/team.service.ts
@@ -0,0 +1,60 @@
+import type { ErrorBag } from "fluent-html";
+import { normalizeEmail } from "../../shared/formatters.js";
+import { ok, fail, type Result } from "../../shared/result.js";
+import { validate } from "../../shared/validation.js";
+import { EMAIL_PATTERN, type InviteMemberReq } from "./team.schema.js";
+import type { TeamMember, TeamStore } from "./team.store.js";
+
+/** What the member panel shows: the members matching `query`, out of a team of `teamSize`. */
+export type MemberListing = {
+  query: string;
+  teamSize: number;
+  members: readonly TeamMember[];
+};
+
+/** Field → message, the shape `Form<InviteMemberReq>` wires next to each control. */
+export type InviteErrors = ErrorBag<InviteMemberReq>;
+
+type FieldError = { field: keyof InviteMemberReq; message: string };
+
+// The team narrowed to members whose name or email contains the query, case-insensitively.
+// A blank query is no filter at all.
+export function searchMembers(store: TeamStore, rawQuery = ""): MemberListing {
+  const query = rawQuery.trim();
+  const needle = query.toLowerCase();
+  const team = store.list();
+  const members = team.filter((member) =>
+    member.name.toLowerCase().includes(needle) || member.email.toLowerCase().includes(needle));
+  return { query, teamSize: team.length, members };
+}
+
+function emailError(store: TeamStore, email: string): FieldError | null {
+  if (email === "") return { field: "email", message: "Email is required." };
+  if (!EMAIL_PATTERN.test(email)) {
+    return { field: "email", message: "Enter a valid email address, like name@example.com." };
+  }
+  if (store.findByEmail(email)) return { field: "email", message: `${email} is already on the team.` };
+  return null;
+}
+
+// Invite a member: every field is checked independently so the form can show all of its
+// messages at once. The new member starts out invited.
+export function inviteMember(
+  store: TeamStore,
+  body: InviteMemberReq,
+): Result<TeamMember, InviteErrors> {
+  const invite = { name: body.name.trim(), email: normalizeEmail(body.email), role: body.role };
+
+  const checked = validate<typeof invite, FieldError>(
+    invite,
+    (i) => (i.name === "" ? { field: "name", message: "Name is required." } : null),
+    (i) => emailError(store, i.email),
+  );
+  if (!checked.ok) {
+    const errors: InviteErrors = {};
+    for (const { field, message } of checked.errors) errors[field] = message;
+    return fail(errors);
+  }
+
+  return ok(store.add({ ...invite, status: "invited" }));
+}
diff --git a/src/app/team/team.store.ts b/src/app/team/team.store.ts
new file mode 100644
index 0000000..b2cbc56
--- /dev/null
+++ b/src/app/team/team.store.ts
@@ -0,0 +1,47 @@
+import { randomUUID } from "node:crypto";
+import type { MemberRole } from "./team.schema.js";
+
+export type MemberStatus = "active" | "invited";
+
+export type TeamMember = {
+  id: string;
+  name: string;
+  email: string;
+  role: MemberRole;
+  status: MemberStatus;
+};
+
+export type NewTeamMember = Omit<TeamMember, "id">;
+
+export type TeamStore = {
+  /** Every member, in the order they joined or were invited. */
+  list(): readonly TeamMember[];
+  /** The member with this email — pass it normalized (`normalizeEmail`), as stored. */
+  findByEmail(email: string): TeamMember | undefined;
+  add(member: NewTeamMember): TeamMember;
+};
+
+export function createTeamStore(seed: readonly NewTeamMember[] = []): TeamStore {
+  const members: TeamMember[] = seed.map((member) => ({ ...member, id: randomUUID() }));
+  return {
+    list: () => [...members],
+    findByEmail: (email) => members.find((member) => member.email === email),
+    add(member) {
+      const created = { ...member, id: randomUUID() };
+      members.push(created);
+      return created;
+    },
+  };
+}
+
+const SEED_MEMBERS: readonly NewTeamMember[] = [
+  { name: "Ada Lovelace", email: "ada@example.com", role: "owner", status: "active" },
+  { name: "Grace Hopper", email: "grace@example.com", role: "admin", status: "active" },
+  { name: "Alan Turing", email: "alan@example.com", role: "member", status: "invited" },
+];
+
+/**
+ * The app's team. Process memory: it resets to the seed on every restart and is not shared
+ * between server instances — move it to a Prisma model when the team has to persist.
+ */
+export const teamStore = createTeamStore(SEED_MEMBERS);
