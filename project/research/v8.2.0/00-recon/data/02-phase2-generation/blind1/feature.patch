+import { defineRoutes, defineIds } from "fluent-html";
+
+// `memberPanel` is the live-search swap target (search box + results); `inviteForm` is the
+// 422 target — a rejected invite re-renders this region alone.
+export const teamIds = defineIds(["member-panel", "invite-form"] as const);
+
+export const teamRoutes = defineRoutes("/team", {
+  page:    { path: "/", query: { q: "string" } as const },
+  // What the search box asks for as the user types: the member panel alone, filtered by `q`.
+  members: { path: "/members", query: { q: "string" } as const, render: teamIds.memberPanel },
+  // The 200 answer is the page (fresh form, updated list); the 422 is the invite form alone,
+  // routed there by `.submit(…, { invalid: teamIds.inviteForm })` rather than by a stance.
+  invite:  { method: "post", path: "/invite" },
+} as const);
