@@ -0,0 +1,103 @@
+import { describe, it, expect } from "vitest";
+import { createTeamStore, teamStore, type NewTeamMember } from "../../src/app/team/team.store.js";
+import { inviteMember, searchMembers } from "../../src/app/team/team.service.js";
+
+const SEED: NewTeamMember[] = [
+  { name: "Ada Lovelace", email: "ada@example.com", role: "owner", status: "active" },
+  { name: "Grace Hopper", email: "grace@navy.example", role: "admin", status: "active" },
+  { name: "Alan Turing", email: "alan@example.com", role: "member", status: "invited" },
+];
+
+const invite = (overrides: Partial<{ name: string; email: string; role: "owner" | "admin" | "member" }> = {}) => ({
+  name: "Katherine Johnson",
+  email: "katherine@example.com",
+  role: "member" as const,
+  ...overrides,
+});
+
+describe("teamStore", () => {
+  it("is seeded with three members", () => {
+    expect(teamStore.list()).toHaveLength(3);
+  });
+});
+
+describe("searchMembers", () => {
+  it("returns the whole team for a blank query", () => {
+    const listing = searchMembers(createTeamStore(SEED), "   ");
+    expect(listing.members.map((m) => m.name)).toEqual(["Ada Lovelace", "Grace Hopper", "Alan Turing"]);
+    expect(listing.teamSize).toBe(3);
+    expect(listing.query).toBe("");
+  });
+
+  it("matches names case-insensitively", () => {
+    const listing = searchMembers(createTeamStore(SEED), "HOPPER");
+    expect(listing.members.map((m) => m.name)).toEqual(["Grace Hopper"]);
+  });
+
+  it("matches emails", () => {
+    const listing = searchMembers(createTeamStore(SEED), "navy.example");
+    expect(listing.members.map((m) => m.name)).toEqual(["Grace Hopper"]);
+  });
+
+  it("trims the query it filters by and reports", () => {
+    const listing = searchMembers(createTeamStore(SEED), "  alan ");
+    expect(listing.query).toBe("alan");
+    expect(listing.members.map((m) => m.name)).toEqual(["Alan Turing"]);
+  });
+
+  it("keeps the team size when nothing matches", () => {
+    const listing = searchMembers(createTeamStore(SEED), "zed");
+    expect(listing.members).toEqual([]);
+    expect(listing.teamSize).toBe(3);
+  });
+});
+
+describe("inviteMember", () => {
+  it("adds an invited member with a trimmed name and normalized email", () => {
+    const store = createTeamStore(SEED);
+    const result = inviteMember(store, invite({ name: "  Katherine Johnson ", email: " Katherine@Example.com ", role: "admin" }));
+
+    expect(result.ok).toBe(true);
+    const added = store.list().at(-1);
+    expect(added).toMatchObject({
+      name: "Katherine Johnson",
+      email: "katherine@example.com",
+      role: "admin",
+      status: "invited",
+    });
+    expect(store.list()).toHaveLength(4);
+  });
+
+  it("requires a name", () => {
+    const result = inviteMember(createTeamStore(SEED), invite({ name: "   " }));
+    expect(result).toEqual({ ok: false, error: { name: "Name is required." } });
+  });
+
+  it("requires an email", () => {
+    const result = inviteMember(createTeamStore(SEED), invite({ email: "" }));
+    expect(result).toEqual({ ok: false, error: { email: "Email is required." } });
+  });
+
+  it.each(["not-an-email", "katherine@example", "kath erine@example.com", "@example.com"])(
+    "rejects the malformed email %j",
+    (email) => {
+      const result = inviteMember(createTeamStore(SEED), invite({ email }));
+      expect(result.ok).toBe(false);
+      if (!result.ok) expect(result.error.email).toContain("valid email");
+    },
+  );
+
+  it("rejects an email already on the team, whatever its case", () => {
+    const result = inviteMember(createTeamStore(SEED), invite({ email: "ADA@example.com" }));
+    expect(result).toEqual({ ok: false, error: { email: "ada@example.com is already on the team." } });
+  });
+
+  it("reports every rejected field at once and adds nobody", () => {
+    const store = createTeamStore(SEED);
+    const result = inviteMember(store, invite({ name: "", email: "nope" }));
+
+    expect(result.ok).toBe(false);
+    if (!result.ok) expect(Object.keys(result.error).sort()).toEqual(["email", "name"]);
+    expect(store.list()).toHaveLength(3);
+  });
+});
