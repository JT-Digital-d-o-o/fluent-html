+import type { FastifyReply, FastifyRequest } from "fastify";
+import { defineController, fragment, guarded, page } from "../../core/render/define-controller.js";
+import { isHtmxRequest } from "../../core/htmx/htmx-request.js";
+import { requireAuth } from "../auth/shared/guards.js";
+import { teamRoutes } from "./team.routes.js";
+import { inviteMemberSchema } from "./team.schema.js";
+import { teamStore } from "./team.store.js";
+import { inviteMember, searchMembers } from "./team.service.js";
+import { TeamPage, MemberPanel, InvitePanel, type InviteFormState } from "./team.view.js";
+
+// A rejected invite answers the way a rejected sign-in does: the submit carries
+// `{ invalid: teamIds.inviteForm }`, so htmx swaps the invite form alone and the list around
+// it stays put; a no-JS post has no swap target and gets the whole page. One answer, two
+// shapes — hence `renderView` (see sign-in.controller.ts).
+function renderInviteRejected(request: FastifyRequest, reply: FastifyReply, invite: InviteFormState): FastifyReply {
+  reply.code(422).renderView(isHtmxRequest(request)
+    ? InvitePanel(invite)
+    : TeamPage({ user: request.user, listing: searchMembers(teamStore), invite }));
+  return reply;
+}
+
+export default defineController(teamRoutes, {
+  page: page(
+    ({ user, query }) => TeamPage({ user, listing: searchMembers(teamStore, query.q) }),
+    { guards: [requireAuth] },
+  ),
+
+  members: fragment(
+    ({ query }) => MemberPanel(searchMembers(teamStore, query.q)),
+    { guards: [requireAuth] },
+  ),
+
+  invite: guarded(
+    { guards: [requireAuth], schema: inviteMemberSchema },
+    async (request, reply) => {
+      const result = inviteMember(teamStore, request.body);
+      if (!result.ok) {
+        return renderInviteRejected(request, reply, { values: request.body, errors: result.error });
+      }
+      // Unfiltered, so the new member is in the list whatever the search box held.
+      return reply.renderPage(TeamPage({
+        user: request.user,
+        listing: searchMembers(teamStore),
+        invite: { success: `Invitation sent to ${result.value.name} (${result.value.email}).` },
+      }));
+    },
+  ),
+});
