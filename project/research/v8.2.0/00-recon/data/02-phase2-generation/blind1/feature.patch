index 0000000..60d22c4
--- /dev/null
+++ b/src/app/team/views/team.components.ts
@@ -0,0 +1,218 @@
+import {
+  Div,
+  H2,
+  P,
+  Span,
+  Form,
+  Table,
+  Thead,
+  Tbody,
+  Tr,
+  IfThen,
+  Match,
+  ForEachKeyed,
+  type FormBinding,
+  type Tag,
+} from "fluent-html";
+import { stylers, type Styler } from "../../../shared/stylers.js";
+import { count } from "../../../shared/formatters.js";
+import {
+  Alert,
+  EmptyState,
+  PrimaryButton,
+  PrimaryLinkButton,
+  ThCell,
+  TdCell,
+  cardChrome,
+  cardTitle,
+  inputStyle,
+  selectStyle,
+} from "../../../shared/ui/index.js";
+import { teamIds, teamRoutes } from "../team.routes.js";
+import { MEMBER_ROLES, type InviteMemberReq, type MemberRole, type MemberSearchReq } from "../team.schema.js";
+import type { MemberStatus, TeamMember } from "../team.store.js";
+import type { InviteErrors, MemberListing } from "../team.service.js";
+
+const ROLE_LABELS: Record<MemberRole, string> = { owner: "Owner", admin: "Admin", member: "Member" };
+const STATUS_LABELS: Record<MemberStatus, string> = { active: "Active", invited: "Invited" };
+const ROLE_OPTIONS = MEMBER_ROLES.map((role) => ({ value: role, label: ROLE_LABELS[role] }));
+
+// One hue per status, tinted with the opacity modifier: active reads as settled, invited as pending.
+const statusTone = stylers<MemberStatus>({
+  active:  (t) => t.bg("success/10").text("success"),
+  invited: (t) => t.bg("warning/10").text("warning"),
+});
+
+export function StatusBadge({ status }: { status: MemberStatus }) {
+  return Span(STATUS_LABELS[status])
+    .inlineFlex()
+    .items("center")
+    .rounded("control")
+    .p("x", "2")
+    .p("y", "0.5")
+    .text("xs")
+    .font("medium")
+    .apply(statusTone[status]);
+}
+
+function MemberRow(member: TeamMember) {
+  return Tr(
+    TdCell({ content: Span(member.name).font("medium").text("text") }),
+    TdCell({ content: member.email }),
+    TdCell({ content: ROLE_LABELS[member.role] }),
+    TdCell({ content: StatusBadge({ status: member.status }) }),
+  ).border("t").border("line");
+}
+
+function MemberTable(members: readonly TeamMember[]) {
+  return Div(
+    Table(
+      Thead(Tr(
+        ThCell({ text: "Name" }).setScope("col"),
+        ThCell({ text: "Email" }).setScope("col"),
+        ThCell({ text: "Role" }).setScope("col"),
+        ThCell({ text: "Status" }).setScope("col"),
+      )),
+      // Keyed rows, so a filtering morph matches each member to its own row.
+      Tbody(ForEachKeyed(members, (member) => `member-${member.id}`, MemberRow)),
+    ).w("full"),
+  ).overflow("x", "auto");
+}
+
+type MemberListState =
+  | { kind: "emptyTeam" }
+  | { kind: "noMatches"; query: string }
+  | { kind: "members"; members: readonly TeamMember[] };
+
+// An empty team outranks an empty search: with nobody on the team, inviting is the next step.
+function memberListState({ query, teamSize, members }: MemberListing): MemberListState {
+  if (teamSize === 0) return { kind: "emptyTeam" };
+  if (members.length === 0) return { kind: "noMatches", query };
+  return { kind: "members", members };
+}
+
+// A <form> so Enter is answered by the same fragment instead of a page load (and, without
+// JS, still lands on /team?q=…). Typing is the input's own debounced `.search`.
+function MemberSearch(query: string) {
+  return Form<MemberSearchReq>({ values: { q: query } }, (f) => [
+    f.label("q", "Search members").srOnly(),
+    f.input("q", "search")
+      .setPlaceholder("Search by name or email")
+      .apply(inputStyle)
+      .search(teamIds.memberPanel, teamRoutes.members()),
+  ])
+    .fragment(teamIds.memberPanel, teamRoutes.members())
+    .setRole("search")
+    .m("y", "4");
+}
+
+/**
+ * The members card: search box, member count and the list or its empty state. Rooted at
+ * `memberPanel`, so it is both part of the page and the whole answer to a search. The search
+ * box re-renders with every answer, which keeps its `value` attribute on the query the list
+ * was filtered by — so a page render with no query (after an invite) clears it too.
+ */
+export function MemberPanel(listing: MemberListing) {
+  return Div(
+    Div(
+      H2("Members").apply(cardTitle),
+      Span(count(listing.teamSize, { one: "member", other: "members" }))
+        .text("sm")
+        .text("text-dim"),
+    ).flex().items("center").justify("between").gap("4"),
+    MemberSearch(listing.query),
+    Match(memberListState(listing), "kind", {
+      emptyTeam: () => EmptyState({
+        message: "Your team has no members yet. Invite someone to get started.",
+        actionView: PrimaryLinkButton({ label: "Invite a member" }).setHref(`#${teamIds.inviteForm.id}`),
+      }),
+      noMatches: ({ query }) => EmptyState({ message: `No members match “${query}”.` }),
+      members: ({ members }) => MemberTable(members),
+    }),
+  )
+    .apply(cardChrome)
+    .p("6")
+    .setId(teamIds.memberPanel);
+}
+
+/**
+ * What the invite form shows: the typed values and a message per rejected field after a 422,
+ * or the confirmation after a successful invite.
+ */
+export type InviteFormState = {
+  values?: Partial<InviteMemberReq>;
+  errors?: InviteErrors;
+  success?: string;
+};
+
+const fieldLabel: Styler = (t) => t
+  .text("sm")
+  .font("medium")
+  .text("text")
+  .m("b", "1")
+  .block();
+
+type InviteFieldProps = {
+  f: FormBinding<InviteMemberReq>;
+  name: keyof InviteMemberReq;
+  label: string;
+  control: Tag;
+  error?: string;
+};
+
+// Label, control and — when the field was rejected — its message right under it. The binding
+// ties them together: `for`/`id`, and `aria-invalid` + `aria-describedby` on the control
+// naming the span `f.error()` renders.
+function InviteField({ f, name, label, control, error }: InviteFieldProps) {
+  return Div(
+    f.label(name, label).apply(fieldLabel),
+    control,
+    IfThen(error, () => P(f.error(name)).text("sm").text("danger").m("t", "1")),
+  );
+}
+
+/**
+ * The invite card, rooted at `inviteForm` — the 422 target, so a rejected invite re-renders
+ * exactly this, with the typed values and the messages. A success re-renders the page around
+ * a fresh form, but a morph only syncs what the markup changed and leaves the typed text in
+ * place, so `resetOnSuccess` clears the controls once the request succeeds.
+ *
+ * `novalidate` makes the server the one place a mistake is reported (htmx skips constraint
+ * validation for it): the messages render next to the fields and stay put, where the
+ * browser's bubbles would pre-empt them. `required`/`type="email"` still carry the semantics.
+ */
+export function InvitePanel({ values = { role: "member" }, errors = {}, success }: InviteFormState) {
+  return Div(
+    Div(
+      H2("Invite member").apply(cardTitle),
+      P("They show as invited until they accept.")
+        .text("sm")
+        .text("text-dim")
+        .m("t", "1"),
+    ).m("b", "6"),
+    IfThen(success, (message) => Alert({ message, type: "success" }).setRole("status")),
+    Form<InviteMemberReq>({ values, errors, idPrefix: "invite" }, (f) => [
+      Div(
+        InviteField({
+          f, name: "name", label: "Name", error: errors.name,
+          control: f.input("name", "text").apply(inputStyle).setMaxlength(80).toggle("required"),
+        }),
+        InviteField({
+          f, name: "email", label: "Email", error: errors.email,
+          control: f.input("email", "email").apply(inputStyle).setMaxlength(254).toggle("required"),
+        }),
+        InviteField({
+          f, name: "role", label: "Role", error: errors.role,
+          control: f.select("role", ROLE_OPTIONS).apply(selectStyle),
+        }),
+      ).grid().gap("4").sm({ gridCols: "3" }),
+      PrimaryButton({ label: "Send invite" }).setType("submit").m("t", "6"),
+    ])
+      .toggle("novalidate")
+      .submit(teamRoutes.invite(), { invalid: teamIds.inviteForm })
+      .behavior("resetOnSuccess"),
+  )
+    .apply(cardChrome)
+    .p("6")
+    .setId(teamIds.inviteForm);
+}
