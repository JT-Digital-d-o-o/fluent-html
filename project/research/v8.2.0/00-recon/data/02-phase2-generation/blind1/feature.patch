diff --git a/tests/view/team.view.test.ts b/tests/view/team.view.test.ts
new file mode 100644
index 0000000..b6f88ab
--- /dev/null
+++ b/tests/view/team.view.test.ts
@@ -0,0 +1,152 @@
+import { describe, it, expect } from "vitest";
+import { render } from "fluent-html";
+import { TeamPage, MemberPanel, InvitePanel, StatusBadge } from "../../src/app/team/team.view.js";
+import { createTeamStore, type NewTeamMember } from "../../src/app/team/team.store.js";
+import { searchMembers } from "../../src/app/team/team.service.js";
+import { expectPageShell } from "./page-shell.js";
+
+const SEED: NewTeamMember[] = [
+  { name: "Ada Lovelace", email: "ada@example.com", role: "owner", status: "active" },
+  { name: "Grace Hopper", email: "grace@example.com", role: "admin", status: "active" },
+  { name: "Alan Turing", email: "alan@example.com", role: "member", status: "invited" },
+];
+
+const listing = (query?: string, seed: NewTeamMember[] = SEED) => searchMembers(createTeamStore(seed), query);
+
+describe("TeamPage", () => {
+  it("renders through Layout with every member's name, email, role and status", () => {
+    const html = render(TeamPage({ listing: listing() }));
+
+    expectPageShell(html, "Team");
+    for (const text of ["Ada Lovelace", "grace@example.com", "Owner", "Admin", "Member", "Active", "Invited"]) {
+      expect(html).toContain(text);
+    }
+    expect(html).toContain("3 members");
+  });
+
+  it("renders the member panel and the invite form", () => {
+    const html = render(TeamPage({ listing: listing() }));
+    expect(html).toContain('id="member-panel"');
+    expect(html).toContain('id="invite-form"');
+  });
+});
+
+describe("StatusBadge", () => {
+  it("colours each status with its own tone", () => {
+    const active = render(StatusBadge({ status: "active" }));
+    expect(active).toContain("Active");
+    expect(active).toContain("bg-success/10");
+    expect(active).toContain("text-success");
+
+    const invited = render(StatusBadge({ status: "invited" }));
+    expect(invited).toContain("Invited");
+    expect(invited).toContain("bg-warning/10");
+    expect(invited).toContain("text-warning");
+    expect(invited).not.toContain("success");
+  });
+});
+
+describe("MemberPanel", () => {
+  it("is rooted at the search swap target", () => {
+    expect(render(MemberPanel(listing()))).toMatch(/^<div[^>]*id="member-panel"/);
+  });
+
+  it("filters as the user types, into the member panel", () => {
+    const html = render(MemberPanel(listing()));
+    expect(html).toContain('type="search"');
+    expect(html).toContain('name="q"');
+    expect(html).toContain('hx-get="/team/members"');
+    expect(html).toContain('hx-target="#member-panel"');
+    expect(html).toContain('hx-trigger="input changed delay:300ms"');
+    expect(html).toContain('role="search"');
+  });
+
+  it("keeps the search box on the query the list was filtered by", () => {
+    expect(render(MemberPanel(listing("grace")))).toContain('value="grace"');
+    // Present even when blank: a morph only resets a typed value when the attribute changes.
+    expect(render(MemberPanel(listing()))).toContain('value=""');
+  });
+
+  it("lists only the matching members", () => {
+    const html = render(MemberPanel(listing("hopper")));
+    expect(html).toContain("Grace Hopper");
+    expect(html).not.toContain("Ada Lovelace");
+  });
+
+  it("says when a search matches nothing, and names the query", () => {
+    const html = render(MemberPanel(listing("<b>zed</b>")));
+    expect(html).toContain("No members match “&lt;b&gt;zed&lt;/b&gt;”.");
+    expect(html).not.toContain("<table");
+  });
+
+  it("prompts an invite when the team has no members", () => {
+    const html = render(MemberPanel(listing(undefined, [])));
+    expect(html).toContain("Your team has no members yet");
+    expect(html).toContain('href="#invite-form"');
+    expect(html).toContain("0 members");
+    expect(html).not.toContain("<table");
+  });
+
+  it("prefers the empty-team prompt over an empty search", () => {
+    const html = render(MemberPanel(listing("zed", [])));
+    expect(html).toContain("Your team has no members yet");
+    expect(html).not.toContain("No members match");
+  });
+});
+
+describe("InvitePanel", () => {
+  it("is rooted at the 422 swap target", () => {
+    expect(render(InvitePanel({}))).toMatch(/^<div[^>]*id="invite-form"/);
+  });
+
+  it("renders the name, email and role fields, member selected by default", () => {
+    const html = render(InvitePanel({}));
+    expect(html).toContain('name="name"');
+    expect(html).toContain('name="email"');
+    expect(html).toContain('type="email"');
+    expect(html).toContain('name="role"');
+    expect(html).toMatch(/<option[^>]*value="member"[^>]*selected/);
+    expect(html).toContain('for="invite-name"');
+  });
+
+  it("posts to the invite route, routes a 422 to itself and resets on success", () => {
+    const html = render(InvitePanel({}));
+    expect(html).toContain('hx-post="/team/invite"');
+    expect(html).toContain('hx-target="#main-content"');
+    expect(html).toMatch(/hx-status:422="[^"]*#invite-form/);
+    expect(html).toContain('data-behavior="resetOnSuccess"');
+  });
+
+  it("leaves validation to the server, so its messages are the ones shown", () => {
+    const html = render(InvitePanel({}));
+    expect(html).toMatch(/<form[^>]*novalidate/);
+    expect(html).toContain("required");
+  });
+
+  it("shows each message next to its field and keeps what was typed", () => {
+    const html = render(InvitePanel({
+      values: { name: "", email: "bob@", role: "admin" },
+      errors: { name: "Name is required.", email: "Enter a valid email address, like name@example.com." },
+    }));
+
+    expect(html).toContain("Name is required.");
+    expect(html).toContain("Enter a valid email address");
+    expect(html).toContain('id="invite-email-error"');
+    expect(html).toContain('aria-describedby="invite-email-error"');
+    expect(html).toContain('aria-invalid="true"');
+    expect(html).toContain('value="bob@"');
+    expect(html).toMatch(/<option[^>]*value="admin"[^>]*selected/);
+  });
+
+  it("renders no error slot when nothing was rejected", () => {
+    const html = render(InvitePanel({}));
+    expect(html).not.toContain("aria-invalid");
+    expect(html).not.toContain("-error");
+  });
+
+  it("confirms a successful invite", () => {
+    const html = render(InvitePanel({ success: "Invitation sent to Bob (bob@example.com)." }));
+    expect(html).toContain("Invitation sent to Bob (bob@example.com).");
+    expect(html).toContain('role="status"');
+  });
+});
