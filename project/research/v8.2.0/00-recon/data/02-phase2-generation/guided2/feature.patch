diff --git a/tests/unit/team.service.test.ts b/tests/unit/team.service.test.ts
new file mode 100644
index 0000000..040da9e
--- /dev/null
+++ b/tests/unit/team.service.test.ts
@@ -0,0 +1,93 @@
+import { describe, it, expect } from "vitest";
+import { createTeamStore, teamStore, type NewMember } from "../../src/app/team/team.store.js";
+import { inviteMember, memberListState } from "../../src/app/team/team.service.js";
+
+const SEED: readonly NewMember[] = [
+  { name: "Ada Lovelace", email: "ada@example.com", role: "owner", status: "active" },
+  { name: "Grace Hopper", email: "grace@example.com", role: "admin", status: "active" },
+  { name: "Alan Turing", email: "alan@example.com", role: "member", status: "invited" },
+];
+
+describe("teamStore", () => {
+  it("is seeded with three members", () => {
+    expect(teamStore.list()).toHaveLength(3);
+  });
+});
+
+describe("memberListState", () => {
+  it("lists every member when there is no query", () => {
+    const state = memberListState(createTeamStore(SEED));
+    expect(state.kind).toBe("results");
+    expect(state.kind === "results" && state.members.map((m) => m.name)).toEqual([
+      "Ada Lovelace",
+      "Grace Hopper",
+      "Alan Turing",
+    ]);
+  });
+
+  it("filters by name, case-insensitively", () => {
+    const state = memberListState(createTeamStore(SEED), "GRACE");
+    expect(state.kind === "results" && state.members.map((m) => m.name)).toEqual(["Grace Hopper"]);
+  });
+
+  it("filters by email", () => {
+    const state = memberListState(createTeamStore(SEED), "alan@");
+    expect(state.kind === "results" && state.members.map((m) => m.name)).toEqual(["Alan Turing"]);
+  });
+
+  it("reports a search with no matches, naming the trimmed query", () => {
+    expect(memberListState(createTeamStore(SEED), "  zed  ")).toEqual({ kind: "no-matches", query: "zed" });
+  });
+
+  it("reports an empty team whatever the query", () => {
+    expect(memberListState(createTeamStore(), "ada")).toEqual({ kind: "empty" });
+  });
+});
+
+describe("inviteMember", () => {
+  it("adds an invited member with a trimmed name and normalized email", () => {
+    const store = createTeamStore(SEED);
+    const result = inviteMember(store, { name: "  Katherine Johnson ", email: " Katherine@Example.com ", role: "admin" });
+
+    expect(result.ok).toBe(true);
+    expect(result.ok && result.value).toMatchObject({
+      name: "Katherine Johnson",
+      email: "katherine@example.com",
+      role: "admin",
+      status: "invited",
+    });
+    expect(store.list()).toHaveLength(4);
+  });
+
+  it("requires a name", () => {
+    const result = inviteMember(createTeamStore(SEED), { name: "   ", email: "new@example.com", role: "member" });
+    expect(!result.ok && result.error.name).toBe("Name is required.");
+  });
+
+  it("requires an email", () => {
+    const result = inviteMember(createTeamStore(SEED), { name: "New", email: " ", role: "member" });
+    expect(!result.ok && result.error.email).toBe("Email is required.");
+  });
+
+  it("rejects an invalid email", () => {
+    const result = inviteMember(createTeamStore(SEED), { name: "New", email: "not-an-email", role: "member" });
+    expect(!result.ok && result.error.email).toBe("Enter a valid email address.");
+  });
+
+  it("rejects an email already on the team, ignoring case and whitespace", () => {
+    const result = inviteMember(createTeamStore(SEED), { name: "Ada", email: " ADA@example.com ", role: "member" });
+    expect(!result.ok && result.error.email).toBe("This email is already on the team.");
+  });
+
+  it("reports every failing field at once and adds nobody", () => {
+    const store = createTeamStore(SEED);
+    const result = inviteMember(store, { name: "", email: "grace@example.com", role: "member" });
+
+    expect(result.ok).toBe(false);
+    expect(!result.ok && result.error).toEqual({
+      name: "Name is required.",
+      email: "This email is already on the team.",
+    });
+    expect(store.list()).toHaveLength(3);
+  });
+});
