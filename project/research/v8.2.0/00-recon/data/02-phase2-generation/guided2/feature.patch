+export const teamRoutes = defineRoutes("/team", {
+  page:    { path: "/" },
+  members: { path: "/members", render: teamIds.memberList },
+  // The 200 answer is the page (the list gains the new member); the 422 is the form region
+  // alone, routed there by `.submit(…, { invalid: teamIds.inviteForm })` rather than by a stance.
+  invite:  { method: "post", path: "/members" },
+} as const);
