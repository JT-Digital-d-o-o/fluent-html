+import { Div, H2, P, Span, IfThen, View } from "fluent-html";
+import { cardChrome, cardTitle } from "../../../shared/ui/index.js";
+import type { MemberStatus } from "../team.store.js";
+import { STATUS_LABELS } from "../team.utils.js";
+
+export function StatusBadge({ status }: { status: MemberStatus }) {
+  return Span(STATUS_LABELS[status])
+    .whenMatch(status, {
+      active: (t) => t.bg("success/10").text("success"),
+      invited: (t) => t.bg("warning/10").text("warning"),
+    })
+    .inlineFlex()
+    .items("center")
+    .p("x", "2.5")
+    .p("y", "0.5")
+    .rounded("full")
+    .text("xs")
+    .font("medium");
+}
+
+type TeamCardProps = {
+  title: string;
+  description?: string;
+  content: View;
+};
+
+/** A titled card section of the team page. */
+export function TeamCard({ title, description, content }: TeamCardProps) {
+  return Div(
+    H2(title).apply(cardTitle),
+    IfThen(description, (d) => P(d).text("sm").text("text-dim").m("t", "1")),
+    Div(content).m("t", "4"),
+  )
+    .apply(cardChrome)
+    .p("6");
+}
