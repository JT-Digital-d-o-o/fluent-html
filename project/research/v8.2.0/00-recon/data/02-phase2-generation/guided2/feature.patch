diff --git a/tests/view/team.view.test.ts b/tests/view/team.view.test.ts
new file mode 100644
index 0000000..92c86c7
--- /dev/null
+++ b/tests/view/team.view.test.ts
@@ -0,0 +1,124 @@
+import { describe, it, expect } from "vitest";
+import { render } from "fluent-html";
+import type { AuthUser } from "../../src/core/server/types.js";
+import { teamIds } from "../../src/app/team/team.routes.js";
+import { createTeamStore, type Member, type MemberId } from "../../src/app/team/team.store.js";
+import { memberListState } from "../../src/app/team/team.service.js";
+import { TeamPage } from "../../src/app/team/views/team.page.view.js";
+import { MemberList } from "../../src/app/team/views/team.members.view.js";
+import { InviteForm } from "../../src/app/team/views/team.invite.view.js";
+import { expectPageShell } from "./page-shell.js";
+
+const user: AuthUser = {
+  id: "user-1",
+  email: "owner@example.com",
+  name: "Team Owner",
+  role: "USER",
+  createdAt: new Date(),
+  updatedAt: new Date(),
+  username: null,
+  bio: null,
+};
+
+const store = createTeamStore([
+  { name: "Ada Lovelace", email: "ada@example.com", role: "owner", status: "active" },
+  { name: "Alan Turing", email: "alan@example.com", role: "member", status: "invited" },
+]);
+
+const invited: Member = {
+  id: "member-new" as MemberId,
+  name: "Katherine Johnson",
+  email: "katherine@example.com",
+  role: "admin",
+  status: "invited",
+};
+
+describe("TeamPage", () => {
+  it("renders through the layout with one h1", () => {
+    expectPageShell(render(TeamPage({ user, members: memberListState(store) })), "Team");
+  });
+
+  it("lists each member's name, email, role and status", () => {
+    const html = render(TeamPage({ user, members: memberListState(store) }));
+    expect(html).toContain("Ada Lovelace");
+    expect(html).toContain("ada@example.com");
+    expect(html).toContain("Owner");
+    expect(html).toContain("Active");
+    expect(html).toContain("Alan Turing");
+    expect(html).toContain("Invited");
+  });
+
+  it("renders the invite form alongside the list", () => {
+    const html = render(TeamPage({ user, members: memberListState(store) }));
+    expect(html).toContain(`id="${teamIds.inviteForm.id}"`);
+    expect(html).toContain(`id="${teamIds.memberList.id}"`);
+  });
+});
+
+describe("MemberList", () => {
+  it("colours the status badge by status", () => {
+    const html = render(MemberList({ state: memberListState(store) }));
+    expect(html).toContain("bg-success/10");
+    expect(html).toContain("bg-warning/10");
+  });
+
+  it("keys each row by member id so the morph matches rows across searches", () => {
+    const html = render(MemberList({ state: memberListState(store) }));
+    for (const member of store.list()) expect(html).toContain(`id="${member.id}"`);
+  });
+
+  it("wires the search box to the member-list fragment and echoes the query", () => {
+    const html = render(MemberList({ state: memberListState(store, "ada") }));
+    expect(html).toContain('name="q"');
+    expect(html).toContain('value="ada"');
+    expect(html).toContain('hx-get="/team/members"');
+    expect(html).toContain(`hx-target="${teamIds.memberList.selector}"`);
+    expect(html).not.toContain("Alan Turing");
+  });
+
+  it("says when a search matches nothing and names the query", () => {
+    const html = render(MemberList({ state: memberListState(store, "zed") }));
+    expect(html).toContain("No members match “zed”.");
+    expect(html).toContain('value="zed"');
+  });
+
+  it("prompts an invite when the team has no members, focusing the invite form", () => {
+    const html = render(MemberList({ state: memberListState(createTeamStore()) }));
+    expect(html).toContain("Your team has no members yet.");
+    expect(html).toContain("Invite a member");
+    expect(html).toContain(teamIds.inviteName.id);
+    expect(html).not.toContain('name="q"');
+  });
+});
+
+describe("InviteForm", () => {
+  it("gives the name control the id the empty state focuses", () => {
+    expect(render(InviteForm())).toMatch(new RegExp(`<input[^>]*id="${teamIds.inviteName.id}"`));
+  });
+
+  it("starts a blank form on the member role", () => {
+    expect(render(InviteForm())).toMatch(/<option[^>]*value="member"[^>]*selected/);
+  });
+
+  it("routes a 422 to its own region", () => {
+    const html = render(InviteForm());
+    expect(html).toContain('hx-post="/team/members"');
+    expect(html).toContain(teamIds.inviteForm.selector);
+  });
+
+  it("shows each error beside its field and keeps what was typed", () => {
+    const html = render(InviteForm({
+      values: { name: "", email: "ada@example.com", role: "admin" },
+      errors: { name: "Name is required.", email: "This email is already on the team." },
+    }));
+    expect(html).toContain("Name is required.");
+    expect(html).toContain("This email is already on the team.");
+    expect(html).toContain('value="ada@example.com"');
+    expect(html).toMatch(/<option[^>]*value="admin"[^>]*selected/);
+    expect(html).toContain('aria-invalid="true"');
+  });
+
+  it("confirms the member just invited", () => {
+    expect(render(InviteForm({ invited }))).toContain("Katherine Johnson has been invited.");
+  });
+});
