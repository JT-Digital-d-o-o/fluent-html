index 0000000..1be188e
--- /dev/null
+++ b/src/app/team/team.store.ts
@@ -0,0 +1,48 @@
+import { randomUUID } from "node:crypto";
+import type { MemberRole } from "./team.schema.js";
+
+export type MemberId = string & { readonly __brand: "MemberId" };
+export type MemberStatus = "active" | "invited";
+
+export type Member = {
+  readonly id: MemberId;
+  readonly name: string;
+  readonly email: string;
+  readonly role: MemberRole;
+  readonly status: MemberStatus;
+};
+
+export type NewMember = Omit<Member, "id">;
+
+export type TeamStore = {
+  list(): readonly Member[];
+  findByEmail(email: string): Member | undefined;
+  add(member: NewMember): Member;
+};
+
+function newMemberId(): MemberId {
+  return `member-${randomUUID()}` as MemberId;
+}
+
+/** Emails are stored normalized, so `findByEmail` expects a normalized address too. */
+export function createTeamStore(seed: readonly NewMember[] = []): TeamStore {
+  const members: Member[] = seed.map((m) => ({ ...m, id: newMemberId() }));
+  return {
+    list: () => members,
+    findByEmail: (email) => members.find((m) => m.email === email),
+    add: (member) => {
+      const created = { ...member, id: newMemberId() };
+      members.push(created);
+      return created;
+    },
+  };
+}
+
+const SEED_MEMBERS: readonly NewMember[] = [
+  { name: "Ada Lovelace", email: "ada@example.com", role: "owner", status: "active" },
+  { name: "Grace Hopper", email: "grace@example.com", role: "admin", status: "active" },
+  { name: "Alan Turing", email: "alan@example.com", role: "member", status: "invited" },
+];
+
+/** Process-local and in-memory by design: a restart resets the team to the seed. */
+export const teamStore = createTeamStore(SEED_MEMBERS);
