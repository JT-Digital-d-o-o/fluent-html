@@ -0,0 +1,67 @@
+import { Div, Form, IfThen, LabelTag, Tag, View } from "fluent-html";
+import {
+  Alert,
+  PrimaryButton,
+  inputStyle,
+  selectStyle,
+} from "../../../shared/ui/index.js";
+import { teamIds, teamRoutes } from "../team.routes.js";
+import { MEMBER_EMAIL_MAX, MEMBER_NAME_MAX, type InviteMemberReq } from "../team.schema.js";
+import type { InviteErrors } from "../team.service.js";
+import type { Member } from "../team.store.js";
+import { DEFAULT_INVITE_ROLE, ROLE_OPTIONS } from "../team.utils.js";
+
+export type InviteFormProps = {
+  values?: Partial<InviteMemberReq>;
+  errors?: InviteErrors;
+  /** The member just invited, confirmed above a fresh form. */
+  invited?: Member;
+};
+
+type InviteFieldProps = { label: LabelTag; control: Tag; error: View };
+
+function InviteField({ label, control, error }: InviteFieldProps) {
+  return Div(
+    label.text("sm").font("medium").text("text"),
+    control,
+    Div(error).text("sm").text("danger").variant("empty", { hidden: true }),
+  ).flex().flex("col").gap("1");
+}
+
+/**
+ * The invite form region: part of the team page, and on its own the 422 answer of
+ * `teamRoutes.invite`, swapped in by `{ invalid }` with the typed values and field errors.
+ */
+export function InviteForm({ values = { role: DEFAULT_INVITE_ROLE }, errors, invited }: InviteFormProps = {}) {
+  return Div(
+    IfThen(invited, (member) => Alert({ message: `${member.name} has been invited.`, type: "success" })),
+    // idPrefix "invite" gives the name control the id `teamIds.inviteName` names.
+    Form<InviteMemberReq>({ values, errors, idPrefix: "invite" }, (f) => [
+      InviteField({
+        label: f.label("name", "Name"),
+        control: f.input("name", "text")
+          .setMaxlength(MEMBER_NAME_MAX).setAutocomplete("off").toggle("required").apply(inputStyle),
+        error: f.error("name"),
+      }),
+      InviteField({
+        label: f.label("email", "Email"),
+        control: f.input("email", "email")
+          .setMaxlength(MEMBER_EMAIL_MAX).setAutocomplete("off").toggle("required").apply(inputStyle),
+        error: f.error("email"),
+      }),
+      InviteField({
+        label: f.label("role", "Role"),
+        control: f.select("role", ROLE_OPTIONS).apply(selectStyle),
+        error: f.error("role"),
+      }),
+      Div(PrimaryButton({ label: "Send invite" }).setType("submit")),
+    ])
+      // The server's messages sit beside each field; native bubbles would pre-empt them.
+      .toggle("novalidate")
+      .submit(teamRoutes.invite(), { invalid: teamIds.inviteForm })
+      .behavior("resetOnSuccess")
+      .flex()
+      .flex("col")
+      .gap("4"),
+  ).setId(teamIds.inviteForm);
+}
diff --git a/src/app/team/views/team.members.view.ts b/src/app/team/views/team.members.view.ts
new file mode 100644
index 0000000..a95bcd1
--- /dev/null
+++ b/src/app/team/views/team.members.view.ts
@@ -0,0 +1,99 @@
+import {
+  Div,
+  Form,
+  Span,
+  Table,
+  Thead,
+  Tbody,
+  Tr,
+  Match,
+  ForEachKeyed,
+  View,
+} from "fluent-html";
+import {
+  EmptyState,
+  PrimaryButton,
+  ThCell,
+  TdCell,
+  inputStyle,
+} from "../../../shared/ui/index.js";
+import { teamIds, teamRoutes } from "../team.routes.js";
+import { MEMBER_SEARCH_MAX, type MembersQueryReq } from "../team.schema.js";
+import type { MemberListState } from "../team.service.js";
+import type { Member } from "../team.store.js";
+import { ROLE_LABELS } from "../team.utils.js";
+import { StatusBadge } from "./team.components.js";
+
+// The search box sits inside the swapped region on purpose: every answer that paints the list
+// also paints the query it was filtered by, so a page re-render after an invite clears a stale
+// query instead of leaving it above an unfiltered list (project/pm/team/decisions.md).
+function SearchBox({ query }: { query: string }) {
+  return Form<MembersQueryReq>({ values: { q: query }, idPrefix: "member-search" }, (f) => [
+    f.label("q", "Search members").srOnly(),
+    f.input("q", "search")
+      .setPlaceholder("Search by name or email")
+      .setMaxlength(MEMBER_SEARCH_MAX)
+      .setAutocomplete("off")
+      .apply(inputStyle)
+      .search(teamIds.memberList, teamRoutes.members()),
+  ])
+    .setRole("search")
+    // Enter in a lone search field submits its form natively: route that through the same swap.
+    .fragment(teamIds.memberList, teamRoutes.members())
+    .m("b", "4");
+}
+
+function MemberRow({ member }: { member: Member }) {
+  return Tr(
+    TdCell({ content: Span(member.name).font("medium").text("text") }),
+    TdCell({ content: member.email }),
+    TdCell({ content: ROLE_LABELS[member.role] }),
+    TdCell({ content: StatusBadge({ status: member.status }) }),
+  );
+}
+
+function MemberTable({ members }: { members: readonly Member[] }) {
+  return Div(
+    Table(
+      Thead(
+        Tr(
+          ThCell({ text: "Name" }),
+          ThCell({ text: "Email" }),
+          ThCell({ text: "Role" }),
+          ThCell({ text: "Status" }),
+        ),
+      ).border("b").border("line"),
+      Tbody(
+        ForEachKeyed(members, (m) => m.id, (m) => MemberRow({ member: m })),
+      ).divideY().divide("line"),
+    ).w("full"),
+  ).overflow("x", "auto");
+}
+
+function NoMatches({ query }: { query: string }) {
+  return EmptyState({ message: `No members match “${query}”. Try a different name or email.` });
+}
+
+function NoMembers() {
+  return EmptyState({
+    message: "Your team has no members yet. Invite someone to get started.",
+    actionView: PrimaryButton({ label: "Invite a member" })
+      .setType("button")
+      .behavior("focus", { target: teamIds.inviteName }),
+  });
+}
+
+function Searchable({ query, content }: { query: string; content: View }) {
+  return Div(SearchBox({ query }), content);
+}
+
+/** The member list region: the live-search swap target, and the answer of `teamRoutes.members`. */
+export function MemberList({ state }: { state: MemberListState }) {
+  return Div(
+    Match(state, "kind", {
+      empty: () => NoMembers(),
+      "no-matches": (s) => Searchable({ query: s.query, content: NoMatches({ query: s.query }) }),
+      results: (s) => Searchable({ query: s.query, content: MemberTable({ members: s.members }) }),
+    }),
+  ).setId(teamIds.memberList);
+}
