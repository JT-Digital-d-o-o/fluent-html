+import { Type, type Static } from "@sinclair/typebox";
+
+export const MEMBER_ROLES = ["member", "admin", "owner"] as const;
+export type MemberRole = (typeof MEMBER_ROLES)[number];
+
+export const MEMBER_NAME_MAX = 80;
+export const MEMBER_EMAIL_MAX = 254;
+export const MEMBER_SEARCH_MAX = 100;
+
+const MembersQuery = Type.Object({
+  q: Type.Optional(Type.String({ maxLength: MEMBER_SEARCH_MAX })),
+});
+export type MembersQueryReq = Static<typeof MembersQuery>;
+export const membersQuerySchema = { querystring: MembersQuery };
+
+// Name and email stay loose here: their rules are checked in team.service.ts so a failure
+// re-renders the form with a message beside the field, instead of Ajv's generic 400 page.
+const InviteMemberBody = Type.Object({
+  name: Type.String({ maxLength: MEMBER_NAME_MAX }),
+  email: Type.String({ maxLength: MEMBER_EMAIL_MAX }),
+  role: Type.Union(MEMBER_ROLES.map((role) => Type.Literal(role))),
+});
+export type InviteMemberReq = Static<typeof InviteMemberBody>;
+export const inviteMemberSchema = { body: InviteMemberBody };
