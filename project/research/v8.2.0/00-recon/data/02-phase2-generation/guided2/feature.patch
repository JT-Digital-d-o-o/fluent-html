@@ -0,0 +1,57 @@
+import type { FastifyReply, FastifyRequest } from "fastify";
+import { defineController, fragment, guarded, page } from "../../core/render/define-controller.js";
+import { isHtmxRequest } from "../../core/htmx/htmx-request.js";
+import type { AuthUser } from "../../core/server/types.js";
+import { requireAuth } from "../auth/shared/guards.js";
+import { teamRoutes } from "./team.routes.js";
+import { inviteMemberSchema, membersQuerySchema } from "./team.schema.js";
+import { inviteMember, memberListState } from "./team.service.js";
+import { teamStore } from "./team.store.js";
+import { TeamPage } from "./views/team.page.view.js";
+import { MemberList } from "./views/team.members.view.js";
+import { InviteForm, type InviteFormProps } from "./views/team.invite.view.js";
+
+// A rejected invite answers with the form region alone: the submit carries
+// `{ invalid: teamIds.inviteForm }`, so htmx routes the 422 there and the list stays put.
+// A non-htmx post has no swap target and gets the whole page. `renderView` because neither
+// claim is true of both branches (same shape as the template's sign-in).
+function renderInviteRejected(
+  request: FastifyRequest,
+  reply: FastifyReply,
+  user: AuthUser,
+  invite: InviteFormProps,
+): FastifyReply {
+  reply.code(422).renderView(
+    isHtmxRequest(request)
+      ? InviteForm(invite)
+      : TeamPage({ user, members: memberListState(teamStore), invite }),
+  );
+  return reply;
+}
+
+export default defineController(teamRoutes, {
+  page: page(
+    ({ user }) => TeamPage({ user, members: memberListState(teamStore) }),
+    { guards: [requireAuth] },
+  ),
+
+  members: fragment(
+    ({ query }) => MemberList({ state: memberListState(teamStore, query.q) }),
+    { guards: [requireAuth], schema: membersQuerySchema },
+  ),
+
+  invite: guarded(
+    { guards: [requireAuth], schema: inviteMemberSchema },
+    async (request, reply) => {
+      const result = inviteMember(teamStore, request.body);
+      if (!result.ok) {
+        return renderInviteRejected(request, reply, request.user, { values: request.body, errors: result.error });
+      }
+      return reply.renderPage(TeamPage({
+        user: request.user,
+        members: memberListState(teamStore),
+        invite: { invited: result.value },
+      }));
+    },
+  ),
+});
