@@ -0,0 +1,50 @@
+import type { ErrorBag } from "fluent-html";
+import { normalizeEmail } from "../../shared/formatters.js";
+import { fail, ok, type Result } from "../../shared/result.js";
+import type { InviteMemberReq } from "./team.schema.js";
+import type { Member, TeamStore } from "./team.store.js";
+
+export type InviteErrors = ErrorBag<InviteMemberReq>;
+
+export type MemberListState =
+  | { readonly kind: "empty" }
+  | { readonly kind: "no-matches"; readonly query: string }
+  | { readonly kind: "results"; readonly query: string; readonly members: readonly Member[] };
+
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function matchesQuery(member: Member, needle: string): boolean {
+  return member.name.toLowerCase().includes(needle) || member.email.includes(needle);
+}
+
+/** The member list as the view shows it: the whole team, or the members matching `query` by name or email. */
+export function memberListState(store: TeamStore, query = ""): MemberListState {
+  const members = store.list();
+  if (members.length === 0) return { kind: "empty" };
+
+  const trimmed = query.trim();
+  const matches = members.filter((m) => matchesQuery(m, trimmed.toLowerCase()));
+  if (matches.length === 0) return { kind: "no-matches", query: trimmed };
+  return { kind: "results", query: trimmed, members: matches };
+}
+
+function nameError(name: string): string | undefined {
+  return name === "" ? "Name is required." : undefined;
+}
+
+function emailError(store: TeamStore, email: string): string | undefined {
+  if (email === "") return "Email is required.";
+  if (!EMAIL_PATTERN.test(email)) return "Enter a valid email address.";
+  if (store.findByEmail(email)) return "This email is already on the team.";
+  return undefined;
+}
+
+/** Validate the invite and, when every field passes, add the member with status "invited". */
+export function inviteMember(store: TeamStore, body: InviteMemberReq): Result<Member, InviteErrors> {
+  const name = body.name.trim();
+  const email = normalizeEmail(body.email);
+  const errors: InviteErrors = { name: nameError(name), email: emailError(store, email) };
+  if (errors.name || errors.email) return fail(errors);
+
+  return ok(store.add({ name, email, role: body.role, status: "invited" }));
+}
diff --git a/src/app/team/team.store.ts b/src/app/team/team.store.ts
