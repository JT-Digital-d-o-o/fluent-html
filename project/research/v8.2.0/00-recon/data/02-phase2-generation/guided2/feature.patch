+import { Div, H1, P } from "fluent-html";
+import { Layout } from "../../../core/layout/layout.view.js";
+import type { AuthUser } from "../../../core/server/types.js";
+import type { MemberListState } from "../team.service.js";
+import { TeamCard } from "./team.components.js";
+import { InviteForm, type InviteFormProps } from "./team.invite.view.js";
+import { MemberList } from "./team.members.view.js";
+
+type TeamPageProps = {
+  user: AuthUser;
+  members: MemberListState;
+  invite?: InviteFormProps;
+};
+
+function TeamHeader() {
+  return Div(
+    H1("Team").text("2xl").font("bold").text("text"),
+    P("See who is on your team and invite new members.").text("sm").text("text-dim").m("t", "1"),
+  ).m("b", "8");
+}
+
+export function TeamPage({ user, members, invite }: TeamPageProps) {
+  return Layout({
+    title: "Team",
+    user,
+    width: "7xl",
+    children: Div(
+      TeamHeader(),
+      Div(
+        TeamCard({ title: "Members", content: MemberList({ state: members }) })
+          .lg({ colSpan: "2" }),
+        TeamCard({
+          title: "Invite member",
+          description: "New members appear in the list as Invited.",
+          content: InviteForm(invite),
+        }),
+      ).grid().gap("6").items("start").lg({ gridCols: "3" }),
+    ),
+  });
+}
