diff --git a/test/htmx-js-sinks.test.ts b/test/htmx-js-sinks.test.ts
new file mode 100644
index 0000000..b2491fb
--- /dev/null
+++ b/test/htmx-js-sinks.test.ts
@@ -0,0 +1,62 @@
+import { describe, it, afterEach } from "node:test";
+import assert from "node:assert/strict";
+
+import { render, Button, A, hxResponse, Empty, sanitizeUrl, setDevChecks, defineRoutes } from "../src/index.js";
+import { hx, assetUrl, externalUrl } from "../src/htmx.js";
+
+const itemRoutes = defineRoutes("/items", {
+  remove: { method: "delete", path: "/:id", params: { id: "number" } },
+} as const);
+
+afterEach(() => setDevChecks(true));
+
+describe("htmx-evaluated sinks (C-18)", () => {
+  it("sanitizeUrl blocks htmx's js: scheme like javascript:", () => {
+    assert.equal(sanitizeUrl("js:alert(1)"), "about:blank");
+    assert.equal(sanitizeUrl(" JS:alert(1)"), "about:blank");
+    assert.equal(sanitizeUrl("jsx:alert(1)"), "jsx:alert(1)");
+    assert.equal(render(A("x").setHref(externalUrl("js:alert(1)"))), `<a href="about:blank">x</a>`);
+  });
+
+  it("the request endpoint is scheme-sanitized", () => {
+    assert.equal(render(Button().setHtmx(hx(externalUrl("javascript:alert(1)")))), `<button hx-get="about:blank"></button>`);
+    assert.equal(render(Button().setHtmx(hx(assetUrl("js:alert(1)"), { method: "post" }))), `<button hx-post="about:blank"></button>`);
+    assert.equal(render(Button().setHtmx(hx(assetUrl("data:text/html,<p>x</p>")))), `<button hx-get="about:blank"></button>`);
+    assert.equal(render(Button().setHtmx(hx(assetUrl("/items?a=b:c")))), `<button hx-get="/items?a=b:c"></button>`);
+  });
+
+  it("push/replace URL strings are scheme-sanitized; booleans pass", () => {
+    const b = Button().setHtmx(hx(assetUrl("/x"), { pushUrl: "javascript:x", replaceUrl: "/ok", status: { 422: { push: "js:x" } } }));
+    assert.equal(render(b), `<button hx-get="/x" hx-push-url="about:blank" hx-replace-url="/ok" hx-status:422="push:about:blank"></button>`);
+    assert.ok(render(Button().setHtmx(hx(assetUrl("/x"), { pushUrl: true }))).includes(`hx-push-url="true"`));
+  });
+
+  it("dev mode throws on a js:/javascript: confirm or string vals, naming the fix", () => {
+    assert.throws(() => Button().setHtmx(itemRoutes.remove({ id: 1 }, { confirm: "js:ok()" })),
+      { message: `<button>.setHtmx() got hx-confirm starting with "js:", which htmx 4 runs as JavaScript, and fluent-html emits no inline JS. Pass the message text.` });
+    assert.throws(() => Button().setHtmx(hx(assetUrl("/x"), { method: "post", vals: "javascript:{a: 1}" })), /hx-vals starting with "javascript:".*Pass an object/);
+    assert.doesNotThrow(() => Button().setHtmx(hx(assetUrl("/x"), { confirm: "Delete it?", vals: JSON.stringify({ a: 1 }) })));
+    assert.doesNotThrow(() => Button().setHtmx(hx(assetUrl("/x"), { confirm: "JS: delete?" })));
+  });
+
+  it("production rendering makes the same values text with a leading U+200B reference", () => {
+    setDevChecks(false);
+    assert.equal(render(Button().setHtmx(hx(assetUrl("/x"), { confirm: "js:ok()" }))), `<button hx-get="/x" hx-confirm="&#8203;js:ok()"></button>`);
+    assert.equal(render(Button().setHtmx(hx(assetUrl("/x"), { method: "post", vals: "js:{a: 1}" }))), `<button hx-post="/x" hx-vals="&#8203;js:{a: 1}"></button>`);
+    assert.equal(render(Button().setHtmx(hx(assetUrl("/x"), { confirm: "Delete it?" }))), `<button hx-get="/x" hx-confirm="Delete it?"></button>`);
+  });
+
+  it("HxResponse URL headers are scheme-sanitized", () => {
+    const h = hxResponse(Empty()).redirect("javascript:alert(1)").pushUrl("js:x").replaceUrl("vbscript:x").getHeaders();
+    assert.deepEqual(h, { "HX-Redirect": "about:blank", "HX-Push-Url": "about:blank", "HX-Replace-Url": "about:blank" });
+    assert.deepEqual(hxResponse(Empty()).redirect("/login").pushUrl("false").getHeaders(), { "HX-Redirect": "/login", "HX-Push-Url": "false" });
+  });
+
+  it("HX-Location is always the object form, so a string is only ever a path", () => {
+    assert.equal(hxResponse(Empty()).location("/dashboard").getHeaders()["HX-Location"], `{"path":"/dashboard"}`);
+    assert.equal(hxResponse(Empty()).location("js:alert(1)").getHeaders()["HX-Location"], `{"path":"about:blank"}`);
+    assert.equal(hxResponse(Empty()).location("x path:js:alert(1)").getHeaders()["HX-Location"], `{"path":"x path:js:alert(1)"}`);
+    assert.equal(hxResponse(Empty()).location({ path: "js:alert(1)", target: "#main" }).getHeaders()["HX-Location"], `{"path":"about:blank","target":"#main"}`);
+    assert.equal(hxResponse(Empty()).location({ path: "/d", target: "#main" }).getHeaders()["HX-Location"], `{"path":"/d","target":"#main"}`);
+  });
+});
