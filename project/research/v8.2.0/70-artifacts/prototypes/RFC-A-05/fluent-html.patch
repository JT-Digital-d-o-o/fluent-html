+const HTMX_SCRIPT_FIX = {
+  confirm: "Pass the message text.",
+  vals: "Pass an object (vals: { key: value }), or widen include to send a field's live value.",
+} as const;
+
+/**
+ * Throw when an htmx bag carries a `confirm` or string `vals` that htmx 4 would run as
+ * JavaScript. Production rendering neutralizes the same values instead (serialize.ts).
+ *
+ * @internal
+ */
+export function assertNoHtmxScript(
+  tag: { el: string },
+  htmx: { confirm?: unknown; vals?: unknown },
+  method: string,
+): void {
+  for (const key of ["confirm", "vals"] as const) {
+    const value = htmx[key];
+    const prefix = typeof value === "string" ? htmxScriptPrefix(value) : null;
+    if (prefix === null) continue;
+    throw new Error(
+      `<${tag.el}>.${method}() got hx-${key} starting with "${prefix}", which htmx 4 runs as ` +
+        `JavaScript, and fluent-html emits no inline JS. ${HTMX_SCRIPT_FIX[key]}`,
+    );
+  }
+}
