 /**
+ * `sanitizeUrl` for a URL htmx will fetch or navigate to. htmx parses every response body as
+ * HTML (no content-type gate), so the media `data:` allowlist that is safe in `src` is not
+ * safe here: every `data:` URL is blocked.
+ * @internal
+ */
+export function sanitizeHtmxUrl(url: string): string {
+  const safe = sanitizeUrl(url);
+  if (safe !== url) return safe;
+  const colon = url.indexOf(":");
+  if (colon === -1) return url;
+  return url.slice(0, colon + 1).replace(URL_SCHEME_NOISE_RE, "").toLowerCase() === "data:" ? BLOCKED_URL : url;
+}
