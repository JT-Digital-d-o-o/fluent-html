diff --git a/templates/shared/eslint-rules/no-htmx-without-runtime.mjs b/templates/shared/eslint-rules/no-htmx-without-runtime.mjs
new file mode 100644
index 0000000..8f33fde
--- /dev/null
+++ b/templates/shared/eslint-rules/no-htmx-without-runtime.mjs
@@ -0,0 +1,47 @@
+import { existsSync } from "node:fs";
+
+const EMITTERS = new Set(["setHtmx", "hxGet", "hxPost"]);
+const IMPORTS = new Set(["hx", "Partial", "HtmxConfig", "hxResponse"]);
+
+/** True when the project beside `configUrl` vendors the htmx bundle its layout loads. */
+export function servesHtmx(configUrl) {
+  return existsSync(new URL("./public/js/htmx.min.js", configUrl));
+}
+
+function literalName(node) {
+  if (node?.type === "Literal" && typeof node.value === "string") return node.value;
+  if (node?.type === "TemplateLiteral" && node.expressions.length === 0) return node.quasis[0].value.cooked;
+  return null;
+}
+
+export default {
+  meta: {
+    type: "problem",
+    docs: { description: "A project that serves no htmx runtime emits no hx-* attributes" },
+    schema: [],
+    messages: {
+      noHtmx:
+        "This site serves no htmx runtime, so hx-* attributes are inert (a form without action/method submits as GET). " +
+        'Use Form().setAction(route.resolve()).setMethod("post") or A().setHref(route.resolve(params)).',
+    },
+  },
+  create(context) {
+    return {
+      CallExpression(node) {
+        const callee = node.callee;
+        if (callee.type !== "MemberExpression" || callee.computed || callee.property.type !== "Identifier") return;
+        const name = callee.property.name;
+        if (EMITTERS.has(name)) context.report({ node: callee.property, messageId: "noHtmx" });
+        else if (name === "addAttribute" && /^hx-/i.test(literalName(node.arguments[0]) ?? "")) {
+          context.report({ node: node.arguments[0], messageId: "noHtmx" });
+        }
+      },
+      ImportDeclaration(node) {
+        if (node.source.value !== "fluent-html") return;
+        for (const s of node.specifiers) {
+          if (s.type === "ImportSpecifier" && IMPORTS.has(s.imported.name)) context.report({ node: s, messageId: "noHtmx" });
+        }
+      },
+    };
+  },
+};
