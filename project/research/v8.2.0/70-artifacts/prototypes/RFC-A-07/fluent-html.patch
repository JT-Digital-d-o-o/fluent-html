+/**
+ * `Form()` dispatches on its arguments: `(build)`, `(state, build)` or plain children. Any other mix that
+ * contains a builder renders only the first builder (or nothing) and drops the rest. Dev-only.
+ *
+ * @internal
+ */
+export function assertFormArgs(args: readonly unknown[]): void {
+  if (!args.some((a) => typeof a === "function")) return;
+  if (args.length === 1) return;
+  const s = args[0];
+  const isState = s === undefined || s === null || (typeof s === "object" && !Array.isArray(s) && (s as { _t?: number })._t !== 1);
+  if (args.length === 2 && isState && typeof args[1] === "function") return;
+  const shape = args.map((a) => (typeof a === "function" ? "builder" : a === undefined || (typeof a === "object" && a !== null && !Array.isArray(a) && (a as { _t?: number })._t !== 1) ? "state" : "child")).join(", ");
+  throw new Error(
+    `Form(${shape}) drops arguments: it takes one builder that returns every control, ` +
+      `Form<T>((f) => [f.input("email"), f.input("password")]), or Form<T>(state, (f) => [ … ]) to prefill.`,
+  );
+}
