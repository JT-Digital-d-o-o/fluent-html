+++ b/test/form-for.test.ts
@@ -1,7 +1,7 @@
 import { describe, it } from "node:test";
 import assert from "node:assert/strict";
 
-import { render, Form, Button } from "../src/index.js";
+import { render, Form, Button, ForEach, type FormBinding } from "../src/index.js";
 
 type CreateUserReq = { email: string; name: string; bio: string; role: "admin" | "viewer" };
 
@@ -181,3 +181,58 @@ describe("Form<T> aria-invalid wiring (F-C-143)", () => {
     assert.strictEqual(html, `<form><input id="terms" type="checkbox" name="terms" aria-invalid="true" aria-describedby="terms-error"></form>`);
   });
 });
+
+type TagsReq = { tags: string[]; terms: boolean };
+const group = (f: FormBinding<TagsReq>) => ForEach(["a", "b", "c"], (o) => f.checkbox("tags", o));
+
+describe("Form<T> checkbox groups (C-16)", () => {
+  it("a group binds by membership and gives each box the radio-style id", () => {
+    const html = render(Form<TagsReq>({ values: { tags: ["a", "c"] } }, (f) => group(f)));
+    assert.strictEqual(html, `<form><input id="tags-a" type="checkbox" name="tags" value="a" checked>\n<input id="tags-b" type="checkbox" name="tags" value="b">\n<input id="tags-c" type="checkbox" name="tags" value="c" checked></form>`);
+  });
+
+  it("an empty array checks no box", () => {
+    assert.ok(!render(Form<TagsReq>({ values: { tags: [] } }, (f) => group(f))).includes("checked"));
+  });
+
+  it("a single urlencoded value (422 re-render) checks only its box", () => {
+    const html = render(Form<TagsReq>({ values: { tags: "b" as unknown as string[] } }, (f) => group(f)));
+    assert.strictEqual(html.match(/checked/g)?.length, 1);
+    assert.ok(html.includes(`value="b" checked`));
+  });
+
+  it("idPrefix namespaces group ids", () => {
+    assert.ok(render(Form<TagsReq>({ idPrefix: "edit" }, (f) => group(f))).includes(`id="edit-tags-a"`));
+  });
+
+  it("a caller's setId on the first box is kept", () => {
+    const html = render(Form<TagsReq>((f) => [f.checkbox("tags", "a").setId("mine"), f.checkbox("tags", "b")]));
+    assert.ok(html.includes(`id="mine"`) && html.includes(`id="tags-b"`));
+  });
+
+  it("a lone valued checkbox keeps id={name} and boolean binding", () => {
+    assert.strictEqual(render(Form<TagsReq>({ values: { terms: true } }, (f) => f.checkbox("terms", "yes"))), `<form><input id="terms" type="checkbox" name="terms" value="yes" checked></form>`);
+  });
+});
+
+describe("Form() argument shapes (C-16)", () => {
+  it("throws on two builders, naming the one-builder form", () => {
+    assert.throws(
+      () => (Form as (...a: unknown[]) => unknown)((f: FormBinding<CreateUserReq>) => f.input("email"), (f: FormBinding<CreateUserReq>) => f.input("name")),
+      /^Error: Form\(builder, builder\) drops arguments: it takes one builder that returns every control/,
+    );
+  });
+
+  it("throws on state + two builders and on builder + child", () => {
+    assert.throws(() => (Form as (...a: unknown[]) => unknown)({}, () => "a", () => "b"), /Form\(state, builder, builder\)/);
+    assert.throws(() => (Form as (...a: unknown[]) => unknown)(() => "a", Button("Go")), /Form\(builder, child\)/);
+  });
+
+  it("valid shapes do not throw", () => {
+    render(Form<TagsReq>((f) => f.checkbox("terms")));
+    render(Form<TagsReq>(undefined, (f) => f.checkbox("terms")));
+    render(Form<TagsReq>({}, (f) => f.checkbox("terms")));
+    render(Form(Button("Go"), Button("Stop")));
+    render(Form());
+  });
+});
