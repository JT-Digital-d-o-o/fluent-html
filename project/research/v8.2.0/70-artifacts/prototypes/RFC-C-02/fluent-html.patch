diff --git a/scripts/codemod/prune-9.ts b/scripts/codemod/prune-9.ts
new file mode 100644
index 0000000..3b2d846
--- /dev/null
+++ b/scripts/codemod/prune-9.ts
@@ -0,0 +1,223 @@
+/**
+ * `npm run codemod:prune-9 -- <tsconfig> [--dry]` — move a consumer repo off the names 9.0.0
+ * removes, onto the spelling each one already duplicated:
+ *
+ *   `.multipart()`                      → `.setEnctype("multipart/form-data")`
+ *   `.containerQuery()` / `("name")`    → `.cssProp("container-type", "inline-size")` (+ `container-name`)
+ *   `.setMicrodata({ type, prop, ref, id })` → `.toggle("itemscope").addAttribute("itemtype", …)…`
+ *   `Repeat(n, f)`                      → `ForEach(n, f)`
+ *   root imports of `setDevChecks`, `extractId`, `extractSelector`, `EVENT_TABLE`, `HTMX_EVENTS`
+ *                                       → the same names from their subpath
+ *
+ * A method call is rewritten only when its receiver types as fluent-html's `Tag`; anything the
+ * map cannot express (non-literal containerQuery name, non-literal setMicrodata object, a call
+ * under `@ts-expect-error`) is left untouched and reported.
+ *
+ * @module
+ */
+import { existsSync, readFileSync } from "node:fs";
+import * as path from "node:path";
+import { pathToFileURL } from "node:url";
+
+import { Node, Project, type CallExpression, type Expression, type SourceFile, type Type } from "ts-morph";
+
+/** Root exports 9.0.0 keeps only on their subpath. */
+export const MOVED_TO_SUBPATH: Readonly<Record<string, string>> = {
+  setDevChecks: "core",
+  extractId: "ids",
+  extractSelector: "ids",
+  EVENT_TABLE: "behaviors",
+  HTMX_EVENTS: "behaviors",
+};
+
+/** Every name 9.0.0 removes, with the successor the deletion gate expects (`test/prune-gate.test.ts`). */
+export const PRUNED_9: Readonly<Record<string, string>> = {
+  multipart: '.setEnctype("multipart/form-data")',
+  containerQuery: '.cssProp("container-type", "inline-size")',
+  setMicrodata: '.toggle("itemscope").addAttribute("itemtype", …)',
+  Repeat: "ForEach(n, render)",
+  ...Object.fromEntries(Object.entries(MOVED_TO_SUBPATH).map(([n, sub]) => [n, `import { ${n} } from "fluent-html/${sub}"`])),
+};
+
+const METHODS = new Set(["multipart", "containerQuery", "setMicrodata"]);
+
+export type Edit = { readonly start: number; readonly end: number; readonly text: string };
+export type Skip = { readonly line: number; readonly name: string; readonly reason: string };
+
+function typeIsTag(type: Type, seen = new Set<Type>()): boolean {
+  if (seen.has(type)) return false;
+  seen.add(type);
+  const apparent = type.getApparentType();
+  const parts = (apparent.isUnion() ? apparent.getUnionTypes() : apparent.isIntersection() ? apparent.getIntersectionTypes() : [apparent]).map((p) => p.getApparentType());
+  for (const part of parts) {
+    const symbol = part.getSymbol();
+    if (symbol?.getName() === "Tag") {
+      const declFile = symbol.getDeclarations()[0]?.getSourceFile().getBaseName();
+      if (declFile === "tag.ts" || declFile === "tag.d.ts") return true;
+    }
+    // A `this & Rooted<N>` part (setId's 8.1.0 return) loses its base types; fall back to the declared class.
+    const bases = part.getBaseTypes();
+    for (const base of bases.length ? bases : symbol ? [symbol.getDeclaredType()] : []) if (typeIsTag(base, seen)) return true;
+  }
+  return false;
+}
+
+function receiverIsTag(expr: Expression): boolean {
+  if (typeIsTag(expr.getType())) return true;
+  if (Node.isCallExpression(expr)) {
+    const callee = expr.getExpression();
+    if (Node.isPropertyAccessExpression(callee) && METHODS.has(callee.getName())) return receiverIsTag(callee.getExpression());
+  }
+  return false;
+}
+
+const underExpectError = (node: Node): boolean => {
+  const stmt = node.getFirstAncestor((a) => Node.isStatement(a)) ?? node;
+  return stmt.getLeadingCommentRanges().some((c) => c.getText().includes("@ts-expect-error"));
+};
+
+function methodRewrite(name: string, call: CallExpression): { text?: string; skip?: string } {
+  const args = call.getArguments();
+  if (name === "multipart") return args.length === 0 ? { text: 'setEnctype("multipart/form-data")' } : { skip: "multipart() takes no arguments" };
+  if (name === "containerQuery") {
+    if (args.length === 0) return { text: 'cssProp("container-type", "inline-size")' };
+    const [n] = args;
+    if (args.length === 1 && Node.isStringLiteral(n) && /^[\w-]+$/.test(n.getLiteralValue())) {
+      return { text: `cssProp("container-type", "inline-size").cssProp("container-name", "${n.getLiteralValue()}")` };
+    }
+    return { skip: "containerQuery name is not a string literal; .cssProp() takes literals only" };
+  }
+  // setMicrodata
+  const [o] = args;
+  if (args.length !== 1 || !Node.isObjectLiteralExpression(o)) return { skip: "setMicrodata argument is not an object literal" };
+  if (o.getProperties().some((p) => !Node.isPropertyAssignment(p))) return { skip: "setMicrodata object has spread/shorthand members" };
+  const get = (k: string): string | undefined => {
+    const p = o.getProperty(k);
+    return p && Node.isPropertyAssignment(p) ? p.getInitializerOrThrow().getText() : undefined;
+  };
+  const parts: string[] = [];
+  const t = get("type"), pr = get("prop"), r = get("ref"), i = get("id");
+  if (t !== undefined) parts.push('toggle("itemscope")', `addAttribute("itemtype", ${t})`);
+  if (pr !== undefined) parts.push(`addAttribute("itemprop", ${pr})`);
+  if (r !== undefined) parts.push(`addAttribute("itemref", ${r})`);
+  if (i !== undefined) parts.push(`addAttribute("itemid", ${i})`);
+  return parts.length ? { text: parts.join(".") } : { skip: "setMicrodata({}) writes nothing; delete the call" };
+}
+
+/** Module specifiers that resolve to fluent-html in this repo: the package name plus npm aliases (`lambda.html`). */
+export function libSpecifiers(repoRoot: string): Set<string> {
+  const out = new Set(["fluent-html"]);
+  const pj = path.join(repoRoot, "package.json");
+  if (!existsSync(pj)) return out;
+  const json = JSON.parse(readFileSync(pj, "utf8")) as Record<string, Record<string, string> | undefined>;
+  for (const deps of [json.dependencies, json.devDependencies, json.peerDependencies]) {
+    for (const [k, v] of Object.entries(deps ?? {})) if (/(^|[/:])fluent-html(#|@|$)/.test(v)) out.add(k);
+  }
+  return out;
+}
+
+export function collectEdits(file: SourceFile, specs: ReadonlySet<string>): { edits: Edit[]; skips: Skip[] } {
+  const edits: Edit[] = [];
+  const skips: Skip[] = [];
+  let repeatLocal: string | undefined;
+  for (const imp of file.getImportDeclarations()) {
+    const spec = imp.getModuleSpecifierValue();
+    if (!specs.has(spec)) continue;
+    const moved = new Map<string, string[]>();
+    const keep: string[] = [];
+    let changed = false;
+    let hasForEach = false;
+    for (const ni of imp.getNamedImports()) {
+      const name = ni.getName();
+      const alias = ni.getAliasNode()?.getText();
+      if (name === "ForEach") hasForEach = true;
+      if (name === "Repeat") {
+        changed = true;
+        if (alias) keep.push(`ForEach as ${alias}`);
+        else repeatLocal = "Repeat";
+        continue;
+      }
+      const sub = MOVED_TO_SUBPATH[name];
+      if (sub) {
+        changed = true;
+        const list = moved.get(sub) ?? [];
+        list.push(ni.getText());
+        moved.set(sub, list);
+        continue;
+      }
+      keep.push(ni.getText());
+    }
+    if (repeatLocal === "Repeat" && !hasForEach) keep.push("ForEach");
+    if (!changed) continue;
+    const typeOnly = imp.isTypeOnly() ? "type " : "";
+    const def = imp.getDefaultImport()?.getText();
+    const lines: string[] = [];
+    if (keep.length || def) lines.push(`import ${typeOnly}${def ?? ""}${def && keep.length ? ", " : ""}${keep.length ? `{ ${keep.join(", ")} }` : ""} from "${spec}";`);
+    for (const [sub, names] of moved) lines.push(`import ${typeOnly}{ ${names.join(", ")} } from "${spec}/${sub}";`);
+    edits.push({ start: imp.getStart(), end: imp.getEnd(), text: lines.join("\n") });
+  }
+  file.forEachDescendant((node) => {
+    if (!Node.isCallExpression(node)) return;
+    const callee = node.getExpression();
+    if (repeatLocal === "Repeat" && Node.isIdentifier(callee) && callee.getText() === "Repeat") {
+      edits.push({ start: callee.getStart(), end: callee.getEnd(), text: "ForEach" });
+      return;
+    }
+    if (!Node.isPropertyAccessExpression(callee)) return;
+    const name = callee.getName();
+    if (!METHODS.has(name)) return;
+    const line = callee.getNameNode().getStartLineNumber();
+    if (underExpectError(node)) { skips.push({ line, name, reason: "under @ts-expect-error" }); return; }
+    if (!receiverIsTag(callee.getExpression())) { skips.push({ line, name, reason: "receiver does not type as Tag" }); return; }
+    const { text, skip } = methodRewrite(name, node);
+    if (text === undefined) skips.push({ line, name, reason: skip ?? "unsupported" });
+    else edits.push({ start: callee.getNameNode().getStart(), end: node.getEnd(), text });
+  });
+  // `containerQuery` as a style-object key inside a Tag call: report (the successor is the `cssProp` key).
+  file.forEachDescendant((node) => {
+    if (!Node.isPropertyAssignment(node) || node.getName() !== "containerQuery") return;
+    const inTagCall = node.getAncestors().some((a) => {
+      if (!Node.isCallExpression(a)) return false;
+      const c = a.getExpression();
+      return Node.isPropertyAccessExpression(c) && receiverIsTag(c.getExpression());
+    });
+    if (inTagCall) skips.push({ line: node.getStartLineNumber(), name: "containerQuery", reason: 'style-object key removed; use cssProp: ["container-type", "inline-size"]' });
+  });
+  return { edits, skips };
+}
+
+/** Splice all edits into the file text once (descending start), then reparse — no per-edit tree surgery. */
+export function applyEdits(file: SourceFile, edits: readonly Edit[]): void {
+  let text = file.getFullText();
+  for (const e of [...edits].sort((a, b) => b.start - a.start)) text = text.slice(0, e.start) + e.text + text.slice(e.end);
+  file.replaceWithText(text);
+}
+
+function run(): void {
+  const argv = process.argv.slice(2);
+  const dry = argv.includes("--dry");
+  const tsConfigFilePath = argv.find((a) => !a.startsWith("--"));
+  if (!tsConfigFilePath) {
+    console.error("Usage: npm run codemod:prune-9 -- <path/to/tsconfig.json> [--dry]");
+    process.exitCode = 1;
+    return;
+  }
+  const specs = libSpecifiers(path.dirname(path.resolve(tsConfigFilePath)));
+  const project = new Project({ tsConfigFilePath });
+  const files = project.getSourceFiles().filter((f) => !f.isDeclarationFile() && !f.getFilePath().includes("/node_modules/"));
+  let totalEdits = 0;
+  let totalSkips = 0;
+  const collected = files.map((file) => ({ file, ...collectEdits(file, specs) }));
+  for (const { file, edits, skips } of collected) {
+    for (const s of skips) console.warn(`SKIP ${file.getFilePath()}:${s.line} ${s.name} — ${s.reason}`);
+    totalSkips += skips.length;
+    if (edits.length === 0) continue;
+    applyEdits(file, edits);
+    totalEdits += edits.length;
+    console.log(`${dry ? "[dry] " : ""}${file.getFilePath()} — ${edits.length} edit(s)`);
+  }
+  if (!dry) project.saveSync();
+  console.log(`codemod:prune-9 ${dry ? "(dry run) " : ""}— ${totalEdits} edit(s) across ${files.length} file(s) [specifiers: ${[...specs].join(", ")}]; ${totalSkips} skipped for manual review.`);
+}
+
+if (process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href) run();
