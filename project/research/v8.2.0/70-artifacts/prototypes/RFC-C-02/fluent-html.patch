new file mode 100644
index 0000000..d481ef6
--- /dev/null
+++ b/test/prune-gate.test.ts
@@ -0,0 +1,63 @@
+/**
+ * Deletion gate for surface prunes. A name may leave the package only when
+ * (1) its removal draws a plain "does not exist" (TS2339 / TS2305), never a
+ *     "Did you mean" that points at a different live member, and
+ * (2) no recorded pure-prior guess uses it: every guess in prior.ts keeps
+ *     compiling and every one-hop heal in heals.ts keeps naming its member.
+ * A census at zero is not enough: the names agents guess for a job are the
+ * ones the census never sees until the job comes up.
+ */
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+
+import ts from "typescript";
+
+import { PRUNED_9 } from "../scripts/codemod/prune-9.js";
+
+type Diag = { readonly code: number; readonly message: string; readonly line: number };
+
+function diagnose(file: string): Diag[] {
+  const fixture = resolve(process.cwd(), "test/types/prune-gate", file);
+  const program = ts.createProgram([fixture], {
+    target: ts.ScriptTarget.ES2020,
+    module: ts.ModuleKind.ES2020,
+    moduleResolution: ts.ModuleResolutionKind.Bundler,
+    strict: true,
+    noEmit: true,
+    skipLibCheck: true,
+  });
+  return ts.getPreEmitDiagnostics(program, program.getSourceFile(fixture)).map((d) => ({
+    code: d.code,
+    message: ts.flattenDiagnosticMessageText(d.messageText, " "),
+    line: d.file && d.start !== undefined ? d.file.getLineAndCharacterOfPosition(d.start).line + 1 : -1,
+  }));
+}
+
+describe("prune gate — removed names die plainly, recorded guesses keep working", () => {
+  it("every removed name fails as a plain missing member or export", () => {
+    const diags = diagnose("removed.ts");
+    for (const name of Object.keys(PRUNED_9)) {
+      const hit = diags.find((d) => d.message.includes(`'${name}'`));
+      assert.ok(hit, `removed.ts has no probe for ${name}`);
+      assert.ok([2339, 2305].includes(hit.code), `${name}: TS${hit.code} ${hit.message} (successor: ${PRUNED_9[name]})`);
+    }
+    assert.equal(diags.length, Object.keys(PRUNED_9).length, diags.map((d) => `TS${d.code}: ${d.message}`).join("\n"));
+  });
+
+  it("no recorded pure-prior guess uses a removed name, and every one compiles", () => {
+    const text = readFileSync(resolve(process.cwd(), "test/types/prune-gate/prior.ts"), "utf8")
+      .replace(/\/\/.*$/gm, "")
+      .replace(/"(?:[^"\\\n]|\\.)*"/g, '""');
+    for (const name of Object.keys(PRUNED_9)) assert.ok(!new RegExp(`\\b${name}\\b`).test(text), `${name} is a recorded pure-prior guess`);
+    const diags = diagnose("prior.ts");
+    assert.deepEqual(diags.map((d) => `prior.ts:${d.line} TS${d.code} ${d.message}`), []);
+  });
+
+  it("every recorded one-hop heal still names its member", () => {
+    const want = ["setContenteditable", "setEnterkeyhint", "setFormenctype", "setFormtarget", "setDatetime", "transform"];
+    const diags = diagnose("heals.ts");
+    assert.deepEqual(diags.map((d) => [d.code, d.message.match(/Did you mean '(\w+)'\?/)?.[1]]), want.map((w) => [2551, w]));
+  });
+});
