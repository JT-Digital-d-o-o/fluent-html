index 0000000..abe5881
--- /dev/null
+++ b/src/render/class-merge.ts
@@ -0,0 +1,179 @@
+/**
+ * Opt-in serialize-time class merge (`setClassMerge`). Within one element's
+ * `class`, a later class replaces an earlier one of the same family: same
+ * variant chain, same selector shape and CSS property set in the pinned
+ * Tailwind oracle (`class-families.gen.ts`). A class it cannot classify
+ * (`cssClass` hooks, third-party names, unknown tokens) passes through.
+ *
+ * @module
+ */
+import { EXACT, ROOTS, PALETTE } from "./class-families.gen.js";
+import { escapeAttr } from "./escape.js";
+import type { ThemeSpec } from "../core/define-theme.js";
+
+/** @internal Live binding read by the serializer's class emit. */
+export let classMerge = false;
+
+const KIND_OF_NS: Readonly<Record<keyof ThemeSpec, string>> = {
+  colors: "color", fontSize: "tok:--text", shadow: "tok:--shadow", fonts: "tok:--font", radius: "tok:--radius", spacing: "num",
+};
+const TOKENS = new Map<string, string[]>();
+const CAP = 10_000;
+const TOKEN_FAMILY = new Map<string, number>();
+const FAMILY_KEYS = new Map<string, number>();
+const MEMO = new Map<string, string>();
+let seen = new Int32Array(1024);
+let gen = 0;
+
+/**
+ * Turn on last-write-wins per class family, passing the app's `defineTheme`
+ * tokens (custom names like `text-danger` vs `text-display` are classified by
+ * them); `false` turns it off. Off by default in 8.x.
+ *
+ * @example
+ * import { setClassMerge } from "fluent-html";
+ * import { theme } from "./app/theme.js";
+ * setClassMerge(theme);
+ * Div().apply(card).p("4")   // class="bg-surface rounded-card p-4", not "p-6 … p-4"
+ */
+export function setClassMerge(theme: ThemeSpec | false): void {
+  TOKENS.clear();
+  TOKEN_FAMILY.clear();
+  MEMO.clear();
+  if (theme === false) {
+    classMerge = false;
+    return;
+  }
+  for (const ns of Object.keys(KIND_OF_NS) as (keyof ThemeSpec)[]) {
+    const kind = KIND_OF_NS[ns];
+    for (const k of Object.keys(theme[ns] ?? {})) {
+      const kinds = TOKENS.get(k);
+      if (kinds) kinds.push(kind); else TOKENS.set(k, [kind]);
+    }
+  }
+  classMerge = true;
+}
+
+const COLOR_ARB = /^\[(?:#|(?:rgb|rgba|hsl|hsla|hwb|lab|lch|oklab|oklch|color)\(|color:)/;
+const NUM_ARB = /^\[-?[0-9.]+\]$/;
+const LEN_ARB = /^\[(?:-?[0-9.]+[a-z%]+\]|length:|calc\(|clamp\(|min\(|max\()/;
+
+function valueFamily(rule: Readonly<Record<string, number>>, v: string): number {
+  if (v.charCodeAt(0) === 91 /* [ */) {
+    const kind = COLOR_ARB.test(v) ? "a:color" : NUM_ARB.test(v) ? "a:num" : LEN_ARB.test(v) ? "a:len" : "";
+    return kind === "" ? 0 : rule[kind] ?? 0;
+  }
+  let only = 0;
+  let distinct = 0;
+  for (const k in rule) {
+    if (k === "bare" || k.charCodeAt(0) === 97 /* a: */) continue;
+    const f = rule[k]!;
+    if (f !== only) { only = f; distinct++; }
+  }
+  if (distinct === 1 && rule["color"] === undefined) return only;
+  const slash = v.indexOf("/");
+  const name = slash === -1 ? v : v.slice(0, slash);
+  const c = name.charCodeAt(0);
+  if (c >= 48 && c <= 57) return rule["num"] ?? 0;
+  const kinds = TOKENS.get(name);
+  if (kinds !== undefined) {
+    let hit = 0;
+    for (const k of kinds) {
+      const f = rule[k];
+      if (f !== undefined) { if (hit !== 0 && hit !== f) return 0; hit = f; }
+    }
+    if (hit !== 0) return hit;
+  }
+  if (PALETTE.has(name) || name === "black" || name === "white") return rule["color"] ?? 0;
+  return 0;
+}
+
+/** Family key of one class token: `<variant chain>:<family id>`, or "" when unclassified. */
+function classify(tok: string): string {
+  let depth = 0;
+  let cut = -1;
+  for (let i = tok.length - 1; i >= 0; i--) {
+    const c = tok.charCodeAt(i);
+    if (c === 93) depth++;
+    else if (c === 91) depth--;
+    else if (c === 58 && depth === 0) { cut = i; break; }
+  }
+  let base = cut === -1 ? tok : tok.slice(cut + 1);
+  const c0 = base.charCodeAt(0);
+  // Important (`!p-4` / `p-4!`) outranks order, so it is never merged.
+  if (base.length === 0 || c0 === 33 || base.charCodeAt(base.length - 1) === 33) return "";
+  if (c0 === 91 /* [prop:value] */) {
+    const colon = base.indexOf(":");
+    if (colon < 2 || base.charCodeAt(base.length - 1) !== 93) return "";
+    return (cut === -1 ? "" : tok.slice(0, cut + 1)) + base.slice(0, colon);
+  }
+  if (c0 === 45 /* - */) base = base.slice(1);
+  let fam = EXACT.get(base) ?? 0;
+  if (fam === 0) {
+    for (let i = base.lastIndexOf("-"); i > 0; i = base.lastIndexOf("-", i - 1)) {
+      const rule = ROOTS.get(base.slice(0, i));
+      if (rule !== undefined) { fam = valueFamily(rule, base.slice(i + 1)); break; }
+    }
+  }
+  return fam === 0 ? "" : (cut === -1 ? "" : tok.slice(0, cut + 1)) + fam;
+}
+
+function familyOf(tok: string): number {
+  let id = TOKEN_FAMILY.get(tok);
+  if (id !== undefined) return id;
+  const key = classify(tok);
+  id = 0;
+  if (key !== "") {
+    id = FAMILY_KEYS.get(key) ?? 0;
+    if (id === 0) {
+      id = FAMILY_KEYS.size + 1;
+      FAMILY_KEYS.set(key, id);
+      if (id >= seen.length) { const grown = new Int32Array(seen.length * 2); grown.set(seen); seen = grown; }
+    }
+  }
+  if (TOKEN_FAMILY.size >= CAP) TOKEN_FAMILY.clear();
+  TOKEN_FAMILY.set(tok, id);
+  return id;
+}
+
+/** @internal Keep the last class of each family, in written order; returns `cls` when nothing repeats. */
+export function mergeClassList(cls: string): string {
+  // Ids are only compared within one call, so the id table is reset between calls, never inside one.
+  if (FAMILY_KEYS.size >= CAP) { FAMILY_KEYS.clear(); TOKEN_FAMILY.clear(); }
+  const toks = cls.split(" ");
+  const n = toks.length;
+  if (n < 2) return cls;
+  const ids = new Int32Array(n);
+  let dup = false;
+  if (++gen === 0x7fffffff) { gen = 1; seen.fill(0); }
+  for (let i = 0; i < n; i++) {
+    const f = familyOf(toks[i]!);
+    ids[i] = f;
+    if (f !== 0) { if (seen[f] === gen) dup = true; else seen[f] = gen; }
+  }
+  if (!dup) return cls;
+  if (++gen === 0x7fffffff) { gen = 1; seen.fill(0); }
+  let out = "";
+  for (let i = n - 1; i >= 0; i--) {
+    const f = ids[i]!;
+    if (f !== 0) { if (seen[f] === gen) continue; seen[f] = gen; }
+    const tok = toks[i]!;
+    if (tok !== "") out = out === "" ? tok : tok + " " + out;
+  }
+  return out;
+}
+
+/**
+ * @internal The class emit while the merge is on: merged and attribute-escaped, memoized on
+ * the raw string. A hit is one Map lookup in place of the escape scan the plain path runs.
+ * The memo is cleared at 10,000 entries, never frozen.
+ */
+export function mergedClassAttr(cls: string): string {
+  let out = MEMO.get(cls);
+  if (out === undefined) {
+    out = escapeAttr(mergeClassList(cls));
+    if (MEMO.size >= CAP) MEMO.clear();
+    MEMO.set(cls, out);
+  }
+  return out;
+}
