@@ -0,0 +1,201 @@
+/**
+ * Class-family emitter — renders `src/render/class-families.gen.ts`, the data the
+ * opt-in serialize-time class merge (`setClassMerge`) keys on.
+ *
+ * A family is the CSS property set Tailwind emits for a class (pinned oracle),
+ * so `p-6`/`p-8` share one and `p-6`/`px-8` do not. Every class the vocab can
+ * emit from a closed list lands in `EXACT`; open values (numbers, theme tokens,
+ * arbitrary values) resolve through `ROOTS` at render time.
+ *
+ * @module
+ */
+import { fileURLToPath } from "node:url";
+import * as path from "node:path";
+
+import { classVocab, emitClasses } from "../../src/class-vocab/index.js";
+import type { LeafValuesSpec } from "../../src/class-vocab/types.js";
+import { loadDesignSystem, PINNED_TAILWIND_VERSION } from "./load-design-system.js";
+
+function sourceDir(): string {
+  return path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../../scripts/gen-vocab");
+}
+
+export function classFamiliesGeneratedPath(): string {
+  return path.resolve(sourceDir(), "../../src/render/class-families.gen.ts");
+}
+
+const DIRS = ["x", "y", "t", "r", "b", "l"];
+const BORDER_DIRS = ["x", "y", "t", "r", "b", "l", "s", "e"];
+const CORNERS = ["t", "r", "b", "l", "tl", "tr", "br", "bl", "s", "e", "ss", "se", "es", "ee"];
+// The hidden utility stays out of the display family (F-A-302 / C-35): hidden-first
+// markup toggled by a class-flipping client verb must keep both classes.
+const CARVE_OUT: Readonly<Record<string, string>> = { hidden: "display/hidden" };
+
+type Kind = "color" | "num" | `tok:${string}` | `a:${string}`;
+
+export async function renderClassFamiliesGen(): Promise<string> {
+  const { design } = await loadDesignSystem();
+  // Family id = the rule's selector shape (`&` for the element itself, `:where(& > :not(:last-child))`
+  // for divide/space, `&::placeholder`, …) plus the sorted property set it declares.
+  const sig = (cls: string): string | null => {
+    const css = design.candidatesToCss([cls])[0];
+    if (!css) return null;
+    const body = css.split("@property")[0]!;
+    const brace = body.indexOf("{");
+    const escaped = "." + cls.replace(/[^a-zA-Z0-9_-]/g, (c) => "\\" + c);
+    const shape = body.slice(0, brace).trim().split(escaped).join("&");
+    const props = new Set<string>();
+    for (const m of body.slice(brace).matchAll(/(?:^|[;{\s])(-{0,2}[a-z][a-z0-9-]*)\s*:/g)) props.add(m[1]!);
+    const set = [...props].sort().join(",");
+    return shape === "&" ? set : `${shape} ${set}`;
+  };
+  const keys = (ns: string): string[] => [...design.theme.keysInNamespaces([ns as `--${string}`])];
+
+  const exact = new Map<string, string>();
+  const roots = new Map<string, Map<Kind, string>>();
+  const bare = new Map<string, string>();
+  const conflicts: string[] = [];
+
+  const argSets = (method: string, kind: string, v: string | undefined): string[][] => {
+    const one = v === undefined ? [] : [v];
+    const out: string[][] = [one];
+    if (v === undefined) return out;
+    if (kind === "spacing") for (const d of DIRS) out.push([d, v]);
+    if (method === "border") for (const d of BORDER_DIRS) out.push([d, v]);
+    if (method === "rounded") for (const c of CORNERS) out.push([c, v]);
+    return out;
+  };
+  const seenRoots = new Set<string>();
+  const addExact = (cls: string, s: string): void => {
+    const p = design.parseCandidate(cls)[0] as { kind: string; root?: string } | undefined;
+    if (p?.kind === "functional" && p.root) seenRoots.add(p.root.startsWith("-") ? p.root.slice(1) : p.root);
+    const prev = exact.get(cls);
+    if (prev !== undefined && prev !== s) conflicts.push(`${cls}: ${prev} vs ${s}`);
+    exact.set(cls, s);
+  };
+  const addOpen = (cls: string, kind: Kind, s: string, expect?: string): void => {
+    const p = design.parseCandidate(cls)[0] as { kind: string; root?: string; value?: { value?: string } | null } | undefined;
+    if (!p || p.kind !== "functional" || !p.root) return;
+    if (expect !== undefined && p.value?.value !== expect) return; // emitter dropped the value: not a sample of this kind
+    const root = p.root.startsWith("-") ? p.root.slice(1) : p.root;
+    let m = roots.get(root);
+    if (!m) roots.set(root, (m = new Map()));
+    const prev = m.get(kind);
+    if (prev !== undefined && prev !== s) conflicts.push(`${root}/${kind}: ${prev} vs ${s}`);
+    m.set(kind, s);
+    if (p.value === null) bare.set(root, s);
+  };
+
+  for (const row of classVocab) {
+    const shape = row.emit;
+    if (shape.kind === "static") {
+      const s = sig(shape.class);
+      if (s) addExact(shape.class, s);
+      continue;
+    }
+    if (shape.kind === "value" || row.method === "cssProp") continue;
+    if (shape.kind === "optional") {
+      const [cls] = emitClasses(shape, []);
+      const s = cls ? sig(cls) : null;
+      if (cls && s) { addExact(cls, s); const p = design.parseCandidate(cls)[0] as { root?: string } | undefined; if (p?.root) bare.set(p.root, s); }
+    }
+    const palette0 = new Set(keys("--color"));
+    for (const sample of row.samples ?? []) for (const cls of emitClasses(shape, sample)) {
+      const s = sig(cls); if (!s) continue;
+      const p = design.parseCandidate(cls)[0] as { kind: string; value?: { value?: string } | null } | undefined;
+      if (!p) continue;
+      if (p.kind === "static") { addExact(cls, s); continue; }
+      const val = p.value?.value;
+      if (p.value === null) { addExact(cls, s); continue; }
+      if (val === undefined) continue;
+      if (/^-?[0-9]/.test(val)) addOpen(cls, "num", s, val);
+      else if (palette0.has(val)) addOpen(cls, "color", s, val);
+    }
+    const v = row.values;
+    const groups: [string, LeafValuesSpec][] = !v ? [] : v.kind === "group" ? Object.entries(v.groups) : [["default", v]];
+    if (groups.length === 0) {
+      for (const sample of row.samples ?? [["4"]]) for (const cls of emitClasses(shape, sample)) {
+        const s = sig(cls); if (!s) continue;
+        const p = design.parseCandidate(cls)[0] as { kind: string } | undefined;
+        if (p?.kind === "static") addExact(cls, s); else addOpen(cls, "num", s);
+      }
+      continue;
+    }
+    for (const [, spec] of groups) {
+      if (spec.kind === "literals") {
+        for (const lit of spec.list) for (const args of argSets(row.method, shape.kind, lit)) for (const cls of emitClasses(shape, args)) {
+          const s = sig(cls); if (s) addExact(cls, s);
+        }
+        continue;
+      }
+      if (spec.kind === "theme" && spec.ns === "--color") {
+        for (const args of argSets(row.method, shape.kind, "red-500")) for (const cls of emitClasses(shape, args)) {
+          const s = sig(cls); if (s) addOpen(cls, "color", s, "red-500");
+        }
+        continue;
+      }
+      if (spec.kind === "theme" && keys(spec.ns).length > 0) {
+        const ks = keys(spec.ns);
+        for (const k of ks) for (const args of argSets(row.method, shape.kind, k)) for (const cls of emitClasses(shape, args)) {
+          const s = sig(cls); if (!s) continue;
+          addExact(cls, s);
+          if (k === ks[0]) addOpen(cls, `tok:${spec.ns}`, s);
+        }
+        continue;
+      }
+      // typeRef: numeric arm (widths, thicknesses, angles, spacing scale)
+      for (const n of ["2", "4"]) for (const args of argSets(row.method, shape.kind, n)) for (const cls of emitClasses(shape, args)) {
+        const s = sig(cls); if (!s) continue;
+        const p = design.parseCandidate(cls)[0] as { kind: string } | undefined;
+        if (p?.kind === "static") addExact(cls, s); else addOpen(cls, "num", s, n);
+      }
+    }
+  }
+  for (const [cls, id] of Object.entries(CARVE_OUT)) exact.set(cls, id);
+  // Arbitrary values: the oracle decides which family each value type lands in (`font-[600]`
+  // is a weight, `text-[13px]` a size, `text-[#123456]` a color).
+  for (const root of new Set([...seenRoots, ...roots.keys()])) {
+    let m = roots.get(root);
+    for (const [cat, probe] of [["a:color", "[#123456]"], ["a:len", "[13px]"], ["a:num", "[3]"]] as const) {
+      const s = sig(`${root}-${probe}`);
+      if (!s) continue;
+      if (!m) roots.set(root, (m = new Map()));
+      // Same root, nested property set (`text-[13px]` font-size ⊂ `text-lg` font-size+line-height): one family.
+      const set = new Set(s.split(","));
+      const peer = [...m.entries()].filter(([k]) => !k.startsWith("a:")).map(([, f]) => f)
+        .find((f) => { const o = f.split(","); return o.every((x) => set.has(x)) || [...set].every((x) => o.includes(x)); });
+      m.set(cat as Kind, peer ?? s);
+    }
+  }
+  if (conflicts.length) throw new Error(`emit-class-families: one class/root, two families:\n  ${conflicts.join("\n  ")}`);
+
+  const palette = keys("--color");
+  const names = [...new Set([...exact.values(), ...[...roots.values()].flatMap((m) => [...m.values()]), ...bare.values()])].sort();
+  const id = (f: string): number => names.indexOf(f) + 1;
+  const lines: string[] = [
+    "// AUTO-GENERATED — do NOT edit by hand. Regenerate: `npm run gen:vocab` (CI checks `--check`).",
+    `// Source: class-vocab rows × tailwindcss@${PINNED_TAILWIND_VERSION} candidatesToCss (selector shape + property set) — see scripts/gen-vocab/emit-class-families.ts.`,
+    "",
+    "/** @internal Family names; a family id is its index + 1 (0 = unclassified, never merged). */",
+    `export const FAMILY_NAMES: readonly string[] = ${JSON.stringify(names, null, 1).replace(/\n\s*/g, " ")};`,
+    "",
+    "/** @internal Exact class → family id. */",
+    "export const EXACT: ReadonlyMap<string, number> = new Map([",
+    ...[...exact.entries()].sort(([a], [b]) => (a < b ? -1 : 1)).map(([c, f]) => `  [${JSON.stringify(c)}, ${id(f)}],`),
+    "]);",
+    "",
+    "/** @internal Open-valued root → family id per value kind (`color`, `num`, `tok:<ns>`, `a:<arbitrary type>`, `bare`). */",
+    "export const ROOTS: ReadonlyMap<string, Readonly<Record<string, number>>> = new Map<string, Readonly<Record<string, number>>>([",
+    ...[...roots.entries()].sort(([a], [b]) => (a < b ? -1 : 1)).map(([r, m]) => {
+      const o: Record<string, number> = Object.fromEntries([...m.entries()].sort().map(([k, f]) => [k, id(f)]));
+      const bf = bare.get(r); if (bf) o["bare"] = id(bf);
+      return `  [${JSON.stringify(r)}, ${JSON.stringify(o)}],`;
+    }),
+    "]);",
+    "",
+    "/** @internal Tailwind's default color keys (`red-500`, …) plus color keywords. */",
+    `export const PALETTE: ReadonlySet<string> = new Set(${JSON.stringify([...palette, "inherit", "current", "transparent"].sort())});`,
+    "",
+  ];
+  return lines.join("\n");
+}
