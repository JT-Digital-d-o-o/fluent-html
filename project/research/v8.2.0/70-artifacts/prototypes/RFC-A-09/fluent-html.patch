diff --git a/test/class-merge.test.ts b/test/class-merge.test.ts
new file mode 100644
index 0000000..886f2c3
--- /dev/null
+++ b/test/class-merge.test.ts
@@ -0,0 +1,106 @@
+import { describe, it, afterEach } from "node:test";
+import assert from "node:assert/strict";
+
+import { render, renderToIterable, setClassMerge, Div, H3, P, Span, Input, type Tag } from "../src/index.js";
+
+afterEach(() => setClassMerge(false));
+
+const theme = {
+  colors: { surface: "#fff", "surface-2": "#eee", danger: "#f00", primary: "#00f", text: "#111", "text-faint": "#999", line: "#ddd", hairline: "#ccc", accent: "#0aa" },
+  fontSize: { display: "3rem" },
+  radius: { card: "1rem" },
+  fonts: { accent: "x" },
+  shadow: { card: "0 0 1px #000" },
+} as const;
+// Custom tokens are app-declared (FluentCustomColors); the lib's own tests have none, so token
+// calls go through an untyped view of the chain.
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+const u = (t: Tag): any => t;
+const cls = (t: Tag): string => /class="([^"]*)"/.exec(render(t))![1]!;
+const card = (t: Tag) => u(t).p("6").bg("surface").rounded("card");
+const cardTitle = (t: Tag) => u(t).text("lg").font("semibold").text("text");
+
+describe("class merge — off (8.x default)", () => {
+  it("emits every written class, as 8.1.0 did", () => {
+    assert.equal(cls(u(Div("x")).apply(card).p("4")), "p-6 bg-surface rounded-card p-4");
+  });
+  it("setClassMerge(false) restores append-only output", () => {
+    setClassMerge(theme);
+    setClassMerge(false);
+    assert.equal(cls(u(Div("x")).bg("surface").when(true, (t: Tag) => u(t).bg("danger/10"))), "bg-surface bg-danger/10");
+  });
+});
+
+describe("class merge — the later write of a family wins", () => {
+  const cases: [string, Tag, string][] = [
+    ["preset then direct", u(Div("x")).apply(card).p("4"), "bg-surface rounded-card p-4"],
+    ["base then .when", u(Div("x")).bg("surface").when(true, (t: Tag) => u(t).bg("danger/10")), "bg-danger/10"],
+    ["base then .whenMatch", u(Div("x")).bg("surface").whenMatch("err" as "ok" | "err", { ok: (t: Tag) => u(t).bg("surface-2"), err: (t: Tag) => u(t).bg("danger/10") }), "bg-danger/10"],
+    ["repeated variant object", u(Div("x")).hover({ bg: "primary" }).hover({ bg: "danger" }), "hover:bg-danger"],
+    ["nested variant chain", u(Div("x")).md({ hover: { bg: "primary" } }).md({ hover: { bg: "danger" } }), "md:hover:bg-danger"],
+    ["component base, no composition", u(Div("x")).w("full").w("20"), "w-20"],
+    ["custom color tokens", u(H3("x")).apply(cardTitle).text("danger"), "text-lg font-semibold text-danger"],
+    ["disabled cursor", u(Div("x")).cursor("pointer").when(true, (t: Tag) => u(t).opacity("50").cursor("not-allowed")), "opacity-50 cursor-not-allowed"],
+    ["custom font-size token", u(Div("x")).text("lg").text("display"), "text-display"],
+    ["arbitrary size over a scale size", u(Span("x")).text("xs").text("px", 11), "text-[11px]"],
+    ["arbitrary weight over a keyword weight", u(Div("x")).font("bold").font("[600]"), "font-[600]"],
+    ["custom shadow token", u(Div("x")).shadow("md").shadow("card"), "shadow-card"],
+    ["negative over positive", u(Div("x")).mt("4").neg("mt-2"), "-mt-2"],
+    ["cssProp on one property", u(Div("x")).cssProp("mask-repeat", "no-repeat").cssProp("mask-repeat", "repeat"), "[mask-repeat:repeat]"],
+    ["exact duplicate", u(Div("x")).cursor("pointer").cursor("pointer"), "cursor-pointer"],
+  ];
+  for (const [name, tag, want] of cases) it(name, () => { setClassMerge(theme); assert.equal(cls(tag), want); });
+});
+
+describe("class merge — different families are kept", () => {
+  const keep: [string, Tag, string][] = [
+    ["side width + color", u(Div("x")).border("b").border("line"), "border-b border-line"],
+    ["size + color + align", u(Div("x")).text("lg").text("primary").text("center"), "text-lg text-primary text-center"],
+    ["ring width + color (focus)", u(Div("x")).focus({ ring: "2" }).focus({ ring: "primary/40" }), "focus:ring-2 focus:ring-primary/40"],
+    ["shorthand vs longhand", u(Div("x")).px("8").p("6"), "px-8 p-6"],
+    ["display vs direction vs flex", u(Div("x")).flex().flex("col").flex("1"), "flex flex-col flex-1"],
+    ["weight vs family", u(Div("x")).font("bold").font("mono"), "font-bold font-mono"],
+    ["family vs arbitrary weight", u(Div("x")).font("mono").font("[600]"), "font-mono font-[600]"],
+    ["shadow size vs color", u(Div("x")).shadow("md").shadow("danger"), "shadow-md shadow-danger"],
+    ["children's border color vs own", u(Div("x")).divideY().divide("line").border().border("line"), "divide-y divide-line border border-line"],
+    ["hidden stays out of display", u(Div("x")).hidden().flex().flex("col"), "hidden flex flex-col"],
+    ["variant vs base", u(Div("x")).bg("surface").hover({ bg: "surface-2" }), "bg-surface hover:bg-surface-2"],
+    ["important is never merged", u(Div("x")).p("6").cssClass("p-4!"), "p-6 p-4!"],
+    ["unknown hooks pass through", u(Div("x")).cssClass("js-row").p("6").cssClass("js-row-2").p("4"), "js-row js-row-2 p-4"],
+  ];
+  for (const [name, tag, want] of keep) it(name, () => { setClassMerge(theme); assert.equal(cls(tag), want); });
+});
+
+describe("class merge — token registry", () => {
+  it("an unregistered custom token is never merged", () => {
+    setClassMerge({});
+    assert.equal(cls(u(H3("x")).apply(cardTitle).text("danger")), "text-lg font-semibold text-text text-danger");
+  });
+  it("a token registered in two families that share a prefix is never merged", () => {
+    setClassMerge({ colors: { big: "#000" }, fontSize: { big: "2rem" } });
+    assert.equal(cls(u(Div("x")).text("lg").text("big" as "lg")), "text-lg text-big");
+  });
+});
+
+describe("class merge — emit contract", () => {
+  it("escapes the merged value", () => {
+    setClassMerge(theme);
+    assert.equal(render(u(Div("x")).cssClass('a"b').p("6").p("4")), '<div class="a&quot;b p-4">x</div>');
+  });
+  it("the streaming serializer merges too", () => {
+    setClassMerge(theme);
+    assert.equal([...renderToIterable(u(Div("x")).apply(card).p("4"))].join(""), '<div class="bg-surface rounded-card p-4">x</div>');
+  });
+  it("stays correct past the memo cap (cleared, never frozen)", () => {
+    setClassMerge(theme);
+    for (let i = 0; i < 10_050; i++) render(u(Div("x")).cssClass(`js-${i}`).p("6").p("4"));
+    assert.equal(cls(u(Div("x")).apply(card).p("8")), "bg-surface rounded-card p-8");
+    assert.equal(cls(u(P("x")).cssClass("js-new").p("6").p("4")), "js-new p-4");
+  });
+  it("leaves the tag's own class storage untouched", () => {
+    setClassMerge(theme);
+    const t = Input().p("6").p("4");
+    render(t);
+    assert.equal(t.getClass(), "p-6 p-4");
+  });
+});
