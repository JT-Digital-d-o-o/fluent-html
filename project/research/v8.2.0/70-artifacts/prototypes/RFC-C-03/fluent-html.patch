index 0000000..4c2a374
--- /dev/null
+++ b/scripts/codemod/nonce-bag.ts
@@ -0,0 +1,168 @@
+/**
+ * `npm run codemod:nonce-bag -- <tsconfig> [--dry]` — move render-time CSP nonces
+ * off the removed options bag onto the named functions (9.0.0).
+ *
+ *  - `render(...views, { nonce: n })`         → `renderWithNonce(n, ...views)`
+ *  - `renderToStream(...views, { nonce: n })` → `renderToStreamWithNonce(n, ...views)`
+ *
+ * Rewritten only when the callee resolves to fluent-html's `render` /
+ * `renderToStream` and the bag is an object literal. Skipped and reported: a
+ * stream bag that also sets `chunkSize`/`highWaterMark`, any `renderToIterable`
+ * nonce, a bag passed by reference, a spread or computed key, a nonce expression
+ * with side effects (the rewrite moves it before the views), and every
+ * `RenderOptions` type reference.
+ *
+ * @module
+ */
+import { pathToFileURL } from "node:url";
+
+import { Node, Project, SyntaxKind, type CallExpression, type SourceFile } from "ts-morph";
+
+const SUCCESSOR: Readonly<Record<string, string>> = {
+  render: "renderWithNonce",
+  renderToStream: "renderToStreamWithNonce",
+};
+const SOURCE_NAMES = new Set(["render", "renderToStream", "renderToIterable"]);
+const DECL_FILES = new Set(["render.ts", "render.d.ts", "stream.ts", "stream.d.ts", "serialize.ts", "serialize.d.ts"]);
+
+export type Skip = { readonly line: number; readonly name: string; readonly reason: string };
+type Edit = { readonly start: number; readonly end: number; readonly text: string };
+
+function fluentDecl(node: Node): string | undefined {
+  let symbol = node.getSymbol();
+  if (symbol?.isAlias()) symbol = symbol.getAliasedSymbol();
+  const decl = symbol?.getDeclarations()[0];
+  if (decl === undefined) return undefined;
+  const file = decl.getSourceFile();
+  if (!DECL_FILES.has(file.getBaseName()) || !file.getFilePath().includes("/render/")) return undefined;
+  return symbol!.getName();
+}
+
+function hasSideEffects(expr: Node): boolean {
+  if (Node.isCallExpression(expr) || Node.isNewExpression(expr) || Node.isAwaitExpression(expr)) return true;
+  if (Node.isBinaryExpression(expr) && expr.getOperatorToken().getKind() >= SyntaxKind.FirstAssignment
+      && expr.getOperatorToken().getKind() <= SyntaxKind.LastAssignment) return true;
+  if (Node.isPrefixUnaryExpression(expr) || Node.isPostfixUnaryExpression(expr)) {
+    const op = expr.getOperatorToken();
+    if (op === SyntaxKind.PlusPlusToken || op === SyntaxKind.MinusMinusToken) return true;
+  }
+  return expr.getChildren().some(hasSideEffects);
+}
+
+function rewriteCall(call: CallExpression, name: string, edits: Edit[], skips: Skip[], needs: Set<string>): void {
+  const args = call.getArguments();
+  const last = args[args.length - 1];
+  const line = call.getStartLineNumber();
+  if (last === undefined) return;
+  if (!Node.isObjectLiteralExpression(last)) {
+    if (args.length >= 2 && !Node.isSpreadElement(last) && last.getType().getProperty("nonce") !== undefined
+        && last.getType().getCallSignatures().length === 0 && !last.getType().isArray()) {
+      skips.push({ line, name, reason: "options bag passed by reference; move its nonce to the first argument of the *WithNonce function by hand" });
+    }
+    return;
+  }
+  const props = last.getProperties();
+  let nonceText: string | undefined;
+  const others: string[] = [];
+  for (const p of props) {
+    if (Node.isShorthandPropertyAssignment(p)) {
+      if (p.getName() === "nonce") nonceText = "nonce"; else others.push(p.getName());
+    } else if (Node.isPropertyAssignment(p) && !Node.isComputedPropertyName(p.getNameNode())) {
+      if (p.getName() === "nonce") {
+        const init = p.getInitializerOrThrow();
+        if (hasSideEffects(init)) {
+          skips.push({ line, name, reason: "nonce expression has side effects; the rewrite would evaluate it before the views" });
+          return;
+        }
+        nonceText = init.getText();
+      } else others.push(p.getName());
+    } else {
+      skips.push({ line, name, reason: "options bag with a spread or computed key" });
+      return;
+    }
+  }
+  if (nonceText === undefined) return;
+  if (name === "renderToIterable") {
+    skips.push({ line, name, reason: "renderToIterable has no nonce form; iterate renderToStreamWithNonce(nonce, ...views) with for await" });
+    return;
+  }
+  if (others.length > 0) {
+    skips.push({ line, name, reason: `renderToStreamWithNonce takes no options; drop ${others.join("/")} or the nonce` });
+    return;
+  }
+  const successor = SUCCESSOR[name]!;
+  const callee = call.getExpression();
+  const calleeText = Node.isPropertyAccessExpression(callee)
+    ? `${callee.getExpression().getText()}.${successor}`
+    : successor;
+  if (!Node.isPropertyAccessExpression(callee)) needs.add(successor);
+  const views = args.slice(0, -1).map((a) => a.getText());
+  edits.push({ start: call.getStart(), end: call.getEnd(), text: `${calleeText}(${[nonceText, ...views].join(", ")})` });
+}
+
+export function collectEdits(file: SourceFile): { edits: Edit[]; skips: Skip[]; needs: Set<string> } {
+  const edits: Edit[] = [];
+  const skips: Skip[] = [];
+  const needs = new Set<string>();
+  file.forEachDescendant((node) => {
+    if (Node.isCallExpression(node)) {
+      const callee = node.getExpression();
+      const id = Node.isPropertyAccessExpression(callee) ? callee.getNameNode() : callee;
+      if (!Node.isIdentifier(id)) return;
+      const name = fluentDecl(id);
+      if (name === undefined || !SOURCE_NAMES.has(name)) return;
+      rewriteCall(node, name, edits, skips, needs);
+    } else if (Node.isTypeReference(node)) {
+      const tn = node.getTypeName();
+      if (Node.isIdentifier(tn) && tn.getText() === "RenderOptions" && fluentDecl(tn) === "RenderOptions") {
+        skips.push({ line: node.getStartLineNumber(), name: "RenderOptions", reason: "RenderOptions is removed; pass the nonce to renderWithNonce(nonce, ...views)" });
+      }
+    }
+  });
+  return { edits, skips, needs };
+}
+
+export function applyEdits(file: SourceFile, edits: readonly Edit[], needs: ReadonlySet<string>): void {
+  for (const edit of [...edits].sort((a, b) => b.start - a.start)) file.replaceText([edit.start, edit.end], edit.text);
+  if (needs.size === 0) return;
+  const decl = file.getImportDeclarations().find((d) =>
+    d.getNamedImports().some((n) => SOURCE_NAMES.has(n.getName()) && fluentDecl(n.getNameNode()) !== undefined),
+  ) ?? file.getImportDeclarations().find((d) => d.getNamedImports().some((n) => SOURCE_NAMES.has(n.getName())));
+  if (decl === undefined) return;
+  const have = new Set(decl.getNamedImports().map((n) => n.getName()));
+  for (const name of needs) if (!have.has(name)) decl.addNamedImport(name);
+  for (const n of decl.getNamedImports()) {
+    if (n.getName() !== "render" && n.getName() !== "renderToStream") continue;
+    const local = (n.getAliasNode() ?? n.getNameNode()).getText();
+    const used = file.getDescendantsOfKind(SyntaxKind.Identifier).some((i) => i.getText() === local && !i.getFirstAncestorByKind(SyntaxKind.ImportDeclaration));
+    if (!used) n.remove();
+  }
+}
+
+function run(): void {
+  const argv = process.argv.slice(2);
+  const dry = argv.includes("--dry");
+  const tsConfigFilePath = argv.find((a) => !a.startsWith("--"));
+  if (!tsConfigFilePath) {
+    console.error("Usage: npm run codemod:nonce-bag -- <path/to/tsconfig.json> [--dry]");
+    process.exitCode = 1;
+    return;
+  }
+  const project = new Project({ tsConfigFilePath });
+  const files = project.getSourceFiles().filter((f) => !f.isDeclarationFile() && !f.getFilePath().includes("/node_modules/"));
+  let totalEdits = 0;
+  let totalSkips = 0;
+  const collected = files.map((file) => ({ file, ...collectEdits(file) }));
+  for (const { file, edits, skips, needs } of collected) {
+    for (const skip of skips) console.warn(`SKIP ${file.getFilePath()}:${skip.line} ${skip.name} — ${skip.reason}`);
+    totalSkips += skips.length;
+    if (edits.length === 0) continue;
+    applyEdits(file, edits, needs);
+    totalEdits += edits.length;
+    console.log(`${dry ? "[dry] " : ""}${file.getFilePath()} — ${edits.length} call site(s)`);
+  }
+  if (!dry) project.saveSync();
+  console.log(`codemod:nonce-bag ${dry ? "(dry run) " : ""}— ${totalEdits} call site(s) rewritten across ${files.length} file(s); ${totalSkips} skipped for manual review.`);
+}
+
+if (process.argv[1] !== undefined && import.meta.url === pathToFileURL(process.argv[1]).href) run();
