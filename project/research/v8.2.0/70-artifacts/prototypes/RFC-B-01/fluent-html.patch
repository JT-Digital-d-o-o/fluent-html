+// ------------------------------------
+// Request gate (RFC-B-01)
+// ------------------------------------
+
+describe("dev-checks — an HTMX bag must name a request", () => {
+  const routes = defineRoutes("/team", { index: { path: "/" } } as const);
+  // What a swap verb builds when handed the wrong shape: it spreads its argument into the bag.
+  const spread = (arg: unknown) => ({ ...(arg as object), target: "#main-content" }) as unknown as HTMX;
+
+  it("a spread URL string throws, naming the fix", () => {
+    throws(() => A("Team").setHtmx(spread("/team")), /<a>\.setHtmx\(\) got an HTMX bag with no request \(method: undefined, endpoint: undefined\)\. Pass a route callable result such as routes\.x\(\)/);
+  });
+
+  it("a spread .resolve() string throws", () => {
+    throws(() => A("Team").setHtmx(spread(routes.index.resolve())), /no request/);
+  });
+
+  it("a spread uncalled route callable throws (method set, endpoint missing)", () => {
+    throws(() => A("Team").setHtmx(spread(routes.index)), /method: get, endpoint: undefined/);
+  });
+
+  it("an unknown method throws (it would become the attribute name)", () => {
+    throws(() => A("Team").setHtmx({ method: "x onclick", endpoint: "/team" } as unknown as HTMX), /method: x onclick/);
+  });
+
+  it("route callables, hx() bags, hxGet/hxPost and a clearing setHtmx() pass", () => {
+    assert.doesNotThrow(() => {
+      A("Team").setHtmx(routes.index());
+      A("Team").setHtmx(hx(assetUrl("/x"), { method: "delete" }));
+      A("Team").hxGet(routes.index.resolve()).hxPost(assetUrl("/y"));
+      A("Team").setHtmx(routes.index()).setHtmx();
+    });
+  });
+
+  it("setDevChecks(false) restores the unguarded emit", () => {
+    setDevChecks(false);
+    assert.match(render(A("Team").setHtmx(spread("/team"))), /hx-undefined="undefined"/);
+  });
+});
