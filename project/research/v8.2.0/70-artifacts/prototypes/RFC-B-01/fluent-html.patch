+const HX_METHODS = new Set(["get", "post", "put", "patch", "delete"]);
+
+/**
+ * The request gate. Called by `_setHx` on every HTMX bag a tag stores; throws when the bag
+ * names no request, because `buildHtmx` would emit `hx-undefined="undefined"` (an inert
+ * control) or `hx-get="undefined"` (a GET to `/undefined`). A verb that spreads a URL string,
+ * a `.resolve()`d route or an uncalled route callable into its bag lands here.
+ *
+ * @internal
+ */
+export function assertRequestBag(tag: { el: string }, htmx: { method?: unknown; endpoint?: unknown }, method: string): void {
+  if (htmx.endpoint != null && typeof htmx.method === "string" && HX_METHODS.has(htmx.method.toLowerCase())) return;
+  throw new Error(
+    `<${tag.el}>.${method}() got an HTMX bag with no request (method: ${String(htmx.method)}, ` +
+      `endpoint: ${String(htmx.endpoint)}). Pass a route callable result such as routes.x(), ` +
+      `not a URL string, routes.x.resolve() or the uncalled routes.x.`,
+  );
+}
+
