diff --git a/test/acceptance/rows.spec.mjs b/test/acceptance/rows.spec.mjs
index de84666..fc9ab35 100644
--- a/test/acceptance/rows.spec.mjs
+++ b/test/acceptance/rows.spec.mjs
@@ -389,3 +389,81 @@ test("row 28: native dialog opens via Invoker Commands, closes via closedby", as
   await expect(page.locator("#confirm-dialog")).not.toHaveAttribute("open", "");
   await guards.assertClean();
 });
+
+// Row 31 — onClickOutside on the panel it hides: the click that opens it is
+// not "outside" (the panel was not showing when the click began).
+test("row 31: outside toggle opens an onClickOutside panel", async ({ page }) => {
+  const guards = await armGuards(page);
+  await page.goto("/outside-opener");
+  await page.click("#opener");
+  await expect(page.locator("#fx-panel")).toBeVisible();
+  await page.click("#fx-banner");
+  await expect(page.locator("#fx-panel")).toBeHidden();
+  await page.click("#opener");
+  await expect(page.locator("#fx-panel")).toBeVisible();
+  await page.click("#opener");
+  await expect(page.locator("#fx-panel")).toBeHidden();
+  await guards.assertClean();
+});
+
+// Row 32 — pushUrl nav whose swap target does NOT contain the drawer still
+// runs the full close routine (row 10 covers only the containing swap).
+test("row 32: pushUrl nav outside the drawer closes it", async ({ page }) => {
+  const guards = await armGuards(page);
+  await page.goto("/drawer-shell-nav");
+  await page.click("#carrier");
+  await expect(page.locator("#fx-drawer")).toHaveClass(/is-open/);
+  const nav = page.waitForResponse((r) => r.url().includes("/main-fresh"));
+  await page.click("#drawer-nav");
+  await nav;
+  await expect(page.locator("#main-content")).toHaveText("main-new");
+  await expect(page.locator("#fx-drawer")).not.toHaveClass(/is-open/);
+  await expect(page.locator("#fx-drawer-backdrop")).not.toHaveClass(/is-open/);
+  await expect(page.locator("body")).not.toHaveClass(/overflow-hidden/);
+  await expect(page.locator("#carrier")).toHaveAttribute("aria-expanded", "false");
+  await guards.assertClean();
+});
+
+// Row 33 — trapFocus skips an unrendered item and never hands Tab to native order.
+test("row 33: focus trap skips a hidden last item", async ({ page }) => {
+  const guards = await armGuards(page);
+  await page.goto("/drawer-hidden-item");
+  await page.click("#carrier");
+  await expect(page.locator("#drawer-nav")).toBeFocused();
+  await page.keyboard.press("Tab");
+  await expect(page.locator("#drawer-btn")).toBeFocused();
+  await page.keyboard.press("Tab");
+  await expect(page.locator("#drawer-nav")).toBeFocused();
+  await page.keyboard.press("Shift+Tab");
+  await expect(page.locator("#drawer-btn")).toBeFocused();
+  await guards.assertClean();
+});
+
+test("row 34: in-drawer append into the drawer root keeps it open", async ({ page }) => {
+  const guards = await armGuards(page);
+  await page.goto("/drawer-more");
+  await page.click("#carrier");
+  await expect(page.locator("#fx-drawer")).toHaveClass(/is-open/);
+  await page.click("#drawer-more");
+  await expect(page.locator("#more-item")).toHaveText("item 2");
+  await page.waitForTimeout(100);
+  await expect(page.locator("#fx-drawer")).toHaveClass(/is-open/);
+  await expect(page.locator("body")).toHaveClass(/overflow-hidden/);
+  await guards.assertClean();
+});
+
+test("row 35: focus trap reaches a summary and skips an inert item", async ({ page }) => {
+  const guards = await armGuards(page);
+  await page.goto("/drawer-details");
+  await page.click("#carrier");
+  await expect(page.locator("#drawer-nav")).toBeFocused();
+  await page.keyboard.press("Tab");
+  await expect(page.locator("#drawer-sum")).toBeFocused();
+  await page.keyboard.press("Tab");
+  await expect(page.locator("#drawer-btn")).toBeFocused();
+  await page.keyboard.press("Tab");
+  await expect(page.locator("#drawer-nav")).toBeFocused();
+  await page.keyboard.press("Shift+Tab");
+  await expect(page.locator("#drawer-btn")).toBeFocused();
+  await guards.assertClean();
+});
