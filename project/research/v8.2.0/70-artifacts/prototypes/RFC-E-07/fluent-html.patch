new file mode 100644
index 0000000..323fa94
--- /dev/null
+++ b/test/if-not-empty.test.ts
@@ -0,0 +1,32 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import { IfNotEmpty, IfNotEmptyElse, IfThen, ForEach, ForEachElse, Section, H2, Ul, Li, P, render } from "../src/index.js";
+
+const list = (xs: readonly string[]) => Section(H2("Tags"), Ul(ForEach(xs, (x) => Li(x))));
+
+describe("IfNotEmpty / IfNotEmptyElse", () => {
+  it("renders the branch with the list itself when it has items", () => {
+    assert.equal(render(IfNotEmpty(["a", "b"], list)), "<section><h2>Tags</h2>\n<ul><li>a</li>\n<li>b</li></ul></section>");
+  });
+  it("renders nothing for [], null and undefined", () => {
+    for (const v of [[], null, undefined] as const) assert.equal(render(IfNotEmpty(v as readonly string[] | null | undefined, list)), "");
+  });
+  it("IfNotEmptyElse takes the else branch for [], null and undefined", () => {
+    for (const v of [[], null, undefined] as const) assert.equal(render(IfNotEmptyElse(v as readonly string[] | null | undefined, list, () => P("none"))), "<p>none</p>");
+  });
+  it("calls the branch once with the same array object (no copy)", () => {
+    const xs = ["a"]; let seen: unknown; let calls = 0;
+    IfNotEmpty(xs, (ys) => { calls++; seen = ys; return ""; });
+    assert.equal(calls, 1); assert.equal(seen, xs);
+  });
+  it("closes the IfThen value-overload gap: IfThen([]) renders an empty container, IfNotEmpty([]) renders nothing", () => {
+    assert.equal(render(IfThen([] as string[], list)), "<section><h2>Tags</h2>\n<ul></ul></section>");
+    assert.equal(render(IfNotEmpty([] as string[], list)), "");
+  });
+  it("ForEachElse migration: IfNotEmptyElse(xs, (ys) => ForEach(ys, f), e) renders like ForEachElse(xs, f, e)", () => {
+    for (const xs of [["a", "b"], []]) {
+      assert.equal(render(Ul(IfNotEmptyElse(xs, (ys) => ForEach(ys, (x, i) => Li(`${i}:${x}`)), () => Li("none")))),
+                   render(Ul(ForEachElse(xs, (x, i) => Li(`${i}:${x}`), () => Li("none")))));
+    }
+  });
+});
diff --git a/test/types/if-any-probe/probe.ts b/test/types/if-any-probe/probe.ts
