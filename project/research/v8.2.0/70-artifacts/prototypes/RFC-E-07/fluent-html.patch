index 0000000..db27767
--- /dev/null
+++ b/test/types/if-any-probe/probe.ts
@@ -0,0 +1,37 @@
+// Compile-contract probe for IfAny/IfNotEmptyElse. Lines tagged FAIL must error; everything else must compile.
+import { IfNotEmpty, IfNotEmptyElse, IfThen, ForEach, Section, H2, Table, Tbody, Tr, Td, Ul, Li, P, Span, type NonEmpty, type Tag } from "../../../src/index.js";
+
+type Order = { id: number; customer: string; total: number };
+declare const orders: Order[];
+declare const ro: readonly Order[];
+declare const maybe: Order[] | undefined;
+declare const nullable: readonly string[] | null;
+declare const tuple: readonly [Order, Order];
+declare const anyList: any;
+declare const name: string;
+declare const count: number;
+declare const tagSet: Set<string>;
+function OrdersTable(props: { rows: Order[] }): Tag { return Table(Tbody(ForEach(props.rows, (o) => Tr(Td(o.customer))))); }
+
+// ---- must compile ----
+const a1 = IfNotEmpty(orders, (os) => Section(H2("Orders"), OrdersTable({ rows: os })));   // NonEmpty<Order[]> into a mutable Order[] prop
+const a2 = IfNotEmpty(ro, (os) => Ul(ForEach(os, (o) => Li(o.customer))));
+const a3 = IfNotEmpty(maybe, (os) => Span(os[0].customer));                               // os[0] defined under noUncheckedIndexedAccess
+const a4 = IfNotEmptyElse(nullable, (xs) => Ul(ForEach(xs, (x) => Li(x))), () => P("none"));
+const a5 = IfNotEmpty(tuple, (t) => Span(t[1].customer));
+const a6 = IfNotEmpty(anyList, (xs) => Span(String(xs.length)));
+const a7 = IfNotEmpty(orders, () => P(`${orders.length} orders`));                       // zero-arg branch is allowed
+const r1: Tag | "" = a1;                                                              // branch type reported, not View
+const r2: Tag = a4;
+const n1: NonEmpty<Order[]>[0] = orders[0]!;
+void [a2, a3, a5, a6, a7, r1, r2, n1];
+
+// ---- must fail ----
+IfNotEmpty(orders.length > 0, () => Section(H2("Orders")));                               // FAIL boolean
+IfNotEmpty(name, (n) => Span(n));                                                          // FAIL string
+IfNotEmpty(count, () => Span("x"));                                                        // FAIL number
+IfNotEmpty(tagSet, () => Span("x"));                                                       // FAIL set
+IfNotEmpty(orders, (o) => Li(o.customer));                                                 // FAIL per-item confusion
+IfNotEmpty(orders, (os) => os.length);                                                     // FAIL non-View branch
+IfNotEmptyElse(orders, (os) => Span(os[0].customer), P("none"));                           // FAIL else not a thunk
+IfThen(maybe, (os) => Section(H2("Orders"), OrdersTable({ rows: os })));              // compiles today: renders an empty section for []
