index e82d3dc..83b2546 100644
--- a/src/control/conditionals.ts
+++ b/src/control/conditionals.ts
@@ -207,3 +207,48 @@ export function Match(
   }
   return ((casesOrDefault as Thunk<View> | undefined) ?? Empty)();
 }
+
+/**
+ * An array proven to hold at least one item: `items[0]` is the element type, not
+ * `T | undefined`. Keeps the input's own array type, so a mutable `T[]` still
+ * passes to a `T[]` prop.
+ */
+export type NonEmpty<A extends readonly unknown[]> = A & { readonly 0: A[number] };
+
+/** The argument check behind IfNotEmpty/IfNotEmptyElse: a non-array names the fix instead of failing as `never`. */
+type ListOrAbsent<A> = A extends readonly unknown[] | null | undefined
+  ? A
+  : "IfNotEmpty/IfNotEmptyElse take the array itself: IfNotEmpty(items, (items) => ...). A boolean, string, number or Set goes to IfThen.";
+
+/**
+ * Render `then` with the list when it holds at least one item; render nothing when it
+ * is empty, `null` or `undefined`. The branch receives the list itself, narrowed to
+ * `NonEmpty` (no restating it, no `!` on `items[0]`).
+ *
+ * @example
+ * IfNotEmpty(props.tags, (tags) => Div(ForEach(tags, Chip)))
+ */
+export function IfNotEmpty<A, R extends View>(
+  items: ListOrAbsent<A>,
+  then: (items: NonEmpty<Extract<A, readonly unknown[]>>) => R,
+): R | "";
+export function IfNotEmpty(items: readonly unknown[] | null | undefined, then: (items: readonly unknown[]) => View): View {
+  return items != null && items.length > 0 ? then(items) : Empty();
+}
+
+/**
+ * `IfNotEmpty` with an else branch: `then` with the non-empty list, `otherwise` for an
+ * empty, `null` or `undefined` list. The whole container is swapped (a section with
+ * its heading, a table with its head), not just the rows.
+ *
+ * @example
+ * IfNotEmptyElse(orders, (os) => Table(Tbody(ForEach(os, OrderRow))), () => P("No orders yet"))
+ */
+export function IfNotEmptyElse<A, R extends View, E extends View>(
+  items: ListOrAbsent<A>,
+  then: (items: NonEmpty<Extract<A, readonly unknown[]>>) => R,
+  otherwise: Thunk<E>,
+): R | E;
+export function IfNotEmptyElse(items: readonly unknown[] | null | undefined, then: (items: readonly unknown[]) => View, otherwise: Thunk<View>): View {
+  return items != null && items.length > 0 ? then(items) : otherwise();
+}
