+// ── hx-swap: the htmx 4 modifier spellings compile; the near misses stay errors (RFC-B-02) ──
+{
+  const u = assetUrl("/x");
+  const ids = defineIds(["log"] as const);
+  for (const swap of [
+    "outerHTML focusScroll:true", "innerHTML focusScroll:false", "innerHTML transition:false",
+    "outerHTML ignoreTitle:false", "innerHTML strip:true", "outerMorph swapEmpty:true",
+    "outerMorph show:top showTarget:body", "outerMorph scroll:bottom scrollTarget:#log",
+  ] as const) hx(u, { swap });
+  hx(u, { swap: `outerMorph scroll:bottom scrollTarget:${ids.log.selector}` });
+  HxPartial(ids.log, Span("x"), "outerMorph transition:false");
+  // @ts-expect-error a morph keeps focus, so htmx never reads focusScroll after it
+  hx(u, { swap: "outerMorph focusScroll:true" });
+  // @ts-expect-error window is not an element: scrollIntoView is a no-op; showTarget:body scrolls the page
+  hx(u, { swap: "outerMorph show:top showTarget:window" });
+  // @ts-expect-error scrollTarget resolves from document, where closest/find/next have no anchor
+  hx(u, { swap: "innerHTML scroll:top scrollTarget:closest div" });
