+// Drill: the F-A-104 fix lands (credentials becomes a RequestCredentials string) while the row
+// still carries its known mark. Simulated by emitting the fixed bytes under the same mark.
+import { test as base, expect } from "@playwright/test";
+import { open } from "./harness.mjs";
+import * as L from "../../dist-link/src/index.js";
+const test = base.extend({ bundle: ["htmx-4.0.0-beta6", { option: true }] });
+test("bag/config.credentials", async ({ page, bundle }) => {
+  test.fail(true, "F-A-104 credentials boolean throws in fetch");
+  const p = await open(page, bundle, { body: `<div id="t">old</div>` + L.render(L.Button("go").setId("go").setType("button").setHtmx(L.hx(L.assetUrl("/r"), { target: "#t", config: { credentials: "include" } }))), routes: { "/r": { body: "new" } } });
+  await p.page.click("#go"); await p.settle();
+  expect(await p.text("#t")).toBe("new");
+});
diff --git a/test/grammar/rows.mjs b/test/grammar/rows.mjs
new file mode 100644
index 0000000..8901173
--- /dev/null
+++ b/test/grammar/rows.mjs
@@ -0,0 +1,713 @@
+// Oracle rows: each renders a typed fluent-html emission from dist/, runs it against a real htmx
+// bundle, and asserts the effect the type advertises. `covers` ties the row to typed-surface tokens
+// (surface.mjs). `known` marks a measured defect per bundle ("*" = all): the row runs as
+// test.fail, so it stays green while broken and turns red the day it starts working (the fixing
+// RFC must delete the mark). `level`: effect (observable outcome) | read (executed config read).
+import { expect } from "@playwright/test";
+import * as L from "../../dist-link/src/index.js";
+import { HTMX_EVENTS, fixtureIds } from "../../dist-link/src/behaviors/index.js";
+import * as OLD from "../../olddist/dist/src/index.js";
+
+const { render, Div, Button, A, Form, Input, Span, P, Section, Table, Tbody, Tr, Td, Select, Option, hx, assetUrl,
+  defineIds, Partial, hxResponse, HtmxConfig, Empty, id, clss, closest, find, next, previous } = L;
+const u = (p) => assetUrl(p);
+const go = (opts, label = "go") => render(Button(label).setId("go").setType("button").setHtmx(hx(u("/r"), opts)));
+const rows = [];
+const row = (id, covers, run, extra = {}) => rows.push({ id, covers, run, level: "effect", ...extra });
+const F = {
+  mod: "F-A-105 swap modifier unread", sel: "F-A-109 selector/trigger literal never fires", cred: "F-A-104 credentials boolean throws in fetch",
+  mode: "F-A-104/L-148 hx-config mode overwritten", status: "F-A-103 unquoted hx-status value", bag: "F-A-110 element-state key rides the request bag",
+  hdr: "F-A-108 non-Latin-1 header value throws", drawer: "F-A-107 htmx-2 event detail", partial: "F-D-101 beta6 resolves partial targets document-wide",
+  cfg: "F-D-103 config/location key has 0 readers",
+};
+
+// ── methods, endpoint, the four Tag emitters ─────────────────────────────────
+for (const m of ["get", "post", "put", "patch", "delete"]) {
+  row(`method/${m}`, [`HxHttpMethod:${m}`, "HTMX.method", "HTMX.endpoint", "hx()#0:ResolvedRoute | ExternalHref,HxOptions", "Tag#setHtmx"], async (o) => {
+    const p = await o({ body: `<div id="t">old</div>` + go({ method: m, target: "#t" }), routes: { "/r": { body: "new" } } });
+    await p.page.click("#go"); await p.settle();
+    expect(p.hx().map((r) => r.method)).toEqual([m.toUpperCase()]);
+    expect(await p.text("#t")).toBe("new");
+  });
+}
+for (const [verb, m] of [["hxGet", "GET"], ["hxPost", "POST"]]) {
+  row(`tag/${verb}`, [`Tag#${verb}`], async (o) => {
+    const p = await o({ body: `<div id="t">old</div>` + render(Button("go").setId("go").setType("button")[verb](u("/r"), { target: "#t" })), routes: { "/r": { body: "new" } } });
+    await p.page.click("#go"); await p.settle();
+    expect(p.hx().map((r) => r.method)).toEqual([m]);
+    expect(await p.text("#t")).toBe("new");
+  });
+}
+
+// ── targets and selector keywords ────────────────────────────────────────────
+const targetLayout = (opts) => `<section id="sec"><div id="prev">prev</div>${go(opts)}<div id="nxt"><span class="inner">nxt</span></div></section><div id="t" class="c">t</div>`;
+const targetCases = [
+  ["id()", "HTMX.target", { target: id("t") }, "#t", ["id()#0:string"]],
+  ["clss()", "HTMX.target", { target: clss("c") }, "#t", ["clss()#0:string"]],
+  ["this", "ExtendedCSSSelector:this", { target: "this" }, "#go"],
+  ["closest", "ExtendedCSSSelector:`closest ${string}`", { target: closest("section") }, "#sec", ["closest()#0:string"]],
+  ["next", "ExtendedCSSSelector:`next`", { target: "next" }, "#nxt"],
+  ["next <sel>", "ExtendedCSSSelector:`next ${string}`", { target: next("div") }, "#nxt", ["next()#0:string"]],
+  ["previous", "ExtendedCSSSelector:`previous`", { target: "previous" }, "#prev"],
+  ["previous <sel>", "ExtendedCSSSelector:`previous ${string}`", { target: previous("div") }, "#prev", ["previous()#0:string"]],
+];
+for (const [label, tok, opts, where, more = []] of targetCases) {
+  row(`target/${label}`, [tok, ...more], async (o) => {
+    const p = await o({ body: targetLayout({ ...opts, swap: "innerHTML" }), routes: { "/r": { body: "<b>LANDED</b>" } } });
+    await p.page.click("#go"); await p.settle();
+    expect(await p.page.evaluate((w) => document.querySelector(w)?.innerHTML.replace(/ class=""/g, ""), where)).toBe("<b>LANDED</b>");
+  });
+}
+row("target/find <sel>", ["ExtendedCSSSelector:`find ${string}`", "find()#0:string"], async (o) => {
+  const p = await o({ body: render(Div(Span("inner").cssClass("inner"), Span("other")).setId("go").setHtmx(hx(u("/r"), { target: find(".inner"), swap: "innerHTML" }))), routes: { "/r": { body: "<b>LANDED</b>" } } });
+  await p.page.click("#go .inner"); await p.settle();
+  expect(await p.page.evaluate(() => document.querySelector("#go .inner").innerHTML.replace(/ class=""/g, ""))).toBe("<b>LANDED</b>");
+});
+row("target/body", ["ExtendedCSSSelector:body"], async (o) => {
+  const p = await o({ body: go({ target: "body", swap: "beforeend" }), routes: { "/r": { body: "<b id='landed'>LANDED</b>" } } });
+  await p.page.click("#go"); await p.settle();
+  expect(await p.page.evaluate(() => document.body.lastElementChild?.id)).toBe("landed");
+});
+for (const kw of ["window", "document"]) {
+  row(`target/${kw}`, [`ExtendedCSSSelector:${kw}`], async (o) => {
+    const p = await o({ body: go({ target: kw, swap: "innerHTML" }), routes: { "/r": { body: "<b id='landed'>LANDED</b>" } } });
+    await p.page.click("#go"); await p.settle();
+    expect(p.hx().length, "the request leaves").toBe(1);
+    expect(await p.errors()).toEqual([]);
+  }, { known: { "*": F.sel } });
+}
+
+// ── swap styles ──────────────────────────────────────────────────────────────
+const shape = () => { const w = document.getElementById("w"); return [...w.querySelectorAll("*")].map((e) => e.id || e.tagName.toLowerCase()).join(","); };
+const swapCases = {
+  innerHTML: "t,n", outerHTML: "n", textContent: "t", beforebegin: "n,t,i", before: "n,t,i", afterbegin: "t,n,i", prepend: "t,n,i",
+  beforeend: "t,i,n", append: "t,i,n", afterend: "t,i,n@after", after: "t,i,n@after", innerMorph: "t,n", outerMorph: "n", delete: "", none: "t,i",
+};
+for (const [style, expected] of Object.entries(swapCases)) {
+  row(`swap/${style}`, [`HxSwapStyle:${style}`, "HTMX.swap"], async (o) => {
+    const p = await o({ body: `<div id="w"><div id="t"><i></i></div></div>` + go({ target: "#t", swap: style }), routes: { "/r": { body: `<b id="n">new</b>` } } });
+    await p.page.click("#go"); await p.settle();
+    const got = await p.page.evaluate(shape);
+    if (style === "textContent") {
+      expect(got).toBe("t");
+      expect(await p.text("#t")).toBe("new");
+    } else if (expected.endsWith("@after")) {
+      expect(await p.page.evaluate(() => document.getElementById("t").nextElementSibling?.id)).toBe("n");
+    } else expect(got).toBe(expected);
+    expect(p.hx().length).toBe(1);
+  });
+}
+
+// ── swap modifiers ───────────────────────────────────────────────────────────
+const tall = (inner) => `<div style="height:2500px">top</div>${inner}<div style="height:2500px">bottom</div>`;
+const fixedGo = (opts) => render(Button("go").setId("go").setType("button").addAttribute("style", "position:fixed;top:0;left:0").setHtmx(hx(u("/r"), opts)));
+for (const [mod, want] of [["scroll:top", "top"], ["scroll:bottom", "bottom"]]) {
+  row(`modifier/${mod}`, [`SwapScrollValue:${mod}`, "SwapWithModifier:`${HxSwapStyle} ${SwapModifier}`"], async (o) => {
+    const p = await o({ body: `<div id="t" style="height:100px;overflow:auto"><div style="height:1000px">old</div></div>` + go({ target: "#t", swap: `innerHTML ${mod}` }), routes: { "/r": { body: `<div style="height:1000px">new</div>` } } });
+    await p.page.evaluate(() => { document.getElementById("t").scrollTop = 400; });
+    await p.page.click("#go"); await p.settle();
+    const st = await p.page.evaluate(() => document.getElementById("t").scrollTop);
+    expect(want === "top" ? st : 900 - st).toBe(0);
+  });
+}
+for (const [mod, want] of [["scroll:window:top", 0], ["scroll:window:bottom", "max"], ["show:window:top", 0], ["show:window:bottom", "max"]]) {
+  row(`modifier/${mod}`, [`${mod.startsWith("scroll") ? "SwapScrollValue" : "SwapShowValue"}:${mod}`], async (o) => {
+    const p = await o({ body: tall(`<div id="t" style="height:300px">old</div>`) + fixedGo({ target: "#t", swap: `innerHTML ${mod}` }), routes: { "/r": { body: "new" } } });
+    await p.page.evaluate(() => window.scrollTo(0, 1200));
+    await p.page.click("#go"); await p.settle();
+    const [y, max] = await p.page.evaluate(() => [Math.round(window.scrollY), document.documentElement.scrollHeight - innerHeight]);
+    expect(y).toBe(want === "max" ? max : 0);
+  }, { known: { "*": F.mod } });
+}
+for (const [mod, edge] of [["show:top", "top"], ["show:bottom", "bottom"]]) {
+  row(`modifier/${mod}`, [`SwapShowValue:${mod}`], async (o) => {
+    const p = await o({ body: tall(`<div id="t" style="height:300px">old</div>`) + fixedGo({ target: "#t", swap: `innerHTML ${mod}` }), routes: { "/r": { body: "new" } } });
+    await p.page.click("#go"); await p.settle();
+    const r = await p.page.evaluate(() => { const b = document.getElementById("t").getBoundingClientRect(); return { top: Math.round(b.top), bottom: Math.round(b.bottom - innerHeight) }; });
+    expect(r[edge]).toBe(0);
+  });
+}
+row("modifier/show:none", ["SwapShowValue:show:none"], async (o) => {
+  // Differential: a pushUrl nav defaults to no scroll in htmx 4 too, so show:none is checked against show:top on the same page.
+  const p = await o({ body: tall(`<div id="t" style="height:300px">old</div>`) + fixedGo({ target: "#t", swap: "innerHTML show:none" }), routes: { "/r": { body: "new" } } });
+  await p.page.click("#go"); await p.settle();
+  expect(await p.page.evaluate(() => Math.round(window.scrollY))).toBe(0);
+  expect(await p.text("#t")).toBe("new");
+}, { level: "smoke" });
+for (const [mod, cfg, wantScroll] of [["focus-scroll:true", {}, true], ["focus-scroll:false", { defaultFocusScroll: true }, false]]) {
+  row(`modifier/${mod}`, [`SwapFocusScroll:${mod}`], async (o) => {
+    const p = await o({ head: `<meta name="htmx-config" content='${JSON.stringify(cfg)}'>`, body: `<div style="height:3000px"></div><div id="wrap">${render(Input().setId("fi").setHtmx(hx(u("/r"), { target: "#wrap", swap: `innerHTML ${mod}`, trigger: "go" })))}</div><div style="height:3000px"></div>`, routes: { "/r": { body: '<input id="fi">' } } });
+    await p.page.evaluate(() => { const i = document.getElementById("fi"); i.focus({ preventScroll: true }); window.scrollTo(0, 0); i.dispatchEvent(new Event("go")); });
+    await p.settle();
+    expect((await p.page.evaluate(() => window.scrollY)) > 0).toBe(wantScroll);
+  }, { known: { "*": F.mod } });
+}
+row("modifier/transition:true", ["SwapTransition:transition:true"], async (o) => {
+  const p = await o({ body: `<div id="t">old</div>` + go({ target: "#t", swap: "innerHTML transition:true" }), routes: { "/r": { body: "new" } }, scripts: `<script>window.__vt=0;const o=document.startViewTransition?.bind(document);if(o)document.startViewTransition=(c)=>{window.__vt++;return o(c)}</script>` });
+  await p.page.click("#go"); await p.settle(); await p.page.waitForTimeout(150);
+  expect(await p.page.evaluate(() => window.__vt)).toBe(1);
+  expect(await p.text("#t")).toBe("new");
+});
+row("modifier/ignoreTitle:true", ["SwapIgnoreTitle:ignoreTitle:true"], async (o) => {
+  const p = await o({ body: `<div id="t">old</div>` + go({ target: "#t", swap: "innerHTML ignoreTitle:true" }), routes: { "/r": { body: "<title>NEW TITLE</title><p>new</p>" } } });
+  await p.page.click("#go"); await p.settle();
+  expect(await p.page.title()).toBe("Oracle");
+  expect(await p.text("#t")).toBe("new");
+});
+// swap:<delay> exercises every DelayValue member; settle:<delay> the settle family.
+for (const [delay, ms] of [["100ms", 100], ["200ms", 200], ["300ms", 300], ["500ms", 500], ["1s", 1000], ["250ms", 250], ["0.4s", 400]]) {
