+import { rows } from "./rows.mjs";
+
+const test = base.extend({ bundle: ["htmx-4.0.0-beta6", { option: true }] });
+
+for (const r of rows) {
+  test(`${r.id}`, async ({ page, bundle }) => {
+    const known = r.known?.[bundle] ?? r.known?.["*"];
+    test.fail(Boolean(known), known);
+    await r.run((opts) => open(page, bundle, opts), page, bundle);
+  });
+}
diff --git a/test/grammar/harness.mjs b/test/grammar/harness.mjs
new file mode 100644
index 0000000..329004c
--- /dev/null
+++ b/test/grammar/harness.mjs
@@ -0,0 +1,48 @@
+// Page harness: one origin (http://oracle.test), the bundle under test served at /htmx.js, every
+// other path answered by the row's route table. Requests htmx makes are recorded.
+import { bundleFile } from "./bundles.mjs";
+import { readFileSync } from "node:fs";
+const FB = readFileSync(new URL("../../dist-link/fluent-behaviors.8.1.0.js", import.meta.url), "utf8");
+
+const SPY = `
+window.__finally = 0; window.__errors = []; window.__events = [];
+for (const n of ["htmx:finally:request", "htmx:error", "htmx:after:swap", "htmx:after:settle"])
+  document.addEventListener(n, (e) => { if (n === "htmx:finally:request") window.__finally++; if (n === "htmx:error") window.__errors.push(String(e.detail?.error?.message ?? e.detail?.error ?? n)); window.__events.push({ n, t: performance.now() }); }, true);
+document.addEventListener("htmx:after:process", (e) => { if (e.target === document.body) window.__ready = true; }, true);
+window.addEventListener("error", (e) => window.__errors.push("window.error: " + e.message));
+window.addEventListener("unhandledrejection", (e) => window.__errors.push("unhandledrejection: " + (e.reason?.message ?? e.reason)));
+`;
+
+export async function open(page, bundle, { head = "", body, routes = {}, ext = [], scripts = "", csp, clock = false }) {
+  const reqs = [];
+  let loads = 0;
+  await page.route("http://oracle.test/**", async (route) => {
+    const req = route.request();
+    const url = new URL(req.url());
+    if (url.pathname === "/htmx.js") return route.fulfill({ contentType: "text/javascript", body: bundleFile(bundle, "htmx") });
+    if (url.pathname === "/spy.js") return route.fulfill({ contentType: "text/javascript", body: SPY });
+    if (url.pathname === "/fb.js") return route.fulfill({ contentType: "text/javascript", body: FB });
+    if (url.pathname.startsWith("/ext/")) return route.fulfill({ contentType: "text/javascript", body: bundleFile(bundle, url.pathname.slice(1)) });
+    if (url.pathname === "/" && req.method() === "GET" && !req.headers()["hx-request"]) {
+      loads++;
+      const html = `<!doctype html><html><head><meta charset="utf-8"><title>Oracle</title>${head}<script src="/spy.js"></script><script src="/htmx.js"></script>${ext.map((e) => `<script src="/ext/${e}.js"></script>`).join("")}${scripts}</head><body>${body}</body></html>`;
+      return route.fulfill({ contentType: "text/html; charset=utf-8", headers: csp ? { "content-security-policy": csp } : {}, body: html });
+    }
+    reqs.push({ method: req.method(), path: url.pathname + url.search, headers: req.headers(), post: req.postData() });
+    const h = routes[url.pathname];
+    const r = !h ? { body: `<p>unrouted ${url.pathname}</p>` } : typeof h === "function" ? await h(req, reqs.length) : h;
+    if (r.delay) await new Promise((res) => setTimeout(res, r.delay));
+    return route.fulfill({ status: r.status ?? 200, headers: { "content-type": r.contentType ?? "text/html; charset=utf-8", ...(r.headers ?? {}) }, body: r.body ?? "" }).catch(() => {});
+  });
+  if (clock) await page.clock.install();
+  await page.goto("http://oracle.test/");
+  try { await page.waitForFunction(() => window.__ready === true, null, { timeout: 3000 }); } catch { await page.waitForTimeout(200); }
+  const settle = async (n = 1, timeout = 3000) => {
+    try { await page.waitForFunction((k) => window.__finally >= k, n, { timeout }); } catch { /* the row asserts the outcome */ }
+    await page.waitForTimeout(60);
+  };
+  const $ = (sel, fn = (e) => e?.outerHTML ?? null) => page.evaluate(([s, f]) => (0, eval)(f)(document.querySelector(s)), [sel, fn.toString()]);
+  const text = (sel) => page.evaluate((s) => document.querySelector(s)?.textContent ?? null, sel);
+  const errors = () => page.evaluate(() => window.__errors);
+  return { page, reqs, loads: () => loads, settle, $, text, errors, hx: () => reqs.filter((r) => r.headers["hx-request"]) };
+}
