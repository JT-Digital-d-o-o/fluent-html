diff --git a/test/grammar/bundles.mjs b/test/grammar/bundles.mjs
new file mode 100644
index 0000000..693bd06
--- /dev/null
+++ b/test/grammar/bundles.mjs
@@ -0,0 +1,19 @@
+// The oracle's bundle matrix. In the lib: `htmx.org` (the pin) and an npm-alias devDependency for
+// the version projects-template serves. Here: the template's installed copy (byte-identical to its
+// public/js/htmx.min.js, sha256 e484d917...).
+import { readFileSync } from "node:fs";
+const LIB = "fluent-html/node_modules/htmx.org/dist";
+const TPL = "projects-template/node_modules/.pnpm/htmx.org@4.0.0/node_modules/htmx.org/dist";
+const A7 = "<scratch>/wave1/A1/bundles";
+export const BUNDLES = {
+  "htmx-4.0.0-beta6": { role: "lib pin", dist: LIB, min: `${LIB}/htmx.min.js` },
+  "htmx-4.0.0": { role: "template-served", dist: TPL, min: `${TPL}/htmx.min.js` },
+  "htmx-4.0.0-alpha7": { role: "bump drill only (3 live repos load it from CDN)", dist: `${A7}/alpha7/dist`, min: `${A7}/a7.min.js` },
+};
+const cache = new Map();
+export function bundleFile(name, rel) {
+  const b = BUNDLES[name];
+  const p = rel === "htmx" ? b.min : `${b.dist}/${rel}`;
+  if (!cache.has(p)) { try { cache.set(p, readFileSync(p, "utf8")); } catch { cache.set(p, ""); } }
+  return cache.get(p);
+}
diff --git a/test/grammar/coverage.test.mjs b/test/grammar/coverage.test.mjs
new file mode 100644
index 0000000..5314f2a
--- /dev/null
+++ b/test/grammar/coverage.test.mjs
@@ -0,0 +1,21 @@
+// Completeness gate: every token of the typed htmx surface (read from the published d.ts) is
+// claimed by at least one executed oracle row, and no row claims a token that no longer exists.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { typedSurface } from "./surface.mjs";
+import { rows } from "./rows.mjs";
+
+const DIST = process.env.ORACLE_DIST ?? new URL("../../dist-link/src", import.meta.url).pathname;
+
+test("every typed htmx token has an executed oracle row", async () => {
+  const surface = await typedSurface(DIST);
+  const claimed = new Set(rows.flatMap((r) => r.covers));
+  const uncovered = surface.filter((t) => !claimed.has(t));
+  assert.deepEqual(uncovered, [], `typed htmx grammar with no executed row in test/grammar/rows.mjs:\n  ${uncovered.join("\n  ")}\nAdd a row that renders it and asserts its effect in the pinned bundle (mark it known: { ... } if it is broken).`);
+});
+
+test("no row claims a token the typed surface no longer has", async () => {
+  const surface = new Set(await typedSurface(DIST));
+  const stale = [...new Set(rows.flatMap((r) => r.covers))].filter((t) => !surface.has(t) && !/^record:/.test(t));
+  assert.deepEqual(stale, [], `rows claim tokens that left the typed surface: ${stale.join(", ")}`);
+});
