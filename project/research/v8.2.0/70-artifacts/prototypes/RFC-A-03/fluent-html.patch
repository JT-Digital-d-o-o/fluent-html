+// Enumerate the typed htmx grammar from the published declarations (dist/*.d.ts), syntactically:
+// every literal member of the listed unions, every template-literal member as written, every key
+// of the listed bag types, every public method of HxResponse. A token is "<Decl>:<member>".
+import ts from "typescript";
+import { readFileSync } from "node:fs";
+
+const UNIONS = {
+  "htmx.d.ts": ["HxHttpMethod", "HxEncoding", "DelayValue", "HxSwapStyle", "SwapScrollValue", "SwapShowValue",
+    "SwapTimingValue", "SwapFocusScroll", "SwapTransition", "SwapIgnoreTitle", "SwapWithModifier", "SwapWithTwoModifiers",
+    "ExtendedCSSSelector", "DOMEvent", "HtmxEvent", "TriggerModifier", "ModifiedTrigger", "DelayedTrigger",
+    "ThrottledTrigger", "ChangedDelayTrigger", "PollingTrigger", "HxTrigger", "HxSync", "HxStatusKey"],
+};
+const BAGS = { "htmx.d.ts": ["HTMX", "HxConfig", "HxStatusConfig"], "patterns.d.ts": ["HtmxGlobalConfig", "HxLocationConfig"] };
+const CLASSES = { "patterns.d.ts": { HxResponse: ["constructor", "build", "getHeaders"] } };
+const FUNCS = { "patterns.d.ts": ["Partial", "HtmxConfig", "hxResponse"], "htmx.d.ts": ["hx", "id", "clss", "closest", "find", "next", "previous"] };
+
+export async function typedSurface(distSrc) {
+  const tokens = [];
+  const src = (f) => ts.createSourceFile(f, readFileSync(`${distSrc}/${f}`, "utf8"), ts.ScriptTarget.Latest, true);
+  const decls = (sf) => new Map(sf.statements.filter((s) => s.name).map((s) => [s.name.text, s]));
+  const memberText = (n, sf) => {
+    if (ts.isLiteralTypeNode(n) && ts.isStringLiteral(n.literal)) return n.literal.text;
+    return n.getText(sf); // template literal / type reference / (string & {}) as written
+  };
+  for (const [file, names] of Object.entries(UNIONS)) {
+    const sf = src(file), d = decls(sf);
+    for (const name of names) {
+      const decl = d.get(name);
+      if (!decl) throw new Error(`surface: ${name} not declared in ${file}`);
+      const t = decl.type;
+      const members = ts.isUnionTypeNode(t) ? t.types : [t];
+      for (const m of members) {
+        const text = memberText(m, sf);
+        if (text === "(string & {})") continue; // deliberately open tail, not grammar
+        if (ts.isTypeReferenceNode(m)) continue; // composed from another enumerated union
+        tokens.push(`${name}:${text}`);
+      }
+    }
+  }
+  for (const [file, names] of Object.entries(BAGS)) {
+    const sf = src(file), d = decls(sf);
+    for (const name of names) {
+      const decl = d.get(name);
+      const lit = ts.isTypeAliasDeclaration(decl) ? decl.type : decl;
+      for (const m of lit.members) if (m.name) tokens.push(`${name}.${m.name.getText(sf)}`);
+    }
+  }
+  for (const [file, classes] of Object.entries(CLASSES)) {
+    const sf = src(file), d = decls(sf);
+    for (const [name, skip] of Object.entries(classes)) {
+      for (const m of d.get(name).members) {
+        if (!m.name || !ts.isMethodDeclaration(m)) continue;
+        if (m.modifiers?.some((x) => x.kind === ts.SyntaxKind.PrivateKeyword)) continue;
+        const n = m.name.getText(sf);
+        if (!skip.includes(n) && !tokens.includes(`${name}#${n}`)) tokens.push(`${name}#${n}`);
+      }
+    }
+  }
+  for (const [file, names] of Object.entries(FUNCS)) {
+    const sf = src(file);
+    for (const name of names) {
+      const overloads = sf.statements.filter((s) => ts.isFunctionDeclaration(s) && s.name?.text === name);
+      if (!overloads.length) throw new Error(`surface: function ${name} not declared in ${file}`);
+      overloads.forEach((o, i) => tokens.push(`${name}()#${i}:${o.parameters.map((p) => p.type?.getText(sf) ?? "?").join(",")}`));
+    }
+  }
+  tokens.push("Tag#setHtmx", "Tag#hxGet", "Tag#hxPost", "Tag#htmxIndicator");
+  const { HTMX_EVENTS } = await import(`${distSrc}/behaviors/events.js`);
+  for (const ev of Object.values(HTMX_EVENTS)) tokens.push(`behaviors:${ev}`);
+  return tokens;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const t = await typedSurface(process.argv[2] ?? "fluent-html/dist/src");
+  console.log(t.length + " tokens");
+  console.log(t.join("\n"));
+}
