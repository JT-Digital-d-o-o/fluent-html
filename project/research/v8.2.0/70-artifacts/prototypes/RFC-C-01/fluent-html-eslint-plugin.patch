+++ b/scripts/gen-fix-contract.mjs
@@ -0,0 +1,232 @@
+// Fix contract (RFC-C-01): every fix no-tailwind-in-raw-class proposes must
+// type-check against the sibling fluent-html and render the class it replaces.
+// Sweeps the pinned Tailwind class space (getClassList + static roots + bare
+// functional roots + one probe per variant head) through the vocab derivation,
+// tsc-checks every proposed call in one program, renders it, and writes
+// src/fix-contract.generated.ts. Run after `tsc` (reads dist/tailwind-token.js);
+// `--check` exits 1 when the committed file differs from a fresh sweep.
+import { createRequire } from "node:module";
+import { fileURLToPath } from "node:url";
+import { dirname, join } from "node:path";
+import { mkdtempSync, writeFileSync, readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+
+const require = createRequire(import.meta.url);
+const here = dirname(fileURLToPath(import.meta.url));
+const libDir = join(here, "..", "..", "fluent-html");
+const out = join(here, "..", "src", "fix-contract.generated.ts");
+const check = process.argv.includes("--check");
+
+const { loadDesignSystem } = await import(`${libDir}/dist/scripts/gen-vocab/load-design-system.js`);
+const lib = await import(`${libDir}/dist/src/index.js`);
+const { classifyDerived, chainFor, callText } = require("../dist/tailwind-token.js");
+const ts = require("typescript");
+const { design, tailwindVersion } = await loadDesignSystem();
+
+const valid = (c) => design.candidatesToCss([c])[0] !== null;
+const listed = design.getClassList().map(([c]) => c);
+const listedSet = new Set(listed);
+const extra = [
+  ...design.utilities.keys("static"),
+  ...[...design.utilities.keys("functional")].filter((r) => !r.startsWith("-")),
+].filter((c) => !listedSet.has(c) && valid(c));
+const sweepClasses = [...listed, ...new Set(extra)];
+const heads = [];
+for (const v of design.getVariants()) {
+  if (v.values.length === 0) { if (!v.isArbitrary) heads.push(v.name); continue; }
+  for (const val of v.values) heads.push(v.hasDash ? `${v.name}-${val}` : `${v.name}${val}`);
+}
+const headList = [...new Set(heads)].filter((h) => valid(`${h}:p-4`));
+
+// ── probes ──────────────────────────────────────────────────────
+const lines = [];
+const probe = (code) => { lines.push(code); return lines.length; };
+const noGate = { deadPrefixes: new Set(), numericPrefixes: new Set(), bracketPrefixes: null };
+const mapped = (method, args, pattern) => ({ kind: "mapped", method, args, fix: callText(method, args), pattern });
+const plan = new Map();
+const addCandidate = (cands, cls) => {
+  const hover = chainFor(["hover"], cls);
+  cands.push({ cls, plainLine: probe(`Div()${cls.fix}`), hoverLine: hover === null ? null : probe(`Div()${hover}`) });
+};
+for (const c of sweepClasses) {
+  if (c.startsWith("-")) continue; // negatives: phase 2
+  const d = classifyDerived(c, noGate);
+  const cands = [];
+  if (d.kind === "mapped") {
+    addCandidate(cands, d);
+    const [v] = d.args;
+    if (d.args.length === 1 && typeof v === "string" && /^\d+$/.test(v)) addCandidate(cands, mapped(d.method, [Number(v)], d.pattern));
+  }
+  plan.set(c, { derived: d, cands });
+}
+// cssProp successors: one declaration with a keyword value (no var()/calc()/--tw-*)
+const successor = new Map();
+const propsOf = new Map();
+for (const c of sweepClasses) {
+  const css = design.candidatesToCss([c])[0];
+  if (css === null) continue;
+  const rule = css.split(/\n@/)[0];
+  const own = [...rule.matchAll(/^ {2}([a-z-]+): .+;$/gm)].map((m) => m[1]).filter((p) => !p.startsWith("--"));
+  const props = [...new Set(own.filter((p) => !(p.startsWith("-") && own.includes(p.replace(/^-[a-z]+-/, "")))))];
+  if (props.length > 0) propsOf.set(c, props.join(", "));
+  const m = /^\.[^\n{]+ \{\n {2}([a-z][a-z-]*): ([^\n]+);\n\}\n$/.exec(css);
+  // Dash-less classes (`visible`, `collapse`) stay out: TAILWIND_SHAPE never flags bare words.
+  if (c.includes("-") && !c.startsWith("-") && m && !/var\(|calc\(|--tw-/.test(m[2])) {
+    successor.set(c, { property: m[1], value: m[2], line: probe(`Div().cssProp(${JSON.stringify(m[1])}, ${JSON.stringify(m[2])})`) });
+  }
+}
+// bracket arms: does each catch-all's method type an arbitrary `[…]` value?
+const { getFixableTables } = require("../dist/derive-fixable.js");
+const bracketPlan = getFixableTables().patterns.filter((p) => !p.exactMatch).flatMap((p) => [
+  { pattern: p.pattern, line: probe(`Div()${callText(p.methodName, p.direction ? [p.direction, "[1px]"] : ["[1px]"])}`) },
+  { pattern: `${p.pattern}/[`, line: probe(`Div()${callText(p.methodName, p.direction ? [p.direction, "white/[0.5]"] : ["white/[0.5]"])}`) },
+]);
+// arbitrary-value heads: one probe per variant family (`max-[600px]`); an untyped family is stored as `max-[`
+const arbitraryHeads = [];
+for (const v of design.getVariants()) {
+  for (const sample of ["[600px]", "[.x]"]) {
+    const h = v.hasDash ? `${v.name}-${sample}` : `${v.name}${sample}`;
+    if (valid(`${h}:p-4`)) { arbitraryHeads.push({ head: h, family: h.slice(0, h.indexOf("[") + 1) }); break; }
+  }
+}
+const headPlan = [...headList.map((h) => ({ head: h, family: h })), ...arbitraryHeads].map(({ head, family }) => {
+  const chain = chainFor([head], classifyDerived("p-4", noGate));
+  return { head: family, line: chain === null ? null : probe(`Div()${chain}`) };
+});
+
+// ── tsc + render ────────────────────────────────────────────────
+function typecheck(codeLines) {
+  const dir = mkdtempSync(join(tmpdir(), "fix-contract-"));
+  const file = join(dir, "probes.mts");
+  writeFileSync(file, `import { Div } from "fluent-html";\n` + codeLines.map((l, i) => `export const p${i + 1} = ${l};`).join("\n") + "\n");
+  const program = ts.createProgram([file], {
+    target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.NodeNext, moduleResolution: ts.ModuleResolutionKind.NodeNext,
+    strict: true, noEmit: true, skipLibCheck: true, types: [],
+    paths: { "fluent-html": [join(libDir, "dist/src/index.d.ts")] },
+  });
+  const sf = program.getSourceFile(file);
+  const failed = new Set(ts.getPreEmitDiagnostics(program).filter((d) => d.file === sf).map((d) => sf.getLineAndCharacterOfPosition(d.start).line));
+  return (line) => line !== null && !failed.has(line);
+}
+const compiles = typecheck(lines);
+// Effective declarations of the utility rule: `@supports` progressive enhancements fold in
+// as overrides, so a legacy spelling and its v4 successor (bg-gradient-to-t → bg-linear-to-t) compare equal.
+const cssOf = (cls) => {
+  const r = design.candidatesToCss([cls])[0];
+  if (r === null) return null;
+  const decls = new Map();
+  for (const m of r.split(/\n@property/)[0].matchAll(/^\s+([a-z-]+|--[a-z0-9-]+): ([^;\n]+);$/gm)) decls.set(m[1], m[2]);
+  return JSON.stringify([...decls].sort());
+};
+const rendered = (fix) => { const m = /class="([^"]*)"/.exec(lib.render(new Function("Div", `return Div()${fix};`)(lib.Div))); return m ? m[1] : ""; };
+const sameAs = (cls, r) => r === cls || (cssOf(r) !== null && cssOf(r) === cssOf(cls));
+const passes = (c, k) => compiles(k.plainLine) && (k.hoverLine === null || compiles(k.hoverLine)) && sameAs(c, rendered(k.cls.fix));
+
+// ── phase 1 decisions ───────────────────────────────────────────
+const CSS_SUCCESSOR = {}, ROOT_PROPS = {};
+const withheld = [];
+const tally = new Map();
+const fixOf = new Map(); // positive class → its final mapped classification
+const bump = (p, k) => { const t = tally.get(p) ?? { ok: 0, fail: 0, numeric: 0 }; t[k]++; tally.set(p, t); };
+const rootKey = (c) => { const k = design.parseCandidate(c)[0]; return !k ? c : k.kind === "static" ? c.replace(/^-/, "") : k.root.replace(/^-/, ""); };
+const noFix = (c, derived) => {
+  const s = successor.get(c);
+  if (s && compiles(s.line) && sameAs(c, rendered(callText("cssProp", [s.property, s.value])))) { CSS_SUCCESSOR[c] = [s.property, s.value]; return; }
+  const props = propsOf.get(c);
+  const key = rootKey(c);
+  if (props) ROOT_PROPS[key] = [...new Set([...(ROOT_PROPS[key]?.split(", ") ?? []), ...props.split(", ")])].join(", ");
+  if (derived.kind === "mapped") withheld.push([c, derived.pattern && !derived.pattern.exactMatch ? derived.pattern.pattern : null, props ?? ""]);
+};
+for (const [c, { derived, cands }] of plan) {
+  const via = derived.kind === "mapped" && derived.pattern && !derived.pattern.exactMatch ? derived.pattern.pattern : null;
+  const ok = cands.findIndex((k) => passes(c, k));
+  if (ok === 0) { if (via) bump(via, "ok"); fixOf.set(c, cands[0].cls); continue; }
+  if (ok === 1) { bump(via, "ok"); bump(via, "numeric"); fixOf.set(c, cands[1].cls); continue; }
+  if (via) bump(via, "fail");
+  noFix(c, derived);
+}
+const NUMERIC_PREFIXES = [...tally].filter(([, t]) => t.numeric > 0).map(([p]) => p).sort();
+const DEAD_PREFIXES = [...tally].filter(([, t]) => t.ok === 0 && t.fail > 0).map(([p]) => p).sort();
+
+// ── phase 2: negatives (typed negative where proven, else .neg()) ─
+const negPlan = [];
+const negLines = [];
+const withheldDerived = new Map(withheld.map(([c]) => [c, plan.get(c)?.derived]));
+for (const c of sweepClasses.filter((x) => x.startsWith("-"))) {
+  const fixedPos = fixOf.get(c.slice(1));
+  const pos = fixedPos ?? withheldDerived.get(c.slice(1)) ?? null; // withheld positive: typed negative only
+  if (!pos) { negPlan.push({ c, pos: null }); continue; }
+  const last = pos.args[pos.args.length - 1];
+  const typedPrefix = pos.pattern && !pos.pattern.exactMatch && last !== undefined ? pos.pattern.pattern : null;
+  const typed = typedPrefix ? mapped(pos.method, [...pos.args.slice(0, -1), typeof last === "number" ? -last : `-${last}`], pos.pattern) : null;
+  negLines.push(typed ? `Div()${typed.fix}` : "Div()");
+  const t = negLines.length;
+  negLines.push(`Div()${callText("neg", [c.slice(1)])}`);
+  negPlan.push({ c, pos, typed, typedPrefix, typedLine: typed ? t : null, negLine: fixedPos ? t + 1 : null });
+}
+const negCompiles = typecheck(negLines);
+const negTally = new Map();
+let negTyped = 0, negHatch = 0;
+for (const n of negPlan) {
+  if (n.pos === null) { noFix(n.c, classifyDerived(n.c, noGate)); continue; }
+  const typedOk = Boolean(n.typed) && negCompiles(n.typedLine) && sameAs(n.c, rendered(n.typed.fix));
+  if (n.typedPrefix) { const t = negTally.get(n.typedPrefix) ?? { ok: 0, fail: 0 }; typedOk ? t.ok++ : t.fail++; negTally.set(n.typedPrefix, t); }
+  n.typedOk = typedOk;
+}
+const TYPED_NEGATIVE_PREFIXES = [...negTally].filter(([, t]) => t.ok > 0 && t.fail === 0).map(([p]) => p).sort();
+const typedNeg = new Set(TYPED_NEGATIVE_PREFIXES);
+for (const n of negPlan) {
+  if (n.pos === null) continue;
+  if (n.typedOk && typedNeg.has(n.typedPrefix)) negTyped++;
+  else if (n.negLine !== null && negCompiles(n.negLine) && sameAs(n.c, rendered(callText("neg", [n.c.slice(1)])))) negHatch++;
+  else noFix(n.c, { kind: "none" });
+}
+
+const dead = new Set(DEAD_PREFIXES);
+const WITHHELD = Object.fromEntries(withheld.filter(([, p]) => p === null || !dead.has(p)).map(([c, , props]) => [c, props]));
+const BRACKET_PREFIXES = bracketPlan.filter((b) => compiles(b.line)).map((b) => b.pattern).sort();
+const UNTYPED_HEADS = headPlan.filter((h) => h.line !== null && !compiles(h.line)).map((h) => h.head);
+const stats = {
+  classes: sweepClasses.length, heads: headList.length, positivesFixed: fixOf.size, negTyped, negHatch,
+  numericPrefixes: NUMERIC_PREFIXES.length, bracketPrefixes: BRACKET_PREFIXES.length, typedNegativePrefixes: TYPED_NEGATIVE_PREFIXES.length,
+  cssSuccessor: Object.keys(CSS_SUCCESSOR).length, withheld: Object.keys(WITHHELD).length,
+  deadPrefixes: DEAD_PREFIXES.length, rootProps: Object.keys(ROOT_PROPS).length, untypedHeads: UNTYPED_HEADS.length,
+};
+
+const content = `// AUTO-GENERATED by scripts/gen-fix-contract.mjs from fluent-html/class-vocab + tailwindcss ${tailwindVersion}.
+// Do NOT edit by hand — run \`npm run gen:vocab\`. Pinned by \`gen:vocab --check\` and test/fix-contract.mjs.
+/* eslint-disable */
+export type FluentArg = string | number;
+
+/** Catch-alls whose digit-only values the method types as numbers (\`bg-linear-30\` → .bgLinear(30)). */
+export const NUMERIC_PREFIXES: ReadonlySet<string> = new Set(${JSON.stringify(NUMERIC_PREFIXES)});
+
+/** Catch-alls whose method types an arbitrary \`[…]\` value (\`w-[180px]\` → .w("[180px]")), and \`<prefix>/[\` for an arbitrary opacity modifier; other bracket values get no fix. */
+export const BRACKET_PREFIXES: ReadonlySet<string> = new Set(${JSON.stringify(BRACKET_PREFIXES)});
+
+/** Catch-alls whose negatives take the typed negative value (\`-translate-y-1\` → .translate("y", "-1")); others use .neg(). */
+export const TYPED_NEGATIVE_PREFIXES: ReadonlySet<string> = new Set(${JSON.stringify(TYPED_NEGATIVE_PREFIXES)});
+
+/** No fluent method, one keyword-valued declaration → autofix to \`.cssProp(property, value)\`. */
+export const CSS_SUCCESSOR: Readonly<Record<string, readonly [string, string]>> = ${JSON.stringify(CSS_SUCCESSOR)};
+
+/** The derived call fails tsc (value outside the method's union) → report-only; value = the CSS properties it sets. */
+export const WITHHELD: Readonly<Record<string, string>> = ${JSON.stringify(WITHHELD)};
+
+/** Prefix catch-alls no swept class compiles through → never used. */
+export const DEAD_PREFIXES: ReadonlySet<string> = new Set(${JSON.stringify(DEAD_PREFIXES)});
+
+/** Utility root → the CSS properties it sets, for the .cssProp() redirect. */
+export const ROOT_PROPS: Readonly<Record<string, string>> = ${JSON.stringify(ROOT_PROPS)};
+
+/** Variant heads \`.variant()\` does not type → report-only (an entry ending in \`[\` matches its arbitrary family). */
+export const UNTYPED_HEADS: ReadonlySet<string> = new Set(${JSON.stringify(UNTYPED_HEADS)});
+`;
+console.log(`[gen-fix-contract] ${JSON.stringify(stats)} → ${(content.length / 1024).toFixed(0)} KiB`);
+console.log(`[gen-fix-contract] numeric: ${NUMERIC_PREFIXES.join(" ")} | dead: ${DEAD_PREFIXES.join(" ")} | typed negatives: ${TYPED_NEGATIVE_PREFIXES.join(" ")}`);
+if (check) {
+  if (readFileSync(out, "utf8") !== content) { console.error("[gen-fix-contract] src/fix-contract.generated.ts is stale — run `npm run gen:vocab`"); process.exit(1); }
+  console.log("[gen-fix-contract] ✓ committed fix contract matches the sweep");
+} else {
+  writeFileSync(out, content);
+}
