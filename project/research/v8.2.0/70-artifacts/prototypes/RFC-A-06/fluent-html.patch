+describe("JSON-typed script bodies carry no '<' (C-19)", () => {
+  const data = { "@type": "Product", name: "Deluxe <!--<script> set", note: "a</script>b", cmp: "1 < 2" };
+  const body = (html: string) => html.slice(html.indexOf(">") + 1, html.lastIndexOf("</script>"));
+
+  it("rewrites every '<' to \\u003c in an ld+json body, so <!--<script> cannot open a double-escaped run", () => {
+    assert.strictEqual(
+      render(Script(JSON.stringify({ name: "<!--<script>" })).setType("application/ld+json")),
+      '<script type="application/ld+json">{"name":"\\u003c!--\\u003cscript>"}</script>',
+    );
+  });
+
+  it("parses to the identical value for every JSON script type", () => {
+    for (const type of ["application/json", "application/ld+json", "importmap", "speculationrules", "text/json", "application/geo+json", "Application/JSON; charset=utf-8", " importmap "]) {
+      const out = body(render(Script(JSON.stringify(data)).setType(type)));
+      assert.ok(!out.includes("<"), type);
+      assert.deepStrictEqual(JSON.parse(out), data, type);
+    }
+  });
+
+  it("is idempotent with the hand-rolled .replace(/</g, '\\\\u003c') helper", () => {
+    const hand = render(Script(JSON.stringify(data).replace(/</g, "\\u003c")).setType("application/ld+json"));
+    assert.strictEqual(render(Script(JSON.stringify(data)).setType("application/ld+json")), hand);
+  });
+
+  it("reads a bag-set type when setType was not used", () => {
+    assert.strictEqual(render(El("script", '{"a":"<"}').addAttribute("type", "application/json")), '<script type="application/json">{"a":"\\u003c"}</script>');
+    assert.strictEqual(render(El("script", Raw('{"a":"<"}')).addAttribute("type", "application/json")), '<script type="application/json">{"a":"\\u003c"}</script>');
+  });
+
+  it("leaves JS and non-JSON data blocks on the closer-only rule", () => {
+    for (const type of [undefined, "module", "text/javascript", "text/x-template", "application/jsonp", "application/javascript"]) {
+      const s = Script("if (a<b) x = '<!--<script>'; y = '</script>';");
+      const out = render(type === undefined ? s : s.setType(type));
+      assert.ok(out.includes("if (a<b) x = '<!--<script>'; y = '<\\/script>';"), String(type));
+    }
+  });
+
+  it("streams the same bytes as render", () => {
+    const v = Div(Script(JSON.stringify(data)).setType("application/ld+json"), Script("a<b"));
+    assert.strictEqual([...renderToIterable(v)].join(""), render(v));
+  });
+});
