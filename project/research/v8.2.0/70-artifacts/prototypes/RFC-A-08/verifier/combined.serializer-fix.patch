+function quotedStatusConfig(cfg: HxStatusConfig): string {
+  const pairs: [string, string | boolean][] = [];
+  if (cfg.swap) pairs.push(['swap', String(cfg.swap)]);
+  if (cfg.target) pairs.push(['target', String(cfg.target)]);
