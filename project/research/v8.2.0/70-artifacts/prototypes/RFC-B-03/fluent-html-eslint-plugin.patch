+// Setters whose argument is the ResolvedRoute brand, keyed by attribute, with the factories
+// that return the branded tag. A raw value there is a compile error, so it is never autofixed.
+const BRANDED_URL_SETTERS: Record<string, readonly string[]> = { href: ["A"] };
+const EXTERNAL_HREF = /^(https?:\/\/|mailto:|tel:|#)/;
+
+function brandSafe(value: any): boolean {
+  if (value.type === "Literal") return typeof value.value === "string" && EXTERNAL_HREF.test(value.value);
+  if (value.type === "TemplateLiteral") return EXTERNAL_HREF.test(value.quasis[0]?.value.cooked ?? "");
+  if (value.type !== "CallExpression") return false;
+  const c = value.callee;
+  if (c.type === "Identifier") return c.name === "assetUrl" || c.name === "externalUrl";
+  return c.type === "MemberExpression" && !c.computed && c.property.type === "Identifier" && c.property.name === "resolve";
+}
+
+function rootFactory(node: any): string | null {
+  let cur = node.callee.object;
+  while (cur?.type === "CallExpression" && cur.callee.type === "MemberExpression") cur = cur.callee.object;
+  return cur?.type === "CallExpression" && cur.callee.type === "Identifier" ? cur.callee.name : null;
+}
