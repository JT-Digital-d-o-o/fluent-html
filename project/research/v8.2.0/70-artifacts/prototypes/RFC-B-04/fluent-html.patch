+  if (sf.isDeclarationFile || sf.fileName.includes("/node_modules/")) continue;
+  report.scannedFiles++;
+  const edits = [];
+  const loc = (n) => path.relative(process.cwd(), sf.fileName) + ":" + (sf.getLineAndCharacterOfPosition(n.getStart(sf)).line + 1);
+  const visit = (node) => {
+    if (ts.isCallExpression(node) && ts.isIdentifier(node.expression) && node.arguments.length >= 2) {
+      let sym = checker.getSymbolAtLocation(node.expression);
+      if (sym && sym.flags & ts.SymbolFlags.Alias) sym = checker.getAliasedSymbol(sym);
