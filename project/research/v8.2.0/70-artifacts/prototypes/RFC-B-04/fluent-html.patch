+const checker = program.getTypeChecker();
+const isFluentDecl = (sym) => {
+  if (!sym) return false;
+  if (sym.flags & ts.SymbolFlags.Alias) sym = checker.getAliasedSymbol(sym);
+  return (sym.declarations ?? []).some((d) => /fluent-html|dist-(base|after)|\/lib\/src\/patterns\.ts$/.test(d.getSourceFile().fileName));
+};
+const HTMX_DECL = /(fluent-html|dist-(base|after)|\/lib)\/(dist\/)?src\/(htmx|routes|patterns)\.(d\.)?ts$/;
