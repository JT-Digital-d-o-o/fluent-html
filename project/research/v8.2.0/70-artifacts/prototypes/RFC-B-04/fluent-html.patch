+      const v = node.arguments[0].text;
+      if (BARE.test(v) && !KEYWORDS.has(v) && !TAGS.has(v)) report.reported.push({ at: loc(node), why: `${node.expression.name.text}("${v}") is a tag selector for <${v}>` });
+    }
+    ts.forEachChild(node, visit);
+  };
+  visit(sf);
+  if (edits.length && WRITE) {
+    let text = sf.getFullText();
+    for (const e of edits.sort((a, b) => b.start - a.start)) text = text.slice(0, e.start) + e.text + text.slice(e.end);
+    writeFileSync(sf.fileName, text);
+  }
+}
+// Selector values the checker types as a wide string: no mechanical rewrite exists, so report them.
