+  const text = ts.flattenDiagnosticMessageText(d.messageText, " ");
+  if (!d.file || d.file.fileName.includes("/node_modules/") || !text.includes("a bare word is an HTML tag or htmx keyword")) continue;
+  const line = d.file.getLineAndCharacterOfPosition(d.start).line + 1;
+  report.reported.push({ at: path.relative(process.cwd(), d.file.fileName) + ":" + line, why: "TS" + d.code + " selector typed string; type it HxTarget or pass an Id" });
+}
+console.log(JSON.stringify(report, null, 1));
