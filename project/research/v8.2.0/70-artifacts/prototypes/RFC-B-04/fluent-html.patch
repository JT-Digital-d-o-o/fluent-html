+  if (!ctx) return false;
+  const key = node.name.getText();
+  const types = ctx.isUnion() ? ctx.types : [ctx];
+  return types.some((t) => { const p = t.getProperty(key); return (p?.declarations ?? []).some((d) => HTMX_DECL.test(d.getSourceFile().fileName)); });
+};
+const report = { rewritten: [], reported: [], scannedFiles: 0, partialCalls: 0, sinkLiterals: 0 };
