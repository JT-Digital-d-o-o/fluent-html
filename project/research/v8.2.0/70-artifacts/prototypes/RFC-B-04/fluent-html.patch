+// Deliberately-mixed probe fixture for test/selector-errors.test.ts (RFC-B-04): one meaning for a
+// bare word in every selector sink. Excluded from the root tsconfig.
+import { A, Button, Div, Form, Partial, hx, hxResponse, assetUrl, defineIds, defineRoutes, closest, type HxTarget } from "../../../src/index.js";
+
+const ids = defineIds(["team-list", "invite-form", "main-content"] as const);
+const routes = defineRoutes("/team", { list: { path: "/list" }, invite: { method: "post", path: "/invite" } } as const);
+const u = assetUrl("/x");
+declare const wide: string;
+
+// ── Must FAIL: a bare word that is neither an HTML tag nor an htmx keyword ──
+Button("a").setHtmx(hx(u, { target: "team-list" }));
+Partial("team-list", Div("x"));
+Button("b").setHtmx(routes.list({ target: "team-list" }));
+hxResponse(Div("x")).retarget("main-content");
+Button("c").setHtmx(routes.list({ include: "filters" }));
+Button("d").setHtmx(hx(u, { target: wide }));
+
+// ── Must PASS ──
+Button("e").setHtmx(hx(u, { target: ids.teamList }));
+Button("f").setHtmx(hx(u, { target: "#team-list", include: "closest form", disable: "find button" }));
+Button("g").setHtmx(hx(u, { target: "main" }));
+Button("h").setHtmx(hx(u, { target: "this", indicator: `${ids.mainContent.selector}, #row-1` }));
+Button("i").setHtmx(routes.list({ target: ids.teamList.selector }));
+Form().setHtmx(routes.invite({ status: { 422: { target: ids.inviteForm.selector } } }));
+Partial(ids.teamList, Div("x"));
+Partial("main", Div("x"));
+Partial(closest("tr"), Div("x"));
+hxResponse(Div("x")).retarget(ids.mainContent.selector);
+const typed: HxTarget = "#a, #b";
+A("j").setHtmx(hx(u, { target: typed }));
