+          }
+        } else {
+          const t = checker.getTypeAtLocation(a0);
+          const isStr = (t.flags & ts.TypeFlags.String) || (t.isUnion() && t.types.some((u) => u.flags & ts.TypeFlags.String));
+          if (isStr) report.reported.push({ at: loc(a0), why: "Partial target typed string: 8.x prefixed # when the value was a bare word" });
+        }
+      }
+    }
+    if (ts.isPropertyAssignment(node) && SINK_KEYS.has(node.name.getText(sf)) && (ts.isStringLiteral(node.initializer) || ts.isNoSubstitutionTemplateLiteral(node.initializer)) && isHtmxBagProp(node)) {
